{
  "name": "@agents-anywhere/dsh-acp-bridge",
  "version": "1.0.0",
  "description": "Agent Client Protocol (ACP) access to a running DeepSeek Harness: editors and scripts drive DSH sessions through a local RPC endpoint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "directory": "dsh-acp-bridge"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": "./lib/stdio.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./stdio": "./lib/stdio.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "TECHNICAL.md",
    "TECHNICAL.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "yarn clean && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "check": "yarn typecheck && yarn build && yarn test",
    "smoke": "tsx scripts/smoke.ts",
    "prepack": "yarn check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.19.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "meshcall": "0.3.0",
    "zod": "^4.1.0"
  },
