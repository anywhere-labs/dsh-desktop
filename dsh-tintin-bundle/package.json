{
  "name": "dsh-tintin-bundle",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "TinTin host bridge plugin: local capability routes and the TinTin web chrome",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./lib/*": "./lib/*"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "external": [
        "dsh-tintin-client-ui/client"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  },
  "scripts": {
    "test": "vitest run",
    "check": "yarn run test",
    "fetch:openfilm": "node scripts/fetch-openfilm-runtime.mjs"
  }
}
