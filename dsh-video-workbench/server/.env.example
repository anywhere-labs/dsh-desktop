# LibTV CLI boundary. workspaceId is the container; projectUuid is the canvas.
LIBTV_BIN=/Users/macbook/.libtv/libtv
LIBTV_CWD="/Volumes/SSK SSD/deepseek harness 桌面端/dsh-video-workbench"
LIBTV_TIMEOUT_SECONDS=7200
LIBTV_WORKSPACE_ID=
LIBTV_PROJECT_UUID=
LIBTV_NODE_KEY=
LIBTV_MODEL_KEY=

VIDEO_WORKBENCH_STATE_DIR=/data/video-workbench
VIDEO_WORKBENCH_ARTIFACT_DIR=/data/video-workbench/artifacts
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173
