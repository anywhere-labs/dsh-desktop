+/** httpx requires bare IPv6 in NO_PROXY; keep undici's bracketed bypass in the parent. */
+function connectorEnvironment(environment) {
+	const result = { ...environment };
+	for (const key of ["no_proxy", "NO_PROXY"]) {
+		if (typeof result[key] === "string") result[key] = result[key].split(",").map((entry) => entry.trim() === "[::1]" ? "::1" : entry).join(",");
+	}
+	return result;
+}
