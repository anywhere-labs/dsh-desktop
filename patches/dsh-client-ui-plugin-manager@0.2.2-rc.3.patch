     packages: sortPackages(bundles.value.map(bundle => packageView(bundle, plugins.value))),\n        })\n        this.dropStaleVersions()\n      } while (this.shouldRerun())\n    } finally {\n      this.inFlight = undefined\n    }\n  }\n\n  private shouldRerun(): boolean {\n    return this.rerun\n  }\n\n  private async confirm(): Promise<void> {\n    const pending = this.pendingConfirm\n    this.pendingConfirm = undefined\n    this.patch({ confirm: null })\n    if (pending !== undefined) await pending()\n  }\n\n  /** Drop the check in flight; its answer is ignored. */\n  private abortInspect(): void {\n    this.inspectAbort?.abort()\n    this.inspectAbort = undefined\n  }\n\n  /** Whether a settlement arrives too late to matter: the store is disposed, or the dialog moved on. */\n  private gone(signal: AbortSignal): boolean {\n    return this.disposed || signal.aborted\n  }\n\n  /** Reuse the install dialog with an exact catalog target and an explicit selection outcome. */\n  private openCatalogInstall(pkg: PackageView, target: NonNullable<BundleInfo['installTarget']>, enabled: boolean): void {\n    if (this.disposed) return\n    const { phase } = this.getSnapshot().install\n    if (phase === 'checking' || isInstallPending(phase)) {\n      this.patchInstall({ open: true })\n      return\n    }\n    this.abortInspect()\n    const registry = this.registryMemory.getSnapshot() ?? OFFICIAL_REGISTRY\n    const local = target.spec.startsWith('link:')\n    const subject: InstallSubject = {\n      status: 'accepted', kind: local ? 'path' : 'registry', name: pkg.name, version: target.version, bundle: true,\n      spec: target.spec, registry: registry.kind === 'custom' ? registry.url : registry.registry,\n      selection: enabled, ...local ? {} : { saveExact: true },\n    }\n    this.patch({ install: { ...IDLE_INSTALL, open: true, spec: subject.spec, registry, subject } })\n    const read: RegistryRead = { choice: registry }\n    this.registryRead = read\n    read.done = this.readRegistries(read).finally(() => { delete read.done })\n    void this.runInstall()\n  }\n\n  /**\n   * Offer a default-hidden shipped bundle for explicit enablement, or check\n   * and install the typed spec. A refused spec returns to the field with its\n   * reason; an accepted one becomes the subject shown while pnpm runs.\n   */\n  private async runInstall(): Promise<void> {\n    const state = this.getSnapshot()\n    const install = state.install\n    const spec = install.spec.trim()\n    if (install.phase === 'checking' || isInstallPending(install.phase) || spec === '') return\n    const listed = state.packages.find(pkg => pkg.name === spec)\n    let catalogSubject = install.subject?.selection === undefined || install.subject.spec !== spec ? undefined : install.subject\n    if (listed?.availability === 'missing' && listed.installTarget !== undefined\n      && listed.error === undefined && catalogSubject === undefined) {\n      const target = listed.installTarget\n      const local = target.spec.startsWith('link:')\n      catalogSubject = {\n        status: 'accepted', kind: local ? 'path' : 'registry', name: listed.name, version: target.version, bundle: true,\n        spec: target.spec, registry: null, ...local ? {} : { saveExact: true },\n      }\n    }\n    if (this.ctx.get('productAnalytics')?.enabled) {\n      this.analyticsAttempt = { input: sanitizeInstallInput(spec), started: Date.now() }\n      this.ctx.get('productAnalytics')?.track('plugin_install_click', { input_value: sanitizeInstallInput(spec) })\n    }\n    if (listed?.availability === 'installation' && listed.optional && listed.listedByDefault === false\n      && !listed.enabled && listed.error === undefined && listed.readOnlyReason === undefined) {\n      this.abortInspect()\n      this.patch({ install: {\n        ...IDLE_INSTALL, open: true, spec, registries: install.registries, registry: install.registry,\n        phase: 'done', installed: listed.name, installedVersion: listed.version ?? null,\n        subject: { status: 'accepted', kind: 'registry', bundle: true, name: listed.name, spec, registry: null, bundled: true,\n          ...listed.version === undefined ? {} : { version: listed.version },\n          ...listed.description === undefined ? {} : { description: listed.description } },\n      } })\n      return\n    }\n    if (listed !== undefined && listed.availability !== 'missing' && catalogSubject === undefined) {\n      this.finishAnalytics('failed', 'already-installed')\n      this.patchInstall({ phase: 'idle', inputError: { problem: listed.availability === 'installation' ? 'shipped' : 'already-installed', reason: spec } })\n      return\n    }\n    const choice = install.registry\n    const typed = choice.kind === 'custom' ? choice.url.trim() : undefined\n    if (typed !== undefined && !REGISTRY_URL.test(typed)) {\n      this.finishAnalytics('failed', 'invalid-registry')\n      this.patchInstall({ phase: 'idle', registryError: true, registryOpen: true })\n      return\n    }\n    this.abortInspect()\n    const controller = new AbortController()\n    this.inspectAbort = controller\n    this.patchInstall({\n      phase: 'checking', inputError: null, subject: catalogSubject ?? null, runs: [], detailsOpen: false, attempts: null, registryOpen: false,\n      installed: null, installedVersion: null, restartRequired: false, failure: null, approvedBuilds: [], logPath: null,\n    })\n    const read = this.registryRead\n    if (read !== undefined && choice === read.choice && read.done !== undefined) {\n      await read.done\n      if (this.gone(controller.signal) || this.registryRead !== read) return\n    }\n    const currentChoice = this.getSnapshot().install.registry\n    const selected = currentChoice.kind === 'custom' ? { ...currentChoice, url: currentChoice.url.trim() } : currentChoice\n    const registry: Registry = selected.kind === 'custom' ? selected.url : selected.registry\n    if (!this.transientRegistry) this.registryMemory.set(selected)\n    if (catalogSubject !== undefined) {\n      this.inspectAbort = undefined\n      await this.startInstall({ ...catalogSubject, registry })\n      return\n    }\n    const inspected = await this.ctx.remote.pluginManager.inspect(spec, { registry }, controller.signal)\n    if (this.gone(controller.signal)) return\n    this.inspectAbort = undefined\n    if (!inspected.ok) {\n      this.finishAnalytics('failed', inspected.error.code)\n      this.patchInstall({ phase: 'idle', inputError: { problem: 'unknown', reason: inspected.error.message } })\n      return\n    }\n    if (inspected.value.status === 'refused') {\n      const { problem, reason, registries } = inspected.value\n      this.finishAnalytics('failed', problem)\n      this.patchInstall({ phase: 'idle', inputError: { problem, reason, ...registries === undefined ? {} : { registries } } })\n      return\n    }\n    await this.startInstall({ spec, ...inspected.value })\n  }\n\n  /**\n   * Hand the checked spec to the Host and settle the dialog from its answer.\n   * `approvedBuilds` names the pending install scripts the person allowed;\n   * the Host saves that permission for this profile before pnpm runs.\n   */\n  private async startInstall(subject: InstallSubject, approvedBuilds?: readonly string[]): Promise<void> {\n    const { spec, registry } = subject\n    const requestId = randomUUID() as PluginInstallRequestId\n    const request: InstallRequest = { requestId, acknowledged: false, replyLost: false, recovering: false }\n    this.request = request\n    this.patchInstall({\n      phase: 'starting', requestId, subject, runs: [], attempts: null, failure: null, installed: null, installedVersion: null,\n      approvedBuilds: [], logPath: null,\n    })\n    // The Host announces `plugin-manager/changed` while the run is still on\n    // the wire, and every such event reads again; those reads must not cancel\n    // the run's settlement.\n    const result = await this.ctx.remote.pluginManager.installBundle(spec, {\n      enabled: subject.selection ?? false, requestId, registry,\n      ...subject.saveExact === undefined ? {} : { saveExact: subject.saveExact },\n      ...approvedBuilds === undefined ? {} : { approvedBuilds: [...approvedBuilds] },\n    })\n    if (this.disposed || this.request !== request) return\n    if (!result.ok) {\n      request.replyLost = true\n      this.installUncertain('result', result.error.message)\n      void this.reconcileInstall()\n      return\n    }\n    this.settleInstall(result.value)\n  }\n\n  /** A recovery call shares the Host's active result; absent results are explicitly unknown. */\n  private async reconcileInstall(): Promise<void> {\n    const request = this.request\n    if (request === undefined || !request.replyLost || request.recovering) return\n    request.recovering = true\n    const result = await this.ctx.remote.pluginManager.waitForInstall(request.requestId)\n    if (this.disposed || this.request !== request) return\n    request.recovering = false\n    if (!result.ok) {\n      this.installUncertain('result', result.error.message)\n      return\n    }\n    if (result.value !== null) {\n      this.settleInstall(result.value)\n      return\n    }\n    this.request = undefined\n    this.finishAnalytics('unknown')\n    this.patchInstall({ phase: 'unknown', failure: null, runs: settledRuns(this.getSnapshot().install.runs, null) })\n    this.notifyHiddenInstall('unknown')\n    void this.load()\n  }\n\n  private settleInstall(result: ChangeResult): void {\n    this.finishAnalytics(result.application === 'failed' ? 'failed' : result.application === 'cancelled' ? 'cancelled' : 'success', result.application === 'failed' ? result.error?.code : undefined, result.bundle)\n    const { runs, attempts } = this.getSnapshot().install\n    this.request = undefined\n    // The Host's answer names every registry it asked, whether or not each attempt's announcement arrived.\n    const asked = result.registries === undefined\n      ? {}\n      : { attempts: { registries: result.registries, total: Math.max(attempts?.total ?? 0, result.registries.length) } }\n    if (result.application === 'cancelled') {\n      this.offerSpecAgain({ kind: 'cancelled', seq: ++this.noticeSeq })\n    } else if (result.application === 'failed') {\n      const packages = result.packageResult\n      this.patchInstall({\n        phase: 'failed', runs: settledRuns(runs, packages?.exitCode ?? null),\n        failure: failureOf(result.error, packages?.kind, result.pendingBuilds, result.failedAt, result.stage, result.enabled),\n        logPath: result.packageResult?.logPath ?? null,\n        ...asked,\n      })\n    } else {\n      this.patchInstall({\n        phase: 'done', runs: settledRuns(runs, 0), failure: null,\n        installed: result.bundle ?? null,\n        installedVersion: result.version ?? null,\n        restartRequired: result.application === 'restart-required',\n        ...result.restartReason === undefined ? {} : { restartReason: result.restartReason },\n        logPath: result.packageResult?.logPath ?? null,\n        approvedBuilds: result.approvedBuilds ?? [],\n        ...asked,\n      })\n    }\n    const completed = this.getSnapshot().install\n    if (completed.phase === 'done' && completed.subject?.selection !== undefined && result.bundle !== undefined) {\n      this.applied({ ok: true, value: result }, result.bundle)\n      this.patch({ highlight: result.bundle })\n      if (completed.subject.selection) this.trackToggle(result.bundle, true)\n    }\n    const phase = this.getSnapshot().install.phase\n    if (phase === 'done' || phase === 'failed') this.notifyHiddenInstall(phase)\n    void this.load()\n  }\n\n  private installUncertain(uncertainty: NonNullable<InstallState['failure']>['uncertainty'] & string, reason: string): void {\n    this.patchInstall({\n      phase: this.getSnapshot().install.phase === 'applying' ? 'applying' : 'unconfirmed',\n      failure: { reason, uncertainty },\n    })\n    this.notifyHiddenInstall('unconfirmed')\n  }\n\n  /**\n   * Allow the install scripts the failed run left pending and run the same\n   * spec again. Only the failed screen with pending names offers this.\n   */\n  private async approveBuildsAndRetry(): Promise<void> {\n    const install = this.getSnapshot().install\n    const pending = install.failure?.pendingBuilds\n    if (install.phase !== 'failed' || install.subject === null || pending === undefined || pending.length === 0) return\n    if (this.ctx.get('productAnalytics')?.enabled) this.analyticsAttempt = { input: sanitizeInstallInput(install.subject.spec), started: Date.now() }\n    await this.startInstall(install.subject, pending)\n  }\n\n  /**\n   * Leave the check or the failed screen for the spec at once; a Host-owned\n   * run is asked to stop and its state waits for the Host's word, since\n   * neither a dropped RPC nor a closed connection means pnpm has stopped.\n   */\n  private async cancelInstall(): Promise<void> {\n    const install = this.getSnapshot().install\n    if (install.phase === 'checking' || install.phase === 'failed' || install.phase === 'unknown') {\n      if (install.phase === 'checking') this.finishAnalytics('cancelled')\n      this.abortInspect()\n      this.offerSpecAgain()\n      return\n    }\n    const request = this.request\n    if ((install.phase !== 'starting' && install.phase !== 'running' && install.phase !== 'unconfirmed') || request === undefined) return\n    if (request.cancellation !== undefined && !request.cancellation.waitingForStart) return\n    const cancellation = { waitingForStart: false }\n    request.cancellation = cancellation\n    await this.sendCancellation(request, cancellation)\n  }\n\n  /** A cancellation that overtakes installation is retried after the Host acknowledges that request. */\n  private async sendCancellation(request: InstallRequest, cancellation: NonNullable<InstallRequest['cancellation']>): Promise<void> {\n    const acknowledged = request.acknowledged\n    cancellation.waitingForStart = false\n    this.patchInstall({ phase: 'cancelling', failure: null })\n    const result = await this.ctx.remote.pluginManager.cancelInstall(request.requestId)\n    if (this.disposed || this.request !== request || request.cancellation !== cancellation) return\n    if (!result.ok) {\n      cancellation.waitingForStart = !request.acknowledged\n      if (request.acknowledged) request.cancellation = undefined\n      this.installUncertain(request.replyLost ? 'result' : 'cancellation', result.error.message)\n      return\n    }\n    if (result.value.status === 'cancelled') {\n      this.finishAnalytics('cancelled')\n      this.offerSpecAgain({ kind: 'cancelled', seq: ++this.noticeSeq })\n      void this.load()\n    } else if (result.value.status === 'too-late') {\n      request.acknowledged = true\n      request.cancellation = undefined\n      this.patchInstall({ phase: 'applying' })\n      this.notifyHiddenInstall('applying')\n      void this.reconcileInstall()\n    } else if (request.replyLost) {\n      request.cancellation = undefined\n      this.installUncertain('result', '')\n      void this.reconcileInstall()\n    } else if (!acknowledged && this.getSnapshot().install.phase !== 'applying') {\n      if (request.acknowledged) {\n        await this.sendCancellation(request, cancellation)\n      } else {\n        cancellation.waitingForStart = true\n        this.installUncertain('acceptance', '')\n      }\n    } else {\n      request.cancellation = undefined\n      this.installUncertain('cancellation', '')\n    }\n  }\n\n  private notifyHiddenInstall(outcome: Extract<ManagerNotice, { kind: 'install' }>['outcome']): void {\n    if (!this.getSnapshot().install.open) this.patch({ notice: { kind: 'install', outcome, seq: ++this.noticeSeq } })\n  }\n\n  /**\n   * Release the tracked request and return to editing with its spec retained.\n   * A cancellation notice is supplied only after the Host confirms it stopped.\n   */\n  private offerSpecAgain(notice: ManagerNotice | null = null): void {\n    this.request = undefined\n    this.patch({ install: specAgain(this.getSnapshot().install), ...notice === null ? {} : { notice } })\n  }\n\n  /**\n   * Enable the bundle ready from an install or the installation, then close the dialog and\n   * mark it in the list. A refusal toasts and still closes.\n   */\n  private async enableInstalled(): Promise<void> {\n    const install = this.getSnapshot().install\n    if (install.phase !== 'done' || install.enabling) return\n    const name = install.installed\n    this.patchInstall({ enabling: true })\n    if (name !== null) {\n      const result = await this.ctx.remote.pluginManager.setBundleEnabled(name, true)\n      if (this.disposed) return\n      this.finishAnalytics(result.ok && result.value.application !== 'failed' ? 'success' : 'failed',\n        result.ok ? result.value.error?.code : result.error.code, name)\n      try {\n        this.applied(result, name)\n        if (result.ok && (result.value.application === 'applied' || result.value.application === 'restart-required')) this.trackToggle(name, true)\n      } catch (error) {\n        this.patch({ notice: failedNotice(error, { packageName: name, action: 'enable' }, ++this.noticeSeq) })\n      }\n    }\n    this.patch({ install: IDLE_INSTALL, highlight: name })\n    await this.load()\n  }\n\n  /**\n   * Run one action under a busy key, turn its failure into the notice, and\n   * re-read the Host afterwards whatever happened.\n   */\n  private async run(\n    key: string,\n    subject: { action: FailedAction; packageName?: string },\n    action: () => Promise<void>,\n  ): Promise<void> {\n    if (this.disposed || this.getSnapshot().busy.includes(key)) return\n    this.patch({ busy: [...this.getSnapshot().busy, key], notice: null })\n    try {\n      await action()\n    } catch (error) {\n      // `patch` drops the notice after disposal.\n      this.patch({ notice: failedNotice(error, subject, ++this.noticeSeq) })\n    } finally {\n      this.patch({ busy: this.getSnapshot().busy.filter(entry => entry !== key) })\n    }\n    await this.load()\n  }\n\n  /**\n   * Publish a change's outcome: a refused answer or a change the Host could\n   * not apply throws for {@link run} to report; a change that waits for the\n   * next start, that a higher layer overrides, or that the Host stopped is\n   * said in passing.\n   */\n  private applied(answer: Answer<ChangeResult>, packageName: string): void {\n    if (!answer.ok) throw new RemoteAnswerError(answer.error.message)\n    const result = answer.value\n    switch (result.application) {\n      case 'failed':\n        throw new RemoteAnswerError(result.error?.diagnostic ?? '', result.error?.code, result.error?.incompatible)\n      case 'cancelled':\n        this.patch({ notice: { kind: 'cancelled', seq: ++this.noticeSeq } })\n        return\n      case 'restart-required':\n        this.patch({ notice: { kind: 'restart', packageName, reason: result.restartReason, seq: ++this.noticeSeq } })\n        return\n      case 'overridden':\n        this.patch({ notice: { kind: 'overridden', packageName, seq: ++this.noticeSeq } })\n        return\n      case 'applied':\n        return\n    }\n  }\n\n  private trackToggle(name: string, enabled: boolean, row = false): void {\n    const bundle = this.getSnapshot().packages.find(pkg => row ? pkg.rows.some(item => item.entryId === name) : pkg.name === name)\n    const pluginName = row ? bundle?.rows.find(item => item.entryId === name)?.moduleName : name\n    if (bundle === undefined || pluginName === undefined) return\n    this.ctx.get('productAnalytics')?.track('plugin_toggle', {\n      plugin_name: pluginName, plugin_type: row ? 'plugin' : 'bundle', is_enabled: enabled, is_builtin: bundle.availability === 'installation',\n    })\n  }\n\n  private finishAnalytics(status: 'success' | 'failed' | 'cancelled' | 'unknown', reason?: string, name?: string): void {\n    const attempt = this.analyticsAttempt\n    this.analyticsAttempt = undefined\n    if (attempt === undefined || this.disposed) return\n    const errorReason = status === 'cancelled' ? 'user_cancelled' : status === 'unknown' ? 'unknown_result' : reason\n    this.ctx.get('productAnalytics')?.track('install_plugin_result', {\n      input_value: attempt.input, is_success: status === 'success',\n      duration: Math.max(0, Date.now() - attempt.started),\n      ...errorReason === undefined ? {} : { error_reason: errorReason }, ...name === undefined ? {} : { plugin_name: name },\n    })\n  }\n\n  private patch(next: Partial<PluginManagerState>): void {\n    if (this.disposed) return\n    this.store.set({ ...this.getSnapshot(), ...next })\n  }\n\n  private patchInstall(next: Partial<InstallState>): void {\n    this.patch({ install: { ...this.getSnapshot().install, ...next } })\n  }\n}\n\n/** What a thrown failure said: a refused answer's reason, else the error's message. */\nfunction reasonOf(error: unknown): string {\n  return error instanceof Error ? error.message : String(error)\n}\n","/**\n * A registry bundle's Versions section and the update dialog. The section summarizes the Host's version check in one\n * row and unfolds into the newer versions; the dialog confirms one update of a registry or Git copy, follows the\n * Host's steps, and reports how the update ended, including the reinstallation of the removed version after a failed\n * installation.\n */\n\nimport { useEffect, useState, type ReactNode } from 'react'\nimport type {\n  IncompatiblePlugin, PluginUpdateResult, PluginUpdateStep, PluginVersion, PluginVersionList, Registry, RegistryAttempt,\n} from '@deepseek-ai/dsh-api-remotes/client'\nimport {\n  Button, Checkbox, IconCheckOutlineRegular, IconChevronDownOutlineRegular, IconChevronRightOutlineRegular, IconCloseOutlineRegular,\n  IconDownloadOutlineRegular, IconRefreshOutlineRegular, IconWarningOutlineRegular, Modal, StateDot, Tag, Tooltip,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport { installable, updateCandidate, type PackageView, type UpdateSource, type UpdateState, type VersionCheck } from './manager-store.ts'\nimport { managementText, registryText, restartText, type Translate } from './presentation.ts'\nimport css from './PluginManagerPage.module.css'\n\n/** The tone of a summary or outcome glyph. */\ntype Tone = 'info' | 'success' | 'warn' | 'error' | 'neutral'\n\n/** Two digits of a date or time field. */\nfunction pad(value: number): string {\n  return String(value).padStart(2, '0')\n}\n\n/** A version's local publication day as `YYYY-MM-DD`, which reads the same in every UI language. */\nfunction publishedDate(version: PluginVersion): string | undefined {\n  if (version.publishedAt === undefined) return undefined\n  const day = new Date(version.publishedAt)\n  return `${String(day.getFullYear())}-${pad(day.getMonth() + 1)}-${pad(day.getDate())}`\n}\n\n/** The local time of day a check arrived, as 24-hour `HH:MM`. */\nfunction checkedTime(checkedAt: number): string {\n  const time = new Date(checkedAt)\n  return `${pad(time.getHours())}:${pad(time.getMinutes())}`\n}\n\n/** The registry by name: npm's own and the mainland mirror by theirs, pnpm's own configuration as the default, any other by host. */\nfunction registryName(registry: Registry, t: Translate): string {\n  return registryText(registry, t, null).name\n}\n\n/** Where an update installs from: the registry by name, or a pinned Git spec's repository as host and path. */\nfunction sourceName(source: UpdateSource, t: Translate): string {\n  if (source.kind === 'registry') return registryName(source.registry, t)\n  return source.spec.replace(/^git\\+/i, '').replace(/#.*$/s, '').replace(/^[a-z]+:\\/\\//i, '').replace(/\\.git$/i, '')\n}\n\n/** The DSH requirements an incompatible version states, as one phrase: `engines.dsh` or DSH peer ranges. */\nfunction peersText(incompatible: IncompatiblePlugin): string {\n  return Object.entries(incompatible.requirements).map(([name, range]) => `${name} ${range}`).join(', ')\n}\n\nconst PROBLEM_KEYS = {\n  'network': 'versionsProblemNetwork',\n  'not-found': 'versionsProblemNotFound',\n  'unknown': 'versionsProblemUnknown',\n} as const\n\nfunction Glyph({ tone, children }: { readonly tone: Tone; readonly children: ReactNode }): ReactNode {\n  return <span className={css.versionGlyph} data-tone={tone} aria-hidden=\"true\">{children}</span>\n}\n\n/** The summary row's glyph, title, the line under it, and how many newer versions it unfolds into. */\ninterface Summary {\n  tone: Tone\n  glyph: ReactNode\n  title: string\n  sub?: string\n  newer: number\n}\n\nfunction summaryOf(check: VersionCheck | undefined, t: Translate): Summary {\n  if (check === undefined || check.phase === 'checking') {\n    return { tone: 'neutral', glyph: <StateDot state=\"ongoing\" size={14} />, title: t('versionsChecking'), newer: 0 }\n  }\n  const { list } = check\n  if (list.status === 'refused') {\n    const failed = list.attempts.at(-1)\n    return {\n      tone: 'error', glyph: <IconCloseOutlineRegular size={14} />,\n      title: t(list.problem === 'network' ? 'versionsFailedNetwork' : 'versionsFailedOther'),\n      // A check the transport lost asked no registry the page knows of; its words stand alone.\n      sub: failed?.problem === undefined ? list.reason : `${registryName(failed.registry, t)} ${t(PROBLEM_KEYS[failed.problem])}`,\n      newer: 0,\n    }\n  }\n  const candidate = updateCandidate(list)\n  if (candidate !== undefined) {\n    const date = publishedDate(candidate)\n    return {\n      tone: 'info', glyph: <IconDownloadOutlineRegular size={14} />, title: t('versionsAvailable', { version: candidate.version }),\n      ...date === undefined ? {} : { sub: t('versionsPublished', { date }) }, newer: list.versions.length,\n    }\n  }\n  if (list.versions.length === 0) {\n    return { tone: 'success', glyph: <IconCheckOutlineRegular size={14} />, title: t('versionsLatest'), sub: t('versionsCheckedAt', { time: checkedTime(check.checkedAt) }), newer: 0 }\n  }\n  const blocked = list.versions.find(version => !version.prerelease && version.incompatible !== undefined)?.incompatible\n  return blocked === undefined\n    ? { tone: 'warn', glyph: <IconWarningOutlineRegular size={14} />, title: t('versionsNoneInstallable'), sub: t('versionsNoneInstallableDetail'), newer: list.versions.length }\n    : {\n      tone: 'warn', glyph: <IconWarningOutlineRegular size={14} />, title: t('versionsBlocked'), newer: list.versions.length,\n      sub: t('versionsBlockedDetail', { version: blocked.version, peers: peersText(blocked), runtime: blocked.runtimeVersion }),\n    }\n}\n\n/** One version row: its number and tags, why it cannot or should not be installed, its date, and its update action. */\nfunction VersionRow({ version, installed, t, busy, onUpdate }: {\n  readonly version: PluginVersion | { readonly version: string; readonly installedRow: true }\n  readonly installed: string\n  readonly t: Translate\n  readonly busy: boolean\n  readonly onUpdate: (version: string) => void\n}): ReactNode {\n  if ('installedRow' in version) {\n    return (\n      <li className={css.versionRow} data-plugin-version={version.version}>\n        <div className={css.versionMain}>\n          <div className={css.versionTitle}>\n            <span className={css.versionNumber}>{version.version}</span>\n            <Tag className={css.statusTag} tone=\"neutral\">{t('versionsInstalledTag')}</Tag>\n          </div>\n        </div>\n      </li>\n    )\n  }\n  const usable = installable(version)\n  const note = version.incompatible !== undefined ? t('versionsNeedsDsh', { peers: peersText(version.incompatible) })\n    : !version.bundle ? t('versionsNotBundle') : version.deprecated\n  const date = publishedDate(version)\n  return (\n    <li className={css.versionRow} data-plugin-version={version.version} {...usable ? {} : { 'data-blocked': '' }}>\n      <div className={css.versionMain}>\n        <div className={css.versionTitle}>\n          <span className={css.versionNumber}>{version.version}</span>\n          {version.tags.map(tag => <Tag key={tag} className={css.statusTag} tone=\"outline\">{tag}</Tag>)}\n          {version.prerelease ? <Tag className={css.statusTag} tone=\"outline\">{t('versionsPrereleaseTag')}</Tag> : null}\n          {version.deprecated === undefined ? null : <Tag className={css.statusTag} tone=\"warning\">{t('versionsDeprecatedTag')}</Tag>}\n        </div>\n        {note === undefined ? null : <span className={css.versionNote} data-tone={usable && version.deprecated !== undefined ? 'warn' : undefined}>{note}</span>}\n      </div>\n      {date === undefined ? null : <span className={css.versionDate}>{date}</span>}\n      <span className={css.versionAction}>\n        {usable && version.version !== installed ? (\n          <Button\n            variant={version.deprecated === undefined && !version.prerelease ? 'outline' : 'ghost'}\n            size=\"sm\"\n            disabled={busy}\n            aria-label={t('versionsUpdateLabel', { version: version.version })}\n            onClick={() => { onUpdate(version.version) }}\n          >\n            {t('update')}\n          </Button>\n        ) : null}\n      </span>\n    </li>\n  )\n}\n\n/** The registries a refused check asked, each with what it answered. */\nfunction AttemptRows({ attempts, t }: { readonly attempts: readonly RegistryAttempt[]; readonly t: Translate }): ReactNode {\n  return (\n    <ul className={css.versionRows}>\n      {attempts.map((attempt, index) => (\n        <li key={`${String(attempt.registry)}:${String(index)}`} className={css.versionRow}>\n          <div className={css.versionMain}>\n            <div className={css.versionTitle}>\n              <span className={css.versionNumber}>{registryName(attempt.registry, t)}</span>\n              <Tag className={css.statusTag} tone=\"outline\">{t(index === 0 ? 'versionsPrimaryTag' : 'versionsFallbackTag')}</Tag>\n              {attempt.problem === undefined ? null : <Tag className={css.statusTag} tone=\"danger\">{t(PROBLEM_KEYS[attempt.problem])}</Tag>}\n            </div>\n            {attempt.reason === undefined ? null : <code className={css.versionLog}>{attempt.reason}</code>}\n          </div>\n        </li>\n      ))}\n    </ul>\n  )\n}\n\n/** The unfolded list: newer versions, the installed one, and where and when the list was read. */\nfunction VersionList({ list, checkedAt, t, busy, onUpdate }: {\n  readonly list: Extract<PluginVersionList, { status: 'listed' }>\n  readonly checkedAt: number\n  readonly t: Translate\n  readonly busy: boolean\n  readonly onUpdate: (version: string) => void\n}): ReactNode {\n  const [prereleases, setPrereleases] = useState(false)\n  const shown = list.versions.filter(version => prereleases || !version.prerelease)\n  const fallback = list.attempts.length > 1 ? list.attempts[0] : undefined\n  return (\n    <div className={css.versionBody}>\n      <ul className={css.versionRows}>\n        {shown.map(version => (\n          <VersionRow key={version.version} version={version} installed={list.installed} t={t} busy={busy} onUpdate={onUpdate} />\n        ))}\n        <VersionRow version={{ version: list.installed, installedRow: true }} installed={list.installed} t={t} busy={busy}\n          onUpdate={onUpdate} />\n      </ul>\n      {list.omitted > 0 ? <p className={css.versionNote}>{t('versionsOmitted', { count: String(list.omitted) })}</p> : null}\n      <div className={css.versionMeta}>\n        <dl className={css.versionFact}>\n          <dt>{t('versionsRegistry')}</dt>\n          <dd>\n            {registryName(list.registry, t)}\n            {fallback === undefined ? null : (\n              <Tooltip label={t('versionsFallbackHint', { registry: registryName(fallback.registry, t) })} side=\"top\" portal>\n                <span className={css.versionHint} tabIndex={0}><Tag className={css.statusTag} tone=\"outline\">{t('versionsFallbackTag')}</Tag></span>\n              </Tooltip>\n            )}\n          </dd>\n        </dl>\n        <dl className={css.versionFact}>\n          <dt>{t('versionsCheckedAtLabel')}</dt>\n          <dd>{checkedTime(checkedAt)}</dd>\n        </dl>\n        <span className={css.versionSpacer} />\n        {list.versions.some(version => version.prerelease)\n          ? <Checkbox checked={prereleases} onChange={setPrereleases} label={t('versionsShowPrerelease')} />\n          : null}\n      </div>\n    </div>\n  )\n}\n\n/**\n * The Versions section of a registry bundle's page. It checks once when the page opens and folds the newer versions\n * behind a summary row.\n */\nexport function VersionSection({ pkg, check, t, busy, onEnsure, onCheck, onUpdate }: {\n  readonly pkg: PackageView\n  readonly check: VersionCheck | undefined\n  readonly t: Translate\n  readonly busy: boolean\n  /** Check a package's versions unless a check already started. */\n  readonly onEnsure: (packageName: string) => void\n  readonly onCheck: () => void\n  readonly onUpdate: (version: string) => void\n}): ReactNode {\n  const [open, setOpen] = useState(false)\n  const { name } = pkg\n  const listsVersions = pkg.update === 'registry'\n  useEffect(() => { if (listsVersions) onEnsure(name) }, [name, listsVersions, onEnsure])\n  if (!listsVersions) return null\n  const done = check?.phase === 'done' ? check : undefined\n  const summary = summaryOf(check, t)\n  const refused = done?.list.status === 'refused' ? done.list : undefined\n  const listed = done?.list.status === 'listed' ? done.list : undefined\n  const unfolds = summary.newer > 0 || (refused !== undefined && refused.attempts.length > 0)\n  const expanded = open && unfolds\n  const text = (\n    <span className={css.versionSummaryText}>\n      <span className={css.versionSummaryTitle}>{summary.title}</span>\n      {summary.sub === undefined ? null : <span className={css.versionSummarySub}>{summary.sub}</span>}\n    </span>\n  )\n  return (\n    <section className={css.detailSection} data-plugin-versions>\n      <div className={css.sectionHead}>\n        <h4 className={css.sectionTitle}>{t('versionsTitle')}</h4>\n        <span className={css.versionSpacer} />\n        {refused === undefined ? (\n          <Button variant=\"ghost\" size=\"sm\" icon={<IconRefreshOutlineRegular size={13} />} disabled={check?.phase !== 'done'} onClick={onCheck}>\n            {t('versionsRecheck')}\n          </Button>\n        ) : null}\n      </div>\n      <div className={css.versionPanel}>\n        {listed !== undefined && summary.newer > 0 ? (\n          <button type=\"button\" className={css.versionSummary} aria-expanded={expanded} onClick={() => { setOpen(!open) }}>\n            <Glyph tone={summary.tone}>{summary.glyph}</Glyph>\n            {text}\n            <span className={css.versionSummaryEnd}>\n              {expanded ? t('versionsCollapse') : t('versionsNewerCount', { count: String(summary.newer) })}\n              <IconChevronDownOutlineRegular className={css.detailsChevron} aria-hidden=\"true\" />\n            </span>\n          </button>\n        ) : (\n          <div className={css.versionSummary} role=\"status\">\n            <Glyph tone={summary.tone}>{summary.glyph}</Glyph>\n            {text}\n            {refused === undefined ? null : (\n              <span className={css.versionSummaryEnd}>\n                {unfolds ? (\n                  <button type=\"button\" className={css.detailsToggle} aria-expanded={expanded} onClick={() => { setOpen(!open) }}>\n                    {t('versionsDetails')}\n                    <IconChevronDownOutlineRegular className={css.detailsChevron} aria-hidden=\"true\" />\n                  </button>\n                ) : null}\n                <Button variant=\"outline\" size=\"sm\" onClick={onCheck}>{t('retry')}</Button>\n              </span>\n            )}\n          </div>\n        )}\n        {expanded && listed !== undefined && done !== undefined\n          ? <VersionList list={listed} checkedAt={done.checkedAt} t={t} busy={busy} onUpdate={onUpdate} />\n          : null}\n        {expanded && refused !== undefined\n          ? <div className={css.versionBody}><AttemptRows attempts={refused.attempts} t={t} /></div>\n          : null}\n      </div>\n    </section>\n  )\n}\n\n/** The step labels of an update; the Host announces each step as it starts. */\nfunction stepLabel(step: PluginUpdateStep, update: UpdateState, t: Translate): string {\n  switch (step) {\n    case 'checking': return t('updateStepChecking', { version: update.to })\n    case 'removing': return t('updateStepRemoving', { version: update.from })\n    case 'installing': return t('updateStepInstalling', { version: update.to, source: sourceName(update.source, t) })\n    case 'restoring': return t('updateStepRestoring', { version: update.from })\n  }\n}\n\n/** Whether a change result left its operation undone. */\nfunction failed(application: PluginUpdateResult['result']['application']): boolean {\n  return application === 'failed' || application === 'cancelled'\n}\n\n/** The steps in the order the Host runs them. */\nconst STEP_ORDER: readonly PluginUpdateStep[] = ['checking', 'removing', 'installing', 'restoring']\n\n/** The steps an answer implies, joined with the announced ones, so a lost announcement does not drop a step that ran. */\nfunction settledSteps(announced: readonly PluginUpdateStep[], result: PluginUpdateResult): PluginUpdateStep[] {\n  const implied = new Set<PluginUpdateStep>(['checking', ...announced])\n  if (result.step === 'remove') implied.add('removing')\n  if (result.step === 'install') implied.add('installing')\n  if (result.restore !== undefined) implied.add('restoring')\n  return STEP_ORDER.filter(step => implied.has(step))\n}\n\n/** How one step ended, or that it still runs. */\nfunction stepState(step: PluginUpdateStep, update: UpdateState, last: boolean): 'running' | 'done' | 'failed' | 'unknown' {\n  const result = update.result\n  if (update.phase === 'running') return last ? 'running' : 'done'\n  if (result === null) return last ? 'unknown' : 'done'\n  switch (step) {\n    case 'checking': return result.step === 'check' ? 'failed' : 'done'\n    case 'removing': return result.step === 'remove' ? 'failed' : 'done'\n    case 'installing': return failed(result.result.application) ? 'failed' : 'done'\n    case 'restoring': return result.restore !== undefined && failed(result.restore.application) ? 'failed' : 'done'\n  }\n}\n\nconst STEP_GLYPHS = {\n  running: <StateDot state=\"ongoing\" size={12} />,\n  done: <IconCheckOutlineRegular size={12} />,\n  failed: <IconCloseOutlineRegular size={12} />,\n  unknown: null,\n} as const\n\n/** What the update's outcome reads as: its glyph, title, and the sentence under it. */\nfunction outcomeOf(update: UpdateState, title: string, t: Translate): Omit<Summary, 'sub' | 'newer'> & { detail: string } {\n  const error = { tone: 'error' as const, glyph: <IconCloseOutlineRegular size={14} /> }\n  const result = update.result\n  // A finished update without the Host's answer carries the transport's words.\n  if (result === null) return { ...error, title: t('updateLost'), detail: t('updateLostDetail', { reason: String(update.lost) }) }\n  // A failed step always carries the Host's refusal; an absent one reads as the generic operation error.\n  const reason = (change: PluginUpdateResult['result']): string => managementText({ code: 'operation-error', ...change.error, installing: true }, t)\n  if (result.step === 'check') return { ...error, title: t('updateRefused', { version: update.to }), detail: reason(result.result) }\n  if (result.step === 'remove') return { ...error, title: t('updateRemoveFailed', { version: update.from }), detail: reason(result.result) }\n  if (!failed(result.result.application)) {\n    return result.result.application === 'restart-required'\n      ? { tone: 'warn', glyph: <IconWarningOutlineRegular size={14} />, title: t('updateRestart', { version: update.to }), detail: restartText('restartNotice', result.result.restartReason, t) }\n      : { tone: 'success', glyph: <IconCheckOutlineRegular size={14} />, title: t('updateDone', { version: update.to }), detail: t('updateDoneDetail') }\n  }\n  // Without a reinstallation nothing was removed: the installation went over the running version and was rolled back.\n  if (result.restore === undefined) {\n    return { ...error, title: t('updateKept', { version: update.to }), detail: t('updateKeptDetail', { from: update.from, reason: reason(result.result) }) }\n  }\n  return failed(result.restore.application)\n    ? { ...error, title: t('updateBroken'), detail: t('updateBrokenDetail', { from: update.from, to: update.to, name: title }) }\n    : {\n      ...error, title: t('updateRestored', { version: update.from }),\n      // A typed refusal says why the target failed; pnpm's own words stay behind the output toggle.\n      detail: [\n        t('updateRestoredDetail', { from: update.from, to: update.to }),\n        ...result.result.error === undefined || result.result.error.code === 'operation-error' ? [] : [reason(result.result)],\n      ].join(t('sentenceSeparator')),\n    }\n}\n\n/** The update dialog: confirmation, then the Host's steps, then the outcome. */\nexport function UpdateDialog({ update, title, t, onRun, onClose, onToggleOutput }: {\n  readonly update: UpdateState\n  /** The package's display title. */\n  readonly title: string\n  readonly t: Translate\n  readonly onRun: () => void\n  readonly onClose: () => void\n  readonly onToggleOutput: () => void\n}): ReactNode {\n  const running = update.phase === 'running'\n  const steps = update.result === null ? update.steps : settledSteps(update.steps, update.result)\n  const outcome = update.phase === 'done' ? outcomeOf(update, title, t) : undefined\n  // The failed run's own output: the target's installation, else the removal or the reinstallation.\n  const output = [update.result?.result, update.result?.restore]\n    .map(change => change !== undefined && failed(change.application) ? change.packageResult?.output : undefined)\n    .find(text => text !== undefined && text !== '')\n  return (\n    <Modal\n      open\n      onClose={() => { if (!running) onClose() }}\n      title={t('updateTitle', { name: title })}\n      closeLabel={t('close')}\n      className={css.updateDialog as string}\n      footer={update.phase === 'confirm' ? (\n        <>\n          <Button variant=\"outline\" onClick={onClose}>{t('cancel')}</Button>\n          <Button variant=\"primary\" onClick={onRun}>{t('update')}</Button>\n        </>\n      ) : running\n        ? <Button variant=\"outline\" disabled>{t('updateRunning')}</Button>\n        : <Button variant=\"primary\" onClick={onClose}>{t('updateFinish')}</Button>}\n    >\n      <div className={css.updateBody} data-plugin-update={update.phase}>\n        {update.phase === 'confirm' ? (\n          <>\n            <div className={css.updateVersions}>\n              <span className={css.versionNumber} data-old=\"\">{update.from}</span>\n              <IconChevronRightOutlineRegular size={14} aria-hidden=\"true\" />\n              <span className={css.versionNumber}>{update.to}</span>\n            </div>\n            <dl className={css.versionFact}>\n              <dt>{t('updateSource')}</dt>\n              <dd>{sourceName(update.source, t)}</dd>\n            </dl>\n            <p className={css.updateText}>{t('updateDescription', { from: update.from, to: update.to })}</p>\n          </>\n        ) : (\n          <>\n            {outcome === undefined ? null : (\n              <div className={css.updateOutcome} role=\"status\">\n                <Glyph tone={outcome.tone}>{outcome.glyph}</Glyph>\n                <span className={css.versionSummaryText}>\n                  <span className={css.versionSummaryTitle}>{outcome.title}</span>\n                  <span className={css.versionSummarySub}>{outcome.detail}</span>\n                </span>\n              </div>\n            )}\n            {output === undefined ? null : (\n              <>\n                <button type=\"button\" className={css.detailsToggle} aria-expanded={update.outputOpen} onClick={onToggleOutput}>\n                  {t('updateOutput')}\n                  <IconChevronDownOutlineRegular className={css.detailsChevron} aria-hidden=\"true\" />\n                </button>\n                {update.outputOpen ? <pre className={css.updateOutput}>{output}</pre> : null}\n              </>\n            )}\n            <ol className={css.updateSteps}>\n              {steps.map((step, index) => {\n                const state = stepState(step, update, index === steps.length - 1)\n                return (\n                  <li key={step} className={css.updateStep} data-state={state}>\n                    <span className={css.updateStepDot} aria-hidden=\"true\">{STEP_GLYPHS[state]}</span>\n                    <span>{stepLabel(step, update, t)}</span>\n                  </li>\n                )\n              })}\n            </ol>\n          </>\n        )}\n      </div>\n    </Modal>\n  )\n}\n","/** A bundle's long description on its page: the Markdown document the Host reads for it. */\nimport { useEffect, useMemo, type ReactNode } from 'react'\nimport { DetailDocument, detailDocumentState, useDetailDocumentLabels, type MarkdownPathImages } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { PropsLocale } from '@deepseek-ai/dsh-client-ui-slots'\nimport { bundleDetailKey, type BundleDetailFailure, type BundleDetailsState } from './detail-store.ts'\n\ntype Translate = PropsLocale<'pluginManager'>['t']\n\nconst FAILURE_KEYS = {\n  'too-large': 'detailTooLarge',\n  'network': 'detailNetwork',\n  'denied': 'detailFailed',\n  'git-unavailable': 'detailFailed',\n  'invalid': 'detailInvalid',\n  'other': 'detailFailed',\n} as const satisfies Record<BundleDetailFailure, string>\n\n/** What the section reads and calls; the page passes them from its injected face. */\nexport interface BundleDetailSectionProps {\n  readonly name: string\n  readonly version: string | undefined\n  /** Whether the bundle's files are unavailable, so the Host reads its offered version from the npm file CDNs. */\n  readonly fromNpm: boolean\n  readonly language: string\n  readonly details: BundleDetailsState\n  readonly t: Translate\n  readonly load: (name: string, version: string | undefined, language: string, fromNpm: boolean) => void\n  readonly retry: (name: string, version: string | undefined, language: string, fromNpm: boolean) => void\n  readonly image: (name: string, document: string, destination: string, fromNpm: boolean) => string | undefined\n}\n\n/**\n * Read and render a bundle's detail document in the active language; relative images load from the Host beside it.\n * @param props - the bundle, the language, the reads, and the page's callbacks.\n * @returns the section, or null when the bundle has no document.\n */\nexport function BundleDetailSection(props: BundleDetailSectionProps): ReactNode {\n  const { name, version, fromNpm, language, details, t, load, retry, image } = props\n  const key = bundleDetailKey(name, version, language)\n  const state = details[key]\n  useEffect(() => { load(name, version, language, fromNpm) }, [key, details])\n  const labels = useDetailDocumentLabels({\n    title: t('detailTitle'), loading: t('detailLoading'), retry: t('retry'), copy: t('copy'), copied: t('copied'),\n    codeBlock: t('codeBlock.title'), wrap: t('codeBlock.wrap'), unwrap: t('codeBlock.unwrap'), footnotes: t('detailFootnotes'),\n  })\n  const detail = state?.status === 'ready' ? state.detail : undefined\n  const document = detail?.status === 'found' ? detail.path : undefined\n  const images = useMemo<MarkdownPathImages | undefined>(\n    () => document === undefined ? undefined : { resolve: value => image(name, document, value, fromNpm) },\n    [name, document, fromNpm, image],\n  )\n  const shown = detailDocumentState(state?.status === 'error'\n    ? { status: 'error', message: t(FAILURE_KEYS[state.failure]) }\n    : state === undefined || state.status === 'loading' ? state : { status: 'ready', markdown: detail?.status === 'found' ? detail.markdown : undefined })\n  return <DetailDocument state={shown} labels={labels} images={images} onRetry={() => { retry(name, version, language, fromNpm) }} />\n}\n","/**\n * Global plugin management: grouped cards for official configuration and\n * optional bundles, the Installed group's cards for the profile's bundles,\n * their row switches, the install dialog with its guide and folded pnpm\n * output, the uninstall confirmation, and the toasts an action's outcome\n * becomes. A bundle's page lists the rows it contributes as the Host runs\n * them; a plugin's configuration renders on its own page through the slots\n * the page declares.\n */\n\nimport { useEffect, useId, useRef, useState, type ReactNode } from 'react'\nimport { createPortal } from 'react-dom'\nimport type { PluginInstallFailureKind, Registry } from '@deepseek-ai/dsh-api-remotes/client'\nimport {\n  Button, IconCheckCircleFillRegular, IconChevronDownOutlineRegular, IconChevronLeftOutlineMedium,\n  IconChevronRightOutlineRegular, IconCloseOutlineMedium,\n  IconDownloadOutlineRegular, IconInfoOutlineRegular, IconPlusOutlineRegular, IconRefreshOutlineRegular, IconTrashOutlineRegular,\n  IconWarningOutlineRegular, Input, Menu, MenuItemButton, Modal, pointerModality,\n  PluginArtworkDefault, PluginArtworkLoop, PluginArtworkSearch, PluginArtworkSubagent, PluginArtworkTerminal,\n  SegmentedTabs, StateDot, Switch, Tag, TerminalBlock, Toast, Tooltip, useDismissOnOutsidePointer,\n  type IconProps, type StateDotState, type TerminalBlockLabels,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { InjectFace, PropsLocale, PropsRenderSlots, PropsRuntime, PropsStore } from '@deepseek-ai/dsh-client-ui-slots'\nimport { EXTENSION_BUNDLES, HIDDEN_BUNDLES, MORE_BUNDLES } from '@deepseek-ai/dsh-official-bundles'\nimport type { createNavigationStore } from './navigation-store.ts'\nimport type { PluginHeaderLayoutFace } from './header-scroll.ts'\nimport { rowConfigKey, type OfficialItem } from './config-ledger.ts'\nimport { INSTALL_GIT_EXAMPLE, INSTALL_PATH_EXAMPLE, type PluginManagerLocaleKey } from './locales.ts'\nimport {\n  bundleBusy, asksMirror, githubRecoveryRegistry, isInstallPending, offeredRegistries, rowKey, updateCandidate,\n  type InstallInputError, type InstallState, type InstallSubject, type PackageRow, type PackageView,\n  type PluginManagerFace, type PluginManagerState, type RegistryChoice, type VersionCheck,\n} from './manager-store.ts'\nimport { managementText, noticeText, packageText, registryText, restartText, rowText, type Translate } from './presentation.ts'\nimport type { PluginPackageRef, PluginRowRef, PluginsSubject } from './slot-contract.ts'\nimport type { ConfigPageForm } from './slot-contract.ts'\nimport { UpdateDialog, VersionSection } from './versions.tsx'\nimport { BundleDetailSection } from './BundleDetailSection.tsx'\nimport css from './PluginManagerPage.module.css'\n\n/** Full component props assembled by the main slot renderer. */\nexport type PluginManagerPageProps =\n  PropsRuntime<'main'>\n  & PropsLocale<'pluginManager'>\n  & PropsRenderSlots<\n    | 'plugins.item' | 'plugins.bundle.config' | 'plugins.row.config' | 'plugins.bundle.activation'\n    | 'plugins.add.actions' | 'plugins.tab'\n    | 'plugins.detail.actions' | 'plugins.detail.badge' | 'plugins.detail.section'\n  >\n  & InjectFace<PluginManagerFace & PluginHeaderLayoutFace>\n  & PropsStore<ReturnType<typeof createNavigationStore>>\n\n/** The page's slot renderer, narrowed to the configuration slots. */\ntype RenderConfig = PluginManagerPageProps['renderSlot']\ntype ResolveText = PluginManagerFace['resolveText']\n\ntype RowPhase = NonNullable<PackageRow['phase']>\n\n/** The primary action installs; the adjacent menu offers every add-plugin path. */\nfunction AddPluginMenu({ t, disabled, openInstall, renderSlot }: {\n  readonly t: Translate\n  readonly disabled: boolean\n  readonly openInstall: () => void\n  readonly renderSlot: RenderConfig\n}): ReactNode {\n  const [open, setOpen] = useState(false)\n  const onDismiss = (): void => { setOpen(false) }\n  return (\n    <span className={css.addGroup} role=\"group\" aria-label={t('addPlugin')}>\n      <Tooltip label={t('addPlugin')} side=\"bottom\" delayMs={500} focusDelayMs={500} portal disabled={disabled}>\n        <Button variant=\"primary\" size=\"sm\" className={css.addPrimary} icon={<IconPlusOutlineRegular size={13} />}\n          aria-label={t('addPlugin')} disabled={disabled} onClick={() => { onDismiss(); openInstall() }}>\n          <span className={css.toolbarLabel}>{t('addPlugin')}</span>\n        </Button>\n      </Tooltip>\n      <Menu open={open} onClose={onDismiss} align=\"end\" portal autoFocus listClassName={css.addMenu}\n        anchor={(\n          <Button variant=\"primary\" size=\"sm\" className={css.addMore}\n            disabled={disabled} aria-label={t('chooseAddMethod')} aria-haspopup=\"menu\" aria-expanded={open}\n            onClick={() => { setOpen(value => !value) }}\n            onKeyDown={(event) => {\n              if (!open && event.key === 'ArrowDown') { event.preventDefault(); setOpen(true) }\n            }}>\n            <IconChevronDownOutlineRegular size={12} aria-hidden=\"true\" />\n          </Button>\n        )}>\n        <MenuItemButton icon={<IconDownloadOutlineRegular size={14} />} onSelect={() => { onDismiss(); openInstall() }}>\n          <span className={css.addMenuItem}>\n            <span>{t('installExisting')}</span>\n            <span className={css.addMenuDescription}>{t('installExistingDescription')}</span>\n          </span>\n        </MenuItemButton>\n        {renderSlot('plugins.add.actions', { onDismiss })}\n      </Menu>\n    </span>\n  )\n}\n\n/** How long the list marks a package an install just enabled. */\nconst HIGHLIGHT_MS = 2_400\n\n/**\n * Whether any plugin row this bundle's patch declares is running.\n *\n * A default-hidden bundle's rows may run without the profile selecting it, for example through\n * `cordis.patch.yml`; that run state is the effective enablement the lists offer.\n * @param pkg - the bundle as the Host reports it.\n * @returns whether at least one declared row runs.\n */\nfunction rowsRunning(pkg: PackageView): boolean {\n  return pkg.rows.some(row => row.enabled)\n}\n\n/**\n * Whether the main list shows an official optional bundle: any bundle outside `MORE_BUNDLES`, and any held-back one the profile enabled.\n * @param pkg - the official bundle as the Host reports it.\n * @returns whether the main list shows it.\n */\nfunction pinnedToMainList(pkg: PackageView): boolean {\n  return !MORE_BUNDLES.includes(pkg.name) || pkg.enabled\n}\n\n/**\n * Where an optional bundle sits on both lists: the `EXTENSION_BUNDLES` in their order, then the bundles neither list\n * ranks, then the held-back ones in theirs, so Codex and Claude Code stay last on the More list.\n * @param name - the bundle's package name.\n * @returns the rank; bundles of equal rank keep the order the Host reported.\n */\nfunction optionalBundleRank(name: string): number {\n  const ranked = EXTENSION_BUNDLES.indexOf(name)\n  if (ranked >= 0) return ranked\n  const heldBack = MORE_BUNDLES.indexOf(name)\n  return heldBack < 0 ? EXTENSION_BUNDLES.length : EXTENSION_BUNDLES.length + 1 + heldBack\n}\n\n/**\n * Order the official optional bundles as both lists show them, so a bundle the profile picks from the More list\n * keeps its place among the neighbours the main list already holds.\n * @param packages - the official bundles the Host offers.\n * @returns the bundles in display order.\n */\nfunction orderOptionalBundles(packages: readonly PackageView[]): PackageView[] {\n  return [...packages].sort((a, b) => optionalBundleRank(a.name) - optionalBundleRank(b.name))\n}\n\n/** How long a toast holds: long enough to read a failure that names what broke. */\nfunction toastHoldMs(text: string): number {\n  return Math.min(8_000, Math.max(3_000, text.length * 80))\n}\n\nconst PHASE_KEYS = {\n  pending: 'rowPhasePending',\n  loading: 'rowPhaseLoading',\n  active: 'rowPhaseActive',\n  failed: 'rowPhaseFailed',\n  unloading: 'rowPhaseUnloading',\n} satisfies Record<RowPhase, PluginManagerLocaleKey>\n\n/** Status dot naming a root-fiber phase; loading and unloading are live transitions. */\nconst PHASE_STATES = {\n  pending: 'idle',\n  loading: 'ongoing',\n  active: 'done',\n  failed: 'error',\n  unloading: 'ongoing',\n} satisfies Record<RowPhase, StateDotState>\n\n/** The count line over a pack's components: the total, then only the states that occur. */\nfunction partsSummary(rows: readonly PackageRow[], t: Translate): string {\n  const failed = rows.filter(row => row.phase === 'failed').length\n  const off = rows.filter(row => !row.enabled).length\n  const running = rows.filter(row => row.enabled && row.phase === 'active').length\n  return [\n    t('partsCountTotal', { count: String(rows.length) }),\n    ...running > 0 ? [t('partsCountRunning', { count: String(running) })] : [],\n    ...off > 0 ? [t('partsCountOff', { count: String(off) })] : [],\n    ...failed > 0 ? [t('partsCountFailed', { count: String(failed) })] : [],\n  ].join(' · ')\n}\n\n/** Switching for a pack's rows: which rows have a write in flight, and the write. */\ninterface RowToggles {\n  readonly busy: (row: PackageRow) => boolean\n  readonly onSetEnabled: (row: PackageRow, enabled: boolean) => void\n}\n\n/** Configuration for a pack's rows: which rows registered a page of their own, and opening it. */\ninterface RowConfigure {\n  readonly has: (row: PackageRow) => boolean\n  readonly open: (row: PackageRow) => void\n}\n\n/** Rows beyond this count get a filter box above the list. */\nconst ROW_FILTER_THRESHOLD = 10\n\n/** The size the 36-viewBox plugin artwork renders at inside a card's 48px frame. */\nconst CARD_ARTWORK_SIZE = 36\n\n/** The size the artwork renders at inside a row's 40px frame. */\nconst ROW_ARTWORK_SIZE = 30\n\n/** The artwork of the official plugins that registered their configuration, by registration id. */\nconst ITEM_ARTWORK = new Map<string, (props: IconProps) => ReactNode>([\n  ['shell', PluginArtworkTerminal],\n  ['agent-loop', PluginArtworkLoop],\n  ['subagent', PluginArtworkSubagent],\n  ['web-search', PluginArtworkSearch],\n])\n\n/** An official plugin's card and page artwork; plugins without their own get the default. */\nfunction itemArtwork(id: string): ReactNode {\n  const Artwork = ITEM_ARTWORK.get(id) ?? PluginArtworkDefault\n  return <Artwork size={CARD_ARTWORK_SIZE} />\n}\n\n/** Manifest images remain isolated from the page DOM; a failed decode keeps the position's default artwork. */\nfunction PackageArtwork({ src, row = false, size = row ? ROW_ARTWORK_SIZE : CARD_ARTWORK_SIZE }: {\n  readonly src: string | undefined\n  readonly row?: boolean\n  readonly size?: number\n}): ReactNode {\n  const [failedSource, setFailedSource] = useState<string>()\n  const Fallback = row ? PluginArtworkSubagent : PluginArtworkDefault\n  return src === undefined || src === failedSource\n    ? <Fallback size={size} />\n    : <img className={css.packageImage} src={src} width={size} height={size} alt=\"\" onError={() => { setFailedSource(src) }} />\n}\n\n/** A row's switch: locked, saying why, when the Host refuses to address the row through the profile patch. */\nfunction RowSwitch({ row, title, t, busy, onChange }: {\n  readonly row: PackageRow\n  readonly title: string\n  readonly t: Translate\n  readonly busy: boolean\n  readonly onChange: (enabled: boolean) => void\n}): ReactNode {\n  const locked = row.readOnlyReason !== undefined || row.entryId === undefined\n  return (\n    <Switch\n      checked={row.enabled}\n      label={t('partToggle', { name: title })}\n      disabled={busy || locked}\n      {...row.readOnlyReason === undefined ? {} : { title: managementText({ code: row.readOnlyReason }, t) }}\n      onChange={onChange}\n    />\n  )\n}\n\n/** What a row's state line says: off, or the phase its fiber is in. */\nfunction rowStateText(row: PackageRow, t: Translate): string {\n  if (!row.enabled) return t('partOff')\n  return row.phase === null ? t('rowStateIdle') : t(PHASE_KEYS[row.phase])\n}\n\n/** The dot beside a row: its fiber phase, or idle. */\nfunction rowDotState(row: PackageRow): StateDotState {\n  if (!row.enabled || row.phase === null) return 'idle'\n  return PHASE_STATES[row.phase]\n}\n\n/** A Host metadata diagnostic does not change the package's management permissions. */\nfunction MetadataError({ error, t }: { readonly error: string | undefined; readonly t: Translate }): ReactNode {\n  return error === undefined ? null : <p className={css.reason} role=\"status\" data-package-meta-error>{t('metadataError', { error })}</p>\n}\n\n/** A failed component keeps its current Host diagnostic beside its controls. */\nfunction RuntimeError({ error, t }: { readonly error: string | undefined; readonly t: Translate }): ReactNode {\n  return error === undefined ? null : <p className={css.reason} role=\"status\" data-plugin-runtime-error>{t('reasonLabel')}: {error}</p>\n}\n\n/**\n * A pack's rows as a list in the order the pack declares them: a state dot,\n * the row id, one line saying its state, a configure control for a row that\n * registered a page, and, when the pack is on, a switch. A pack like base\n * carries close to a hundred rows, so a long list gets a filter.\n */\nfunction RowsSection({ rows, t, resolveText, toggle, configure }: {\n  readonly rows: readonly PackageRow[]\n  readonly t: Translate\n  readonly resolveText: ResolveText\n  readonly toggle?: RowToggles | undefined\n  readonly configure?: RowConfigure | undefined\n}): ReactNode {\n  const [filter, setFilter] = useState('')\n  const query = filter.trim().toLowerCase()\n  const localized = rows.map(row => ({ row, ...rowText(row, resolveText) }))\n  const shown = query === '' ? localized : localized.filter(({ row, title, description }) =>\n    [title, description, row.rowId, row.moduleName].some(value => value?.toLowerCase().includes(query)))\n  return (\n    <section className={css.detailSection} data-plugin-rows>\n      <div className={css.sectionHead}>\n        <h4 className={css.sectionTitle}>{t('partsLabel')}</h4>\n        {rows.length === 0 ? null : <span className={css.sectionCount}>{partsSummary(rows, t)}</span>}\n      </div>\n      {rows.length === 0 ? <p className={css.status}>{t('partsEmpty')}</p> : null}\n      {rows.length > ROW_FILTER_THRESHOLD\n        ? (\n          <Input\n            type=\"search\"\n            className={css.partsFilter as string}\n            placeholder={t('partsFilter')}\n            aria-label={t('partsFilter')}\n            value={filter}\n            onChange={(event) => { setFilter(event.target.value) }}\n          />\n        )\n        : null}\n      {rows.length > 0 && shown.length === 0 ? <p className={css.status}>{t('partsFilterEmpty')}</p> : null}\n      {shown.length === 0\n        ? null\n        : (\n          <ul className={css.rows}>\n            {shown.map(({ row, title, description }) => (\n              <li\n                key={row.rowId}\n                className={css.row}\n                data-plugin-row={row.entryId ?? row.rowId}\n                {...row.phase === 'failed' ? { 'data-state': 'failed' } : row.enabled ? {} : { 'data-state': 'off' }}\n              >\n                <div className={css.rowLine}>\n                  <span className={css.rowIcon} aria-hidden=\"true\"><PackageArtwork key={row.meta?.icon} src={row.meta?.icon} row /></span>\n                  <div className={css.rowMain}>\n                    {configure?.has(row) === true\n                      ? (\n                        <button type=\"button\" className={css.rowOpen} aria-label={t('configureRow', { name: title })} onClick={() => { configure.open(row) }}>\n                          <span className={css.rowId