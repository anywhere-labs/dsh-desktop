dispose(); await unmount() }\n}\n\nfunction registerBody(ctx: Context): void {\n  const services: PluginCardServices = {\n    // Catalog text by plugin name for this plugin lifetime: a revisited card renders it before its own lookup returns.\n    catalog: createSnapshotStore<Readonly<Record<string, CatalogDetails>>>({}),\n    describe: async (sessionId, callId) => {\n      const result = await ctx.remote.pluginRecommendations.describe(sessionId, callId)\n      return result.ok ? result.value : undefined\n    },\n    openDetails: (packageName) => { ctx.pluginNavigation.openBundle(packageName) },\n    resolveText: text => ctx.locale.resolveText(text),\n  }\n  ctx.effect(() => ctx.locale.register('pluginRecommendations', { en, zh, ja, es, fr, de, ru, pt }), 'plugin-recommendations: locale')\n  ctx.effect(() => ctx.actionCards.register({\n    action: 'enable_official_plugin', locale: 'pluginRecommendations',\n    Body: props => createElement(PluginCardBody, { ...props, ...services }),\n  }), 'plugin-recommendations: card body')\n}\n","/** Bind the generated Remote contribution to the source-tested browser lifecycle. */\nimport type { Context } from '@deepseek-ai/cordis'\nimport remote from '@deepseek-ai/dsh-plugin-recommendations/remote'\nimport { mountRecommendations } from './mount.ts'\nexport { inject } from './mount.ts'\n\n/** Mount recommendation UI and its optional Remote.\n * @param ctx - Client plugin context.\n * @returns disposer for both contributions.\n */\nexport async function apply(ctx: Context): Promise<() => Promise<void>> {\n  return await mountRecommendations(ctx, remote)\n}\n"],"mappings":";weA2BA,SAAgB,uBAAuB,KAAwB,IAAiC,CAC9F,OAAO,IAAI,WAAW,KAAM,GAAG,CACjC,CAEA,IAAM,WAAN,KAA6C,CAGd,KAAyC,IAFtE,MAEA,YAAY,KAAyC,IAAgC,CAAxD,KAAA,KAAA,KAAyC,KAAA,IAAA,GAAgB,CAEtF,IAAI,SAAkB,CAAE,OAAO,KAAK,KAAK,OAAQ,CACjD,IAAI,aAA+C,CAAE,OAAO,KAAK,QAAQ,CAAC,CAAC,WAAY,CACvF,IAAI,SAAuC,CAAE,OAAO,KAAK,QAAQ,CAAC,CAAC,OAAQ,CAE3E,SAAyB,CACvB,GAAI,KAAK,QAAU,IAAA,GAAW,OAAO,KAAK,