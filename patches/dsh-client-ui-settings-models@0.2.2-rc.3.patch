-{"version":3,"file":"client.js","names":["valueMap"],"sources":["../../../packages/client/ui-settings-models/src/client/apiKey.ts","../../../packages/client/ui-settings-models/src/client/ApiKeyInput.tsx","../../../packages/client/ui-settings-models/src/client/EditorFooter.tsx","../../../packages/client/ui-settings-models/src/client/ModelInputTypes.tsx","../../../packages/client/ui-settings-models/src/client/ModelReasoningEfforts.tsx","../../../packages/client/ui-settings-models/src/client/ModelRow.tsx","../../../packages/client/ui-settings-models/src/client/useModelRows.ts","../../../packages/client/ui-settings-models/src/client/DeepSeekModelsEditor.tsx","../../../packages/client/ui-settings-models/src/client/ModelListEditor.tsx","../../../packages/client/ui-settings-models/src/client/store.ts","../../../packages/client/ui-settings-models/src/client/protocol-label.ts","../../../packages/client/ui-settings-models/src/client/protocol-rules.ts","../../../packages/client/ui-settings-models/src/client/CustomProviderCard.tsx","../../../packages/client/ui-settings-models/src/client/RetryPolicyEditor.tsx","../../../packages/client/ui-settings-models/src/client/ProviderEditor.tsx","../../../packages/client/ui-settings-models/src/client/ModelsSection.tsx","../../../packages/client/ui-settings-models/src/client/OnboardingModal.tsx","../../../packages/client/ui-settings-models/src/client/DeepSeekOnboardingDialog.tsx","../../../packages/client/ui-settings-models/src/client/WelcomeNotice.tsx","../../../packages/client/ui-settings-models/src/onboarding-copy.ts","../../../packages/client/ui-settings-models/src/client/welcome-store.ts","../../../packages/client/ui-settings-models/src/client/operations.ts","../../../packages/client/ui-settings-models/src/client/schema-operations.ts","../../../packages/client/ui-settings-models/src/client/locales.ts","../../../../vendor/cosmokit/src/misc.ts","../../../../vendor/cosmokit/src/volatile.ts","../../../../vendor/cosmokit/src/types.ts","../../../../vendor/cosmokit/src/time.ts","../../../../vendor/schemastery/src/index.ts","../../../packages/client/ui-settings-models/src/onboarding-config.ts","../../../packages/client/ui-settings-models/src/client/index.ts"],"sourcesContent":["/**\n * Browser-side judgement of a typed API key.\n * @module @deepseek-ai/dsh-client-ui-settings-models/apiKey\n */\n\n/**\n * Twin of `normalizeApiKey` in `@deepseek-ai/dsh-llm`: printable ASCII, space\n * excluded. Client packages reference only client packages, so the charset\n * rule is mirrored here rather than imported; keep the two in step, as\n * `validateDeepSeekModels` is kept in step with the host's `catalogModel`.\n */\nconst LEGAL_API_KEY = /^[\\x21-\\x7E]+$/\n\n/**\n * A pasted `NAME=value` environment line. Two narrowings keep real keys clear\n * of it: the name must be upper-case, so `sk-` forms break at the hyphen, and\n * the `=` must be followed by something other than another `=`, so base64\n * padding on an all-upper-case key (`ABCD==`) is not mistaken for an\n * assignment. This heuristic runs only here — a resolver applying it could\n * lock a user out of a gateway whose key legitimately takes this shape, with\n * the environment refusing it too and no way through.\n */\nconst ENV_LINE = /^[A-Z][A-Z0-9_]*=[^=]/\n\n/**\n * Copy key naming why a typed key cannot be saved. A wrapped paste reports the\n * same format failure as an illegal character: the reader's next move is the\n * same either way — look at the key and paste it again — so naming the two\n * causes apart would spend the field's one line on a distinction that changes\n * nothing about what to do.\n */\nexport type ApiKeyFailureKey = 'keyBlank' | 'keyIllegalCharacters'\n\n/** Whether a value is wrapped in one matching pair of quotes. */\nfunction isQuoted(value: string): boolean {\n  const first = value[0]\n  if (first !== '\"' && first !== '\\'' && first !== '`') return false\n  return value.length > 1 && value.endsWith(first)\n}\n\n/**\n * Judge the key input's current value.\n *\n * An empty field is not a failure: every card opens with it empty even when a\n * key is already stored, where it means keep that one. A field holding only\n * whitespace is a failure rather than an empty field, so typed input is never\n * silently discarded.\n * @param draft - the key input's current value, untrimmed.\n * @returns the copy key for a field-level failure, or `undefined` to allow submit.\n */\nexport function apiKeyFailure(draft: string): ApiKeyFailureKey | undefined {\n  if (draft.length === 0) return undefined\n  const value = draft.trim()\n  if (value.length === 0) return 'keyBlank'\n  if (ENV_LINE.test(value) || isQuoted(value)) return 'keyIllegalCharacters'\n  if (!LEGAL_API_KEY.test(value)) return 'keyIllegalCharacters'\n  return undefined\n}\n","/** Credential drafts can be revealed; saved keys are represented by a protected mask. */\nimport { useState } from 'react'\nimport type { InputHTMLAttributes, ReactNode } from 'react'\nimport type { en } from './locales.ts'\nimport styles from './ModelsSection.module.css'\n\nconst EYE_CONTOUR = 'M1.5 8C2.9 5.25 5.25 3.5 8 3.5C10.75 3.5 13.1 5.25 14.5 8C13.1 10.75 10.75 12.5 8 12.5C5.25 12.5 2.9 10.75 1.5 8Z'\nconst EYE_PATH = `${EYE_CONTOUR}M10 8C10 9.1 9.1 10 8 10C6.9 10 6 9.1 6 8C6 6.9 6.9 6 8 6C9.1 6 10 6.9 10 8Z`\nconst EYE_OFF_PATH = `${EYE_CONTOUR}M2.5 2.5L13.5 13.5`\n\n/** Input attributes and section copy for the current credential draft. */\ninterface ApiKeyInputProps extends Omit<InputHTMLAttributes<HTMLInputElement>, 'value' | 'type' | 'className' | 'autoComplete'> {\n  /** Unsaved input; stored credentials are never read into this field. */\n  readonly value: string\n  /** Server-masked preview and actions; the full stored credential stays on the Host. */\n  readonly saved?: {\n    readonly masked: string\n    readonly clear?: () => void\n  }\n  /** Section copy, including the same reveal labels as SecretText. */\n  readonly t: (key: keyof typeof en) => string\n}\n\n/**\n * Reveal only a nonempty draft. Saved keys allow whole replacement or deletion.\n * @param props - current draft, input attributes, and translated control labels.\n * @returns a password input with an optional reveal button.\n */\nexport function ApiKeyInput({ value, saved, t, ...props }: ApiKeyInputProps): ReactNode {\n  const [revealedValue, setRevealedValue] = useState<string | undefined>()\n  const canReveal = saved === undefined && value.length > 0 && props.disabled !== true\n  const revealed = canReveal && revealedValue === value\n  return (\n    <div className={`${styles['keyInput']} ${saved === undefined ? '' : styles['savedKeyInput']}`}>\n      <input\n        {...props}\n        className={`${styles['input']} ${canReveal ? styles['keyInputFilled'] : ''}`}\n        type={revealed ? 'text' : 'password'}\n        autoComplete=\"new-password\"\n        value={value}\n        placeholder={saved === undefined ? props.placeholder : saved.masked}\n        onCopy={(event) => { if (saved !== undefined) event.preventDefault() }}\n        onCut={(event) => { if (saved !== undefined) event.preventDefault() }}\n        onKeyDown={(event) => {\n          if (saved !== undefined && (event.key === 'Backspace' || event.key === 'Delete')) {\n            event.preventDefault()\n            saved.clear?.()\n          }\n        }}\n        onChange={(event) => {\n          setRevealedValue(undefined)\n          props.onChange?.(event)\n        }}\n      />\n      {!canReveal ? null : <button\n        type=\"button\"\n        className={styles['keyToggle']}\n        aria-label={t(revealed ? 'keyHide' : 'keyReveal')}\n        aria-pressed={revealed}\n        onClick={() => { setRevealedValue(revealed ? undefined : value) }}\n      >\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" strokeWidth={1.3} strokeLinecap=\"round\" aria-hidden=\"true\">\n          <path d={revealed ? EYE_OFF_PATH : EYE_PATH} />\n        </svg>\n      </button>}\n    </div>\n  )\n}\n","/**\n * The action row every provider card ends with: dismiss on the left, commit on\n * the right.\n *\n * The two cards commit different things — one creates a route, one edits an\n * existing profile — but the row itself carries no such knowledge. It renders\n * what it is handed, so the cards keep sole ownership of when a commit is\n * allowed and what the in-flight wording is.\n *\n * Cancel refuses input only while a commit is in flight, never because the card\n * is disabled: a card the deployment cannot write to must still be dismissable.\n *\n * @module dsh-client-ui-settings-models/client/EditorFooter\n */\n\nimport type { ReactNode } from 'react'\nimport type { en } from './locales.ts'\nimport styles from './ModelsSection.module.css'\n\n/** Props of {@link EditorFooter}. */\nexport interface EditorFooterProps {\n  /** Localizer for the row's own labels. */\n  t: (key: keyof typeof en) => string\n  /** Whether a commit is in flight; holds Cancel and swaps the commit label. */\n  busy: boolean\n  /** Whether the commit is refused, as judged by the owning card. */\n  submitDisabled: boolean\n  /** Commit label while idle. */\n  submitLabelKey: keyof typeof en\n  /** Commit label while a commit is in flight. */\n  submitBusyLabelKey: keyof typeof en\n  /** Dismiss label; defaults to the settings editor copy. */\n  cancelLabelKey?: keyof typeof en\n  /** Dismiss the card without committing. */\n  onCancel: () => void\n  /** Run the card's commit. */\n  onSubmit: () => void\n}\n\n/**\n * Render one provider card's action row.\n * @param props - the labels, commit gating, and handlers the owning card supplies.\n * @returns the cancel/commit row.\n */\nexport function EditorFooter(props: EditorFooterProps): ReactNode {\n  const { t } = props\n  return (\n    <div className={styles['editorActions']}>\n      <button\n        type=\"button\"\n        className={styles['secondaryButton']}\n        disabled={props.busy}\n        onClick={props.onCancel}\n      >\n        {t(props.cancelLabelKey ?? 'cancel')}\n      </button>\n      <button\n        type=\"button\"\n        className={styles['primaryButton']}\n        disabled={props.submitDisabled}\n        onClick={props.onSubmit}\n      >\n        {props.busy ? t(props.submitBusyLabelKey) : t(props.submitLabelKey)}\n      </button>\n    </div>\n  )\n}\n","/** Input-type declarations shared by the DeepSeek and pi-ai catalog editors. */\n\nimport type { ReactNode } from 'react'\nimport { Checkbox } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { DeepSeekModelDraft } from './DeepSeekModelsEditor.tsx'\nimport type { ModelsKey } from './locales.ts'\nimport styles from './ModelsSection.module.css'\n\n/** Props of {@link ModelInputTypes}. */\ninterface ModelInputTypesProps {\n  /** Effective model row, including fields outside the curated editor. */\n  model: DeepSeekModelDraft\n  /** Adapter-owned field; pi-ai inherits capabilities when absent or empty. */\n  field: 'inputModalities' | 'input'\n  /** One-based row position for the accessible group label. */\n  position: number\n  /** Prevent changes while read-only or saving. */\n  disabled: boolean\n  /** Installed model or provider defaults when the row does not declare input types. */\n  fallback?: readonly string[] | undefined\n  /** Section copy. */\n  t: (key: ModelsKey) => string\n  /** Replace this row, preserving unrelated configuration. */\n  onChange: (model: DeepSeekModelDraft) => void\n}\n\n/**\n * Edit a nonempty set of input types, displaying inherited types before an override exists.\n * @param props - model declaration and row replacement action.\n * @returns the labeled text and image checkboxes.\n */\nexport function ModelInputTypes({ model, field, position, disabled, fallback, t, onChange }: ModelInputTypesProps): ReactNode {\n  const modalities = model[field]\n  const selected = Array.isArray(modalities) && modalities.length > 0 ? modalities : fallback ?? ['text']\n  return (\n    <fieldset className={styles['modelInputTypes']} aria-label={`${t('modelInputTypes')} ${String(position)}`}>\n      <legend className={styles['modelFieldLabel']}>{t('modelInputTypes')}</legend>\n      <div className={styles['modelInputChoices']}>\n        {(['text', 'image'] as const).map(modality => (\n          <Checkbox\n            key={modality}\n            label={t(modality === 'text' ? 'modelInputText' : 'modelInputImage')}\n            checked={selected.includes(modality)}\n            disabled={disabled || (selected.length === 1 && selected.includes(modality))}\n            onChange={(checked) => {\n              const nextSelected = (['text', 'image'] as const).filter(value =>\n                value === modality ? checked : selected.includes(value))\n              const next = { ...model, [field]: nextSelected }\n              // DeepSeek rejects image request limits on a text-only model.\n              if (field === 'inputModalities' && !nextSelected.includes('image')) {\n                Reflect.deleteProperty(next, 'imagePixelBudget')\n                Reflect.deleteProperty(next, 'imageMaxBytes')\n              }\n              onChange(next)\n            }}\n          />\n        ))}\n      </div>\n    </fieldset>\n  )\n}\n","/** Reasoning-level declarations for a model on a hand-declared pi-ai route. */\n\nimport { useState } from 'react'\nimport type { ReactNode } from 'react'\nimport { IconPlusOutlineRegular, IconTrashOutlineRegular, Switch, Tooltip } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { DeepSeekModelDraft } from './DeepSeekModelsEditor.tsx'\nimport { modelDrafts } from './DeepSeekModelsEditor.tsx'\nimport type { ModelsKey } from './locales.ts'\nimport styles from './ModelsSection.module.css'\n\n/** Declared levels in stored order, each with the value stored for it, whatever a hand edit left there. */\ntype Entries = readonly (readonly [string, unknown])[]\n\n/** Levels a model offers when the switch is turned on, where the schema lists them: Off plus the common OpenAI-compatible trio. */\nconst INITIAL_LEVELS: readonly string[] = ['off', 'low', 'medium', 'high']\n\n/** The wire value a level sends unless its row says otherwise; `null` is the Off entry that sends nothing. */\nfunction defaultValue(level: string): string | null {\n  return level === 'off' ? null : level\n}\n\n/**\n * Whether pi-ai accepts a stored value: a non-empty string, or nothing for Off.\n * @param level - the declared level.\n * @param wire - the value stored for it.\n * @returns whether the adapter would resolve the entry.\n */\nfunction acceptedValue(level: string, wire: unknown): boolean {\n  return typeof wire === 'string' ? wire.length > 0 : wire === null && level === 'off'\n}\n\n/**\n * Read the declared levels from a row in their stored order, including a key\n * the offered levels do not name, so an edit never drops it.\n * @param model - model row as drafted.\n * @returns the entries; empty for a valueless field, which pi-ai refuses, and\n * `undefined` when the field is absent or `false`.\n */\nfunction readEfforts(model: DeepSeekModelDraft): Entries | undefined {\n  const value = model['reasoningEfforts']\n  if (value === null) return []\n  if (typeof value !== 'object' || Array.isArray(value)) return undefined\n  return Object.entries(value)\n}\n\n/**\n * Replace a row's declared levels, preserving every other field.\n * @param model - model row as drafted.\n * @param entries - the levels to write in row order, or `undefined` to remove the field.\n * @returns the replacement row.\n */\nfunction withEfforts(model: DeepSeekModelDraft, entries: Entries | undefined): DeepSeekModelDraft {\n  const next = { ...model }\n  if (entries === undefined) {\n    // Absent is how a hand-declared model says it does not reason.\n    Reflect.deleteProperty(next, 'reasoningEfforts')\n    return next\n  }\n  next['reasoningEfforts'] = Object.fromEntries(entries)\n  return next\n}\n\n/** A reasoning-level failure the Models cards name by row. */\nexport interface ReasoningEffortsFailure {\n  /** Zero-based model position. */\n  index: number\n  /** Message key owned by the Models settings section. */\n  key: 'modelReasoningValueRequired' | 'modelReasoningNeedsLevel' | 'modelReasoningLevelsOnly'\n}\n\n/**\n * Whether an entry breaks a protocol that accepts only its offered levels,\n * each sent under its own name.\n * @param only - the accepted levels.\n * @param level - the declared level.\n * @param wire - the value stored for it.\n * @returns whether the entry is outside the accepted levels.\n */\nfunction outsideLevels(only: readonly string[], level: string, wire: unknown): boolean {\n  return !only.includes(level) || wire !== level\n}\n\n/**\n * Mirror the pi-ai refusals of a hand-declared `reasoningEfforts`, so a card\n * names the row instead of failing at the write.\n * @param value - drafted `models` value, or `undefined` while inherited.\n * @param only - the levels the route's protocol accepts, each sent under its\n * own name, or `undefined` when the protocol accepts any declared value.\n * @returns the first refused row, or `undefined` when the adapter will accept every row.\n */\nexport function validateReasoningEfforts(value: unknown, only?: readonly string[]): ReasoningEffortsFailure | undefined {\n  for (const [index, model] of modelDrafts(value).entries()) {\n    const entries = readEfforts(model)\n    if (entries === undefined) continue\n    if (only !== undefined && entries.some(([level, wire]) => outsideLevels(only, level, wire))) {\n      return { index, key: 'modelReasoningLevelsOnly' }\n    }\n    if (entries.some(([level, wire]) => !acceptedValue(level, wire))) return { index, key: 'modelReasoningValueRequired' }\n    if (!entries.some(([level]) => level !== 'off')) return { index, key: 'modelReasoningNeedsLevel' }\n  }\n  return undefined\n}\n\n/** Props of {@link ModelReasoningEfforts}. */\ninterface ModelReasoningEffortsProps {\n  /** Effective model row, including fields outside the curated editor. */\n  model: DeepSeekModelDraft\n  /** Levels the adapter's schema accepts as `reasoningEfforts` keys, in escalation order. */\n  levels: readonly string[]\n  /** Whether the route's protocol accepts only {@link levels}, each sent under its own name. */\n  levelsOnly: boolean\n  /** One-based row position for accessible names. */\n  position: number\n  /** Prevent changes while read-only or saving. */\n  disabled: boolean\n  /** Section copy. */\n  t: (key: ModelsKey) => string\n  /** Replace this row, preserving unrelated configuration. */\n  onChange: (model: DeepSeekModelDraft) => void\n}\n\n/**\n * Edit the `reasoningEfforts` a hand-declared pi-ai model offers: a switch,\n * then one row per level pairing the level with the value sent for it. Every\n * row is read from the model, so a reused instance shows its new model.\n * @param props - model declaration and row replacement action.\n * @returns the reasoning-level group.\n */\nexport function ModelReasoningEfforts(props: ModelReasoningEffortsProps): ReactNode {\n  const { model, levels, levelsOnly, position, disabled, t, onChange } = props\n  const entries = readEfforts(model)\n  // Only the focused field keeps its own text, so a field cleared while typing\n  // stays empty although its level's name is stored. Leaving the field drops\n  // it, and deleting a model, resetting the list, or folding these options all\n  // move focus first, so no text outlives the field it was typed into.\n  const [typing, setTyping] = useState<{ level: string; text: string } | undefined>(undefined)\n  const label = `${t('modelReasoning')} ${String(position)}`\n  const used = entries?.map(([level]) => level) ?? []\n\n  const write = (next: Entries | undefined): void => { onChange(withEfforts(model, next)) }\n  const replaceAt = (current: Entries, index: number, entry: readonly [string, unknown]): Entries =>\n    current.map((existing, at) => at === index ? entry : existing)\n\n  const changeLevel = (current: Entries, index: number, from: string, wire: unknown, to: string): void => {\n    // Only a custom spelling between two thinking levels carries over; a value\n    // still spelled as its old level, or one crossing to or from Off, resets.\n    // A protocol accepting only its offered levels sends each under its own name, so nothing carries.\n    const carried = !levelsOnly && typeof wire === 'string' && wire.length > 0 && wire !== from && from !== 'off' && to !== 'off'\n    write(replaceAt(current, index, [to, carried ? wire : defaultValue(to)]))\n  }\n\n  const addLevel = (current: Entries): void => {\n    const highest = Math.max(-1, ...used.map(level => levels.indexOf(level)))\n    const level = levels.find((candidate, index) => index > highest && !used.includes(candidate))\n      ?? levels.find(candidate => !used.includes(candidate))\n    /* v8 ignore next -- the add button is disabled once every level has a row */\n    if (level === undefined) return\n    write([...current, [level, defaultValue(level)]])\n  }\n\n  const editValue = (current: Entries, index: number, level: string, text: string): void => {\n    setTyping({ level, text })\n    const trimmed = text.trim()\n    write(replaceAt(current, index, [level, trimmed.length === 0 ? defaultValue(level) : trimmed]))\n  }\n\n  const leaveValue = (current: Entries, index: number, level: string, wire: unknown): void => {\n    setTyping(undefined)\n    // Leaving a field whose stored value the adapter refuses repairs it with the level name.\n    if (!acceptedValue(level, wire)) write(replaceAt(current, index, [level, defaultValue(level)]))\n  }\n\n  // A stored key the offered levels do not name stays selectable in its own row.\n  const choicesFor = (level: string): readonly string[] => [\n    ...levels.includes(level) ? [] : [level],\n    ...levels.filter(choice => choice === level || !used.includes(choice)),\n  ]\n  const initialEntries = INITIAL_LEVELS.filter(level => levels.includes(level)).map(level => [level, defaultValue(level)] as const)\n\n  const refused = entries?.some(([level, wire]) => !acceptedValue(level, wire)) === true\n  const missingLevel = entries !== undefined && !used.some(level => level !== 'off')\n  const outside = levelsOnly && entries?.some(([level, wire]) => outsideLevels(levels, level, wire)) === true\n\n  return (\n    <div className={styles['modelReasoning']} role=\"group\" aria-label={label}>\n      <div className={styles['modelReasoningHead']}>\n        <span className={`${styles['modelFieldLabel']} ${styles['modelReasoningLabel']}`}>\n          {t('modelReasoning')}\n          <Tooltip label={t('modelReasoningHelpText')} side=\"right\" delayMs={0} focusDelayMs={0} portal openOnClick>\n            <button type=\"button\" className={styles['helpButton']} aria-label={t('modelReasoningHelp')}>?</button>\n          </Tooltip>\n        </span>\n        <Switch\n          checked={entries !== undefined}\n          label={label}\n          disabled={disabled}\n          onChange={(on) => { write(on ? initialEntries : undefined) }}\n        />\n      </div>\n      {entries === undefined\n        ? null\n        : (\n          <>\n            {entries.length > 0\n              ? (\n                <div className={styles['modelReasoningRow']} aria-hidden=\"true\">\n                  <span className={styles['modelFieldLabel']}>{t('modelReasoningLevel')}</span>\n                  <span className={styles['modelFieldLabel']}>{t('modelReasoningValue')}</span>\n                </div>\n              )\n              : null}\n            {entries.map(([level, wire], index) => (\n              // A row is the entry at this position of the stored dict: changing its\n              // level edits that entry in place and rows keep no state of their own,\n              // so the position is the row's identity. Keying by level would remount\n              // the select on every change and drop keyboard focus.\n              <div key={index} className={styles['modelReasoningRow']}>\n                <select\n                  className={`${styles['input']} ${styles['selectInput']}`}\n                  value={level}\n                  aria-label={`${t('modelReasoningLevel')} ${String(index + 1)}`}\n                  disabled={disabled}\n                  onChange={(event) => { changeLevel(entries, index, level, wire, event.target.value) }}\n                >\n                  {choicesFor(level).map(choice => (\n                    <option key={choice} value={choice}>{choice}</option>\n                  ))}\n                </select>\n                <input\n                  className={`${styles['input']} ${styles['modelReasoningValueInput']}`}\n                  type=\"text\"\n                  value={typing?.level === level ? typing.text : typeof wire === 'string' ? wire : ''}\n                  placeholder={level === 'off' ? t('modelReasoningOffValuePlaceholder') : level}\n                  aria-label={`${level} ${t('modelReasoningValue')}`}\n                  aria-invalid={!acceptedValue(level, wire)}\n                  // Off only turns reasoning off; a value stored in cordis.patch.yml is shown and kept.\n                  // A protocol accepting only its offered levels sends each under its own name.\n                  disabled={disabled || level === 'off' || levelsOnly}\n                  onChange={(event) => { editValue(entries, index, level, event.target.value) }}\n                  onBlur={() => { leaveValue(entries, index, level, wire) }}\n                />\n                <button\n                  type=\"button\"\n                  className={`${styles['iconButton']} ${styles['iconButtonDanger']}`}\n                  aria-label={`${t('modelReasoningRemove')} ${level}`}\n                  title={t('modelReasoningRemove')}\n                  disabled={disabled}\n                  onClick={() => { write(entries.filter((_entry, at) => at !== index)) }}\n                >\n                  <IconTrashOutlineRegular size={14} />\n                </button>\n              </div>\n            ))}\n            {outside\n              ? <p className={styles['error']}>{t('modelReasoningLevelsOnly')}</p>\n              : refused\n                ? <p className={styles['error']}>{t('modelReasoningValueRequired')}</p>\n                : missingLevel ? <p className={styles['error']}>{t('modelReasoningNeedsLevel')}</p> : null}\n            <button\n              type=\"button\"\n              className={styles['addModelButton']}\n              disabled={disabled || levels.every(level => used.includes(level))}\n              onClick={() => { addLevel(entries) }}\n            >\n              <IconPlusOutlineRegular size={14} />\n              {t('modelReasoningAdd')}\n            </button>\n          </>\n        )}\n    </div>\n  )\n}\n","/** Shared model fields and actions for both adapter catalog editors. */\n\nimport type { DragEvent, ReactNode } from 'react'\nimport {\n  IconChevronDownOutlineRegular, IconChevronRightOutlineRegular, IconDragHandleOutlineRegular,\n  IconTrashOutlineRegular, Tooltip, useRowDragPreview,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { DeepSeekModelDraft } from './DeepSeekModelsEditor.tsx'\nimport type { ModelsKey } from './locales.ts'\nimport { ModelInputTypes } from './ModelInputTypes.tsx'\nimport { ModelReasoningEfforts } from './ModelReasoningEfforts.tsx'\nimport type { ModelRowOrder } from './useModelRows.ts'\nimport styles from './ModelsSection.module.css'\n\n/** A capacity's editable text and adapter-specific inherited hint. */\ninterface CapacityInput {\n  value: string\n  placeholder: string\n  onChange: (value: string) => void\n  onBlur?: () => void\n}\n\n/** Adapter-owned data and actions for one model row. */\ninterface ModelRowProps {\n  model: DeepSeekModelDraft\n  rowKey: number\n  position: number\n  order: ModelRowOrder\n  inputField: 'inputModalities' | 'input'\n  inputFallback?: readonly string[] | undefined\n  inputLoading?: boolean\n  /** Levels the row's `reasoningEfforts` may declare; absent or empty shows no reasoning control. */\n  reasoningLevels?: readonly string[] | undefined\n  /** Whether the route's protocol accepts only {@link reasoningLevels}, each sent under its own name. */\n  reasoningLevelsOnly?: boolean | undefined\n  expanded: boolean\n  disabled: boolean\n  t: (key: ModelsKey) => string\n  contextWindow: CapacityInput\n  maxTokens: CapacityInput\n  onFieldChange: (field: 'id' | 'name', value: string | undefined) => void\n  onIdBlur?: (value: string) => void\n  onChange: (model: DeepSeekModelDraft) => void\n  onToggle: () => void\n  onRemove: () => void\n}\n\nfunction rowHalf(event: DragEvent<HTMLElement>): 'before' | 'after' {\n  const rect = event.currentTarget.getBoundingClientRect()\n  return event.clientY < rect.top + rect.height / 2 ? 'before' : 'after'\n}\n\n/**\n * Render model fields with the display name in the expanded area of narrow rows.\n * @param props - drafted fields and their owning editor's actions.\n * @returns one expandable model entry.\n */\nexport function ModelRow(props: ModelRowProps): ReactNode {\n  const { model, position, t, disabled } = props\n  const preview = useRowDragPreview(styles['modelDragPreview'] as string)\n  const modelField = (field: 'id' | 'name') => (\n    <label className={`${styles['modelField']} ${field === 'name' ? styles['modelName'] : ''}`}>\n      {field === 'name'\n        ? <span className={`${styles['modelFieldLabel']} ${styles['modelNameLabel']}`}>{t('modelName')}</span>\n        : null}\n      <input\n        className={styles['input']}\n        type=\"text\"\n        value={typeof model[field] === 'string' ? model[field] : ''}\n        placeholder={t(field === 'id' ? 'modelId' : 'modelName')}\n        aria-label={`${t(field === 'id' ? 'modelId' : 'modelName')} ${String(position)}`}\n        disabled={disabled}\n        onFocus={field === 'name' && !props.expanded ? props.onToggle : undefined}\n        onChange={(event) => {\n          const value = event.target.value\n          props.onFieldChange(field, field === 'name' && value === '' ? undefined : value)\n        }}\n        onBlur={field === 'id' ? event => props.onIdBlur?.(event.target.value) : undefined}\n      />\n    </label>\n  )\n  return (\n    <div\n      className={styles['modelEntry']}\n      data-row-key={props.rowKey}\n      data-dragging={props.order.dragging || undefined}\n      data-drop-target={props.order.dragging ? undefined : props.order.target}\n      onDragOver={(event) => {\n        if (!props.order.canDrop) return\n        event.preventDefault()\n        event.dataTransfer.dropEffect = 'move'\n        props.order.onOver(rowHalf(event))\n      }}\n      onDragLeave={(event) => {\n        if (event.relatedTarget instanceof Node && event.currentTarget.contains(event.relatedTarget)) return\n        props.order.onLeave()\n      }}\n      onDrop={(event) => {\n        if (!props.order.canDrop) return\n        event.preventDefault()\n        props.order.onDrop(rowHalf(event))\n      }}\n    >\n      <div className={styles['modelRow']} data-expanded={props.expanded || undefined}>\n        <Tooltip label={t('reorderModelHelp')} portal>\n          <button\n            type=\"button\"\n            className={`${styles['iconButton']} ${styles['modelDragHandle']}`}\n            aria-label={`${t('reorderModel')} ${String(position)}`}\n            aria-keyshortcuts=\"ArrowUp ArrowDown\"\n            aria-description={t('reorderModelHelp')}\n            disabled={disabled}\n            draggable={!disabled}\n            onDragStart={(event) => {\n              event.dataTransfer.effectAllowed = 'move'\n              event.dataTransfer.setData('application/x-dsh-model-order', String(position))\n              props.order.onStart()\n              preview.start(event, event.currentTarget.closest('[data-row-key]') as HTMLElement)\n            }}\n            onDragEnd={() => { if (preview.clear()) props.order.onEnd() }}\n            onKeyDown={(event) => {\n              if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return\n              event.preventDefault()\n              event.stopPropagation()\n              props.order.onMove(event.key === 'ArrowUp' ? -1 : 1)\n            }}\n          >\n            <IconDragHandleOutlineRegular size={14} />\n          </button>\n        </Tooltip>\n        {modelField('id')}\n        <button\n          type=\"button\"\n          className={styles['iconButton']}\n          aria-label={`${t('modelAdvanced')} ${String(position)}`}\n          aria-expanded={props.expanded}\n          title={t('modelAdvanced')}\n          onClick={(event) => { event.currentTarget.focus(); props.onToggle() }}\n        >\n          {props.expanded ? <IconChevronDownOutlineRegular /> : <IconChevronRightOutlineRegular />}\n        </button>\n        <button\n          type=\"button\"\n          className={`${styles['iconButton']} ${styles['iconButtonDanger']}`}\n          aria-label={`${t('removeModel')} ${String(position)}`}\n          title={t('removeModel')}\n          disabled={disabled}\n          onClick={props.onRemove}\n        >\n          <IconTrashOutlineRegular size={14} />\n        </button>\n        {modelField('name')}\n        {props.expanded\n          ? (\n            <div className={styles['modelAdvanced']}>\n              {(['contextWindow', 'maxTokens'] as const).map(field => (\n                <label className={styles['modelField']} key={field}>\n                  <span className={styles['modelFieldLabel']}>{t(field)}</span>\n                  <input\n                    className={styles['input']}\n                    type=\"text\"\n                    inputMode=\"numeric\"\n                    value={props[field].value}\n                    placeholder={props[field].placeholder}\n                    aria-label={`${t(field)} ${String(position)}`}\n                    disabled={disabled}\n                    onChange={(event) => { props[field].onChange(event.target.value) }}\n                    onBlur={props[field].onBlur}\n                  />\n                </label>\n              ))}\n              <ModelInputTypes\n                model={model} field={props.inputField} position={position}\n                fallback={props.inputFallback} disabled={disabled || props.inputLoading === true} t={t} onChange={props.onChange}\n              />\n              {props.reasoningLevels !== undefined && props.reasoningLevels.length > 0\n                ? (\n                  <ModelReasoningEfforts\n                    model={model} levels={props.reasoningLevels} levelsOnly={props.reasoningLevelsOnly === true}\n                    position={position} disabled={disabled} t={t} onChange={props.onChange}\n                  />\n                )\n                : null}\n            </div>\n          )\n          : null}\n      </div>\n    </div>\n  )\n}\n","/** Local model-row identities, disclosures, capacity text, and draft ordering. */\n\nimport { useRef, useState } from 'react'\nimport type { DeepSeekModelDraft } from './DeepSeekModelsEditor.tsx'\n\n/** Text fields whose unfinished spelling belongs to one draft row. */\nexport type CapacityField = 'contextWindow' | 'maxTokens'\n\ninterface RowState {\n  key: number\n  expanded: boolean\n  editing: Map<CapacityField, string>\n}\n\n/** Drag state and actions for one model row within its editor. */\nexport interface ModelRowOrder {\n  dragging: boolean\n  target: 'before' | 'after' | undefined\n  canDrop: boolean\n  onStart: () => void\n  onEnd: () => void\n  onOver: (half: 'before' | 'after') => void\n  onLeave: () => void\n  onDrop: (half: 'before' | 'after') => void\n  onMove: (offset: -1 | 1) => void\n}\n\ninterface ModelRows {\n  rows: (RowState & { model: DeepSeekModelDraft; order: ModelRowOrder })[]\n  toggle: (index: number) => void\n  edit: (index: number, field: CapacityField, text: string | undefined) => void\n  forget: (removed: ReadonlySet<number>) => void\n  reset: () => void\n}\n\n/** One editor-local identity; editing a model ID never replaces its controls. */\nfunction createRow(key: number): RowState {\n  return { key, expanded: false, editing: new Map() }\n}\n\n/**\n * Keep row state with its model through draft moves and removals.\n * @param models - current draft array, owned by the provider card.\n * @param onChange - replaces only that card's draft array.\n * @param disabled - prevents reordering while the card cannot be edited.\n * @returns row state and local editing and ordering actions.\n */\nexport function useModelRows(\n  models: readonly DeepSeekModelDraft[], onChange: (models: DeepSeekModelDraft[]) => void, disabled: boolean,\n): ModelRows {\n  const nextKey = useRef(0)\n  const [stored, setRows] = useState(() => models.map(() => createRow(nextKey.current++)))\n  const [dragged, setDragged] = useState<number>()\n  const [target, setTarget] = useState<{ key: number; half: 'before' | 'after' }>()\n  const entries = models.map((model, index) => ({ model, state: stored[index] ?? createRow(nextKey.current++) }))\n  const rows = entries.map(entry => entry.state)\n  if (stored.length !== models.length) setRows(rows)\n\n  const endDrag = (): void => { setDragged(undefined); setTarget(undefined) }\n  const move = (from: number, to: number): void => {\n    if (disabled || from === to || from < 0 || to < 0 || to >= models.length) return\n    const order = [...entries]\n    const moved = order.splice(from, 1)\n    order.splice(to, 0, ...moved)\n    setRows(order.map(entry => entry.state))\n    onChange(order.map(entry => entry.model))\n  }\n\n  return {\n    rows: entries.map(({ model, state }, index) => ({\n      ...state,\n      model,\n      order: {\n        dragging: dragged === state.key,\n        target: target?.key === state.key ? target.half : undefined,\n        canDrop: !disabled && dragged !== undefined,\n        onStart: (): void => { setDragged(state.key) },\n        onEnd: endDrag,\n        onOver: (half): void => {\n          setTarget(current => current?.key === state.key && current.half === half ? current : { key: state.key, half })\n        },\n        onLeave: (): void => { setTarget(current => current?.key === state.key ? undefined : current) },\n        onDrop: (half): void => {\n          const from = rows.findIndex(row => row.key === dragged)\n          const insertion = index + (half === 'after' ? 1 : 0)\n          move(from, insertion > from ? insertion - 1 : insertion)\n          endDrag()\n        },\n        onMove: (offset: -1 | 1): void => { move(index, index + offset) },\n      },\n    })),\n    toggle: (index: number): void => {\n      setRows(rows.map((row, at) => at === index ? { ...row, expanded: !row.expanded } : row))\n    },\n    edit: (index: number, field: CapacityField, text: string | undefined): void => {\n      setRows(rows.map((row, at) => {\n        if (at !== index) return row\n        const editing = new Map(row.editing)\n        if (text === undefined) editing.delete(field)\n        else editing.set(field, text)\n        return { ...row, editing }\n      }))\n    },\n    forget: (removed: ReadonlySet<number>): void => {\n      setRows(rows.filter((_row, index) => !removed.has(index)))\n      endDrag()\n    },\n    reset: (): void => { setRows(models.map(() => createRow(nextKey.current++))); endDrag() },\n  }\n}\n","/**\n * Curated editor for the direct DeepSeek adapter's advisory model catalog.\n * The settings layer replaces `models` as one array, so the parent supplies\n * the effective inherited rows until the first edit materializes a user\n * override; reset removes that override instead of copying defaults into it.\n */\n\nimport type { ReactNode } from 'react'\nimport { AnimatedRows, IconPlusOutlineRegular } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { en } from './locales.ts'\nimport { ModelRow } from './ModelRow.tsx'\nimport { useModelRows } from './useModelRows.ts'\nimport type { CapacityField } from './useModelRows.ts'\nimport styles from './ModelsSection.module.css'\n\n/** One catalog entry kept structurally open so hidden or future fields survive an edit. */\nexport type DeepSeekModelDraft = Record<string, unknown>\n\n/** The catalog fields this editor writes. */\ntype CatalogField = 'id' | 'name' | 'contextWindow' | 'maxTokens'\n\n/** Accepted capacity spellings: a decimal count with an optional K/M suffix. */\nconst CAPACITY_PATTERN = /^(\\d+(?:\\.\\d+)?)([km])?$/i\n\n/** Decimal suffix scales — `1M` is 1000K, matching how model capacities are quoted. */\nconst CAPACITY_SCALE = { k: 1_000, m: 1_000_000 } as const\n\n/**\n * Read a typed capacity, so a user can write `256K` or `1M` instead of counting\n * zeroes. The stored value stays a plain token count.\n * @param text - raw field text.\n * @returns the count; `undefined` when blank (inherit), `NaN` when unreadable\n * (rejected by {@link validateDeepSeekModels} before any write).\n */\nexport function parseCapacity(text: string): number | undefined {\n  const trimmed = text.trim()\n  if (trimmed.length === 0) return undefined\n  const match = CAPACITY_PATTERN.exec(trimmed)\n  if (match === null) return Number.NaN\n  const suffix = match[2]?.toLowerCase()\n  const scale = suffix === 'k' || suffix === 'm' ? CAPACITY_SCALE[suffix] : 1\n  const scaled = Number(match[1]) * scale\n  // A decimal multiple is exact in intent but not in binary floating point\n  // (2.3 * 1e6 lands a few ULPs high), so an integral intent snaps back.\n  const rounded = Math.round(scaled)\n  return Math.abs(scaled - rounded) < 1e-6 ? rounded : scaled\n}\n\n/**\n * Spell a stored count back in the shortest form that survives a round trip\n * through {@link parseCapacity}; a count that is not a whole number of\n * thousands stays written out.\n * @param value - stored capacity.\n * @returns the field text.\n */\nexport function formatCapacity(value: number): string {\n  if (!Number.isInteger(value) || value <= 0) return String(value)\n  if (value % CAPACITY_SCALE.m === 0) return `${String(value / CAPACITY_SCALE.m)}M`\n  if (value % CAPACITY_SCALE.k === 0) return `${String(value / CAPACITY_SCALE.k)}K`\n  return String(value)\n}\n\n/** A localized validation failure for one user-owned model array. */\nexport interface DeepSeekModelsValidationFailure {\n  /** Zero-based model position. */\n  index: number\n  /** Message key owned by the Models settings section. */\n  key: 'modelIdRequired' | 'modelIdDuplicate' | 'modelNameInvalid' | 'modelContextInvalid'\n  | 'modelMaxTokensInvalid'\n}\n\n/** Convert a schema-validated catalog value into records without dropping hidden fields. */\nexport function modelDrafts(value: unknown): DeepSeekModelDraft[] {\n  if (!Array.isArray(value)) return []\n  return value.map(entry =>\n    typeof entry === 'object' && entry !== null && !Array.isArray(entry)\n      ? entry as DeepSeekModelDraft\n      : {})\n}\n\n/**\n * Validate adapter constraints that the serialized schema cannot express.\n * @param value - user-owned `models` value, or undefined while inherited.\n * @returns the first invalid row, or undefined when the adapter will accept it.\n */\nexport function validateDeepSeekModels(value: unknown): DeepSeekModelsValidationFailure | undefined {\n  if (value === undefined) return undefined\n  const models = modelDrafts(value)\n  const seen = new Set<string>()\n  for (const [index, model] of models.entries()) {\n    // Compared trimmed: surrounding whitespace is a paste artifact the adapter\n    // would never match, and an untrimmed compare lets `model ` slip past the\n    // duplicate check against its own twin.\n    const id = model['id']\n    const trimmed = typeof id === 'string' ? id.trim() : undefined\n    if (trimmed === undefined || trimmed.length === 0) return { index, key: 'modelIdRequired' }\n    if (seen.has(trimmed)) return { index, key: 'modelIdDuplicate' }\n    seen.add(trimmed)\n    const name = model['name']\n    if (name !== undefined && (typeof name !== 'string' || name.length === 0)) {\n      return { index, key: 'modelNameInvalid' }\n    }\n    const contextWindow = model['contextWindow']\n    if (contextWindow !== undefined\n      && (typeof contextWindow !== 'number' || !Number.isInteger(contextWindow) || contextWindow <= 0)) {\n      return { index, key: 'modelContextInvalid' }\n    }\n    const maxTokens = model['maxTokens']\n    if (maxTokens !== undefined\n      && (typeof maxTokens !== 'number' || !Number.isInteger(maxTokens) || maxTokens <= 0)) {\n      return { index, key: 'modelMaxTokensInvalid' }\n    }\n  }\n  return undefined\n}\n\n/** Props of {@link DeepSeekModelsEditor}. */\nexport interface DeepSeekModelsEditorProps {\n  /** Effective rows: inherited until the parent materializes an override. */\n  models: readonly DeepSeekModelDraft[]\n  /** Whether the user layer currently owns the whole array. */\n  overridden: boolean\n  /** Fallback context capacity used when a row omits its exact value. */\n  defaultContextWindow: number | undefined\n  /** Fallback output cap used when a row omits its exact value. */\n  defaultMaxTokens: number | undefined\n  /** Section copy. */\n  t: (key: keyof typeof en) => string\n  /** Disable every mutation. */\n  disabled: boolean\n  /** Replace the user-owned array after one visible edit. */\n  onChange: (models: DeepSeekModelDraft[]) => void\n  /** Remove the user-owned array and return to inheritance. */\n  onReset: () => void\n}\n\n/**\n * Render the direct DeepSeek adapter's model catalog: id and display name on\n * each row, capacities and input types behind the row's own disclosure.\n * @param props - effective rows plus the array-level override actions.\n * @returns the catalog editor.\n */\nexport function DeepSeekModelsEditor(props: DeepSeekModelsEditorProps): ReactNode {\n  const rowState = useModelRows(props.models, props.onChange, props.disabled)\n\n  const update = (index: number, key: CatalogField, value: unknown): void => {\n    const next = props.models.map((model, at) => {\n      const copy = { ...model }\n      if (at !== index) return copy\n      if (value === undefined) Reflect.deleteProperty(copy, key)\n      else copy[key] = value\n      return copy\n    })\n    props.onChange(next)\n  }\n\n  const remove = (index: number): void => {\n    rowState.forget(new Set([index]))\n    props.onChange(props.models.filter((_model, at) => at !== index).map(model => ({ ...model })))\n  }\n\n  const reset = (): void => {\n    rowState.reset()\n    props.onReset()\n  }\n\n  /** The field's text: its live keystrokes, else the stored count spelled short. */\n  const capacityText = (model: DeepSeekModelDraft, index: number, field: CapacityField): string => {\n    const typed = rowState.rows[index]?.editing.get(field)\n    if (typed !== undefined) return typed\n    const value = model[field]\n    return typeof value === 'number' ? formatCapacity(value) : ''\n  }\n\n  const settleCapacity = (index: number, field: CapacityField): void => {\n    const typed = rowState.rows[index]?.editing.get(field)\n    if (typed === undefined) return\n    // Unreadable text stays on screen: the save-time rejection names a row the\n    // user can still see and correct.\n    const parsed = parseCapacity(typed)\n    if (parsed !== undefined && Number.isNaN(parsed)) return\n    rowState.edit(index, field, undefined)\n  }\n\n  const capacityInput = (model: DeepSeekModelDraft, index: number, field: CapacityField, fallback: number | undefined) => ({\n    value: capacityText(model, index, field),\n    placeholder: fallback === undefined\n      ? props.t(field === 'contextWindow' ? 'contextWindowPlaceholder' : 'maxTokensPlaceholder')\n      : formatCapacity(fallback),\n    onChange: (text: string) => {\n      rowState.edit(index, field, text)\n      update(index, field, parseCapacity(text))\n    },\n    onBlur: () => { settleCapacity(index, field) },\n  })\n\n  return (\n    <section className={styles['modelCatalog']} aria-label={props.t('models')}>\n      <div className={styles['modelListHead']}>\n        <div className={styles['modelCatalogHeading']}>\n          <span className={styles['modelCatalogTitle']}>{props.t('models')}</span>\n          <span className={styles['modelCatalogMeta']}>\n            {props.overridden ? props.t('modelsCustomized') : props.t('modelsInherited')}\n          </span>\n        </div>\n        {props.overridden\n          ? (\n            <button\n              type=\"button\"\n              className={styles['linkButton']}\n              disabled={props.disabled}\n              onClick={reset}\n            >\n              {props.t('resetModels')}\n            </button>\n          )\n          : null}\n      </div>\n      <AnimatedRows className={styles['modelList'] as string} rowKeys={rowState.rows.map(row => String(row.key))} ready resetKey=\"\">\n        {props.models.length === 0 ? <p className={styles['modelEmpty']}>{props.t('modelsEmpty')}</p> : null}\n        {rowState.rows.map(({ model, key, expanded, order }, index) => (\n          <ModelRow\n            key={key}\n            rowKey={key}\n            order={order}\n            model={model}\n            position={index + 1}\n            inputField=\"inputModalities\"\n            expanded={expanded}\n            disabled={props.disabled}\n            t={props.t}\n            contextWindow={capacityInput(model, index, 'contextWindow', props.defaultContextWindow)}\n            maxTokens={capacityInput(model, index, 'maxTokens', props.defaultMaxTokens)}\n            onFieldChange={(field, value) => { update(index, field, value) }}\n            onIdBlur={(value) => {\n              const trimmed = value.trim()\n              if (trimmed !== value) update(index, 'id', trimmed)\n            }}\n            onChange={(next) => { props.onChange(props.models.map((row, at) => at === index ? next : row)) }}\n            onToggle={() => { rowState.toggle(index) }}\n            onRemove={() => { remove(index) }}\n          />\n        ))}\n      </AnimatedRows>\n      <button\n        type=\"button\"\n        className={styles['addModelButton']}\n        disabled={props.disabled}\n        onClick={() => { props.onChange([...props.models.map(model => ({ ...model })), { id: '' }]) }}\n      >\n        <IconPlusOutlineRegular size={14} />\n        {props.t('addModel')}\n      </button>\n    </section>\n  )\n}\n","/**\n * The model list of one pi-ai provider profile, plus the action that asks the\n * provider what it serves.\n *\n * The list is the profile's `models` array as the card holds it: an empty list\n * means \"serve this route's built-in catalog\", and any entry replaces that\n * catalog, so a row is only ever added deliberately. Fetching asks the endpoint\n * **the form currently shows** — including a key typed but not yet saved — so\n * adding a provider is one pass instead of save-then-return; the reply is\n * candidates the user picks from, never configuration written behind them. The\n * picker opens with the configured models checked, so confirming it adds the\n * newly checked candidates and removes the unchecked configured ones in the\n * draft; configured rows the reply does not list are kept, and a confirmation\n * that would empty the list is refused.\n *\n * A provider that cannot be interrogated (an unreachable endpoint, a protocol\n * with no readable listing) is not a dead end: the failure is shown next to the\n * rows the user can still fill in by hand.\n */\n\nimport { useEffect, useMemo, useState } from 'react'\nimport type { ReactNode } from 'react'\nimport type { LlmDiscoveredModel } from '@deepseek-ai/dsh-api-remotes/client'\nimport { AnimatedRows, Button, IconPlusOutlineRegular, Modal } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { formatCapacity, parseCapacity } from './DeepSeekModelsEditor.tsx'\nimport type { ModelsOperations } from './operations.ts'\nimport type { DeepSeekModelDraft } from './DeepSeekModelsEditor.tsx'\nimport type { en } from './locales.ts'\nimport { ModelRow } from './ModelRow.tsx'\nimport { useModelRows } from './useModelRows.ts'\nimport type { CapacityField } from './useModelRows.ts'\nimport styles from './ModelsSection.module.css'\n\n/**\n * One configured model row. Fields this card does not edit must survive an\n * edit rather than being dropped by a rebuild.\n */\nexport type ModelDraft = DeepSeekModelDraft\n\n/** A row's text field, or the empty string when unset or not a string. */\nfunction textOf(model: ModelDraft, key: string): string {\n  const value = model[key]\n  return typeof value === 'string' ? value : ''\n}\n\n/** A row's numeric field, or `undefined` when unset or not a number. */\nfunction numberOf(model: ModelDraft, key: string): number | undefined {\n  const value = model[key]\n  return typeof value === 'number' ? value : undefined\n}\n\n/** What an interrogation needs, taken from the live form. */\nexport interface ProbeTarget {\n  /** Settings namespace whose adapter family answers. */\n  settingsNs: string\n  /**\n   * Route being edited, when the card edits one. An adapter that already\n   * describes it answers from its own registry, so such a card can ask without\n   * an endpoint at all.\n   */\n  provider?: string\n  /** Endpoint as the form currently shows it. */\n  baseURL?: string\n  /** Wire protocol the form names, when it names one. */\n  api?: string\n  /** Key typed into the form and not yet stored, when there is one. */\n  apiKey?: string\n}\n\n/** Props of {@link ModelListEditor}. */\nexport interface ModelListEditorProps {\n  /** The rows as currently drafted. */\n  models: readonly ModelDraft[]\n  /** Installed provider whose catalog supplies defaults without endpoint I/O. */\n  catalogProvider?: string | undefined\n  /**\n   * Reasoning levels a hand-declared route's rows may declare in\n   * `reasoningEfforts`, in escalation order; absent or empty shows no\n   * reasoning control, leaving a catalog model's levels to the catalog.\n   */\n  reasoningLevels?: readonly string[] | undefined\n  /** Whether the route's protocol accepts only {@link reasoningLevels}, each sent under its own name. */\n  reasoningLevelsOnly?: boolean | undefined\n  /** Route input types for models absent from the installed catalog. */\n  defaultInput?: readonly string[] | undefined\n  /** Whether the user layer currently owns the whole array; absent on a create. */\n  overridden?: boolean\n  /** Replace the drafted rows. */\n  onChange: (models: ModelDraft[]) => void\n  /** Remove the user-owned array and return to inheritance; absent on a create. */\n  onReset?: () => void\n  /** Endpoint facts for the fetch action. */\n  probe: ProbeTarget\n  /**\n   * Copy key naming why the fetch action is unavailable, or `undefined` when\n   * it is. The card owns this because the key it would send is judged there:\n   * asking with a key the form has already refused spends a round trip to be\n   * told what the field already says.\n   */\n  probeBlocked?: keyof typeof en | undefined\n  /** The Host operations whose interrogation answers the fetch action. */\n  operations: ModelsOperations\n  /** Section copy. */\n  t: (key: keyof typeof en) => string\n  /** Disable every control (read-only deployment or a pending write). */\n  disabled: boolean\n  /**\n   * Called once per change with whether an endpoint interrogation is in\n   * flight. The owning card folds it into its own busy state so the surface\n   * around the card — a mode switch, say — can refuse to move while the\n   * answer, and the picker it opens, is still bound for this list.\n   */\n  onBusyChange: (busy: boolean) => void\n}\n\n/**\n * What an empty capacity field is worth, shown as its placeholder so a row left\n * blank does not read as a model with no capacity at all.\n *\n * These hints match llm-pi-ai's built-in `defaultContextWindow` and\n * `defaultMaxTokens` in decimal K/M notation. Provider overrides are not\n * available to this component and are not reflected in the hints.\n */\nconst CAPACITY_HINT: Readonly<Record<CapacityField, string>> = {\n  contextWindow: '1M',\n  maxTokens: '128K',\n}\n\n/**\n * Spell a stored count for a field that may be unset. The spelling itself is\n * {@link formatCapacity}, shared with the DeepSeek catalog editor so both\n * surfaces read and write one K/M vocabulary.\n * @param value - stored capacity, or `undefined` for an unset field.\n * @returns the field text, empty when unset.\n */\nfunction capacitySpelling(value: number | undefined): string {\n  return value === undefined ? '' : formatCapacity(value)\n}\n\n/** Adopt a candidate, preserving disclosed capacities and input types. */\nfunction adopt(candidate: LlmDiscoveredModel): ModelDraft {\n  return {\n    id: candidate.id,\n    ...candidate.name === undefined ? {} : { name: candidate.name },\n    ...candidate.contextWindow === undefined ? {} : { contextWindow: candidate.contextWindow },\n    ...candidate.maxTokens === undefined ? {} : { maxTokens: candidate.maxTokens },\n    ...candidate.inputModalities === undefined ? {} : { input: [...candidate.inputModalities] },\n  }\n}\n\n/**\n * Render the model list with its fetch action.\n * @param props - the drafted rows, probe target, wire face, and copy.\n * @returns the model-list editor.\n */\nexport function ModelListEditor(props: ModelListEditorProps): ReactNode {\n  const { models, onChange, probe, operations, t, disabled, onBusyChange } = props\n  const { catalogProvider } = props\n  const [busy, setBusy] = useState(false)\n  useEffect(() => { onBusyChange(busy) }, [busy, onBusyChange])\n  const [failure, setFailure] = useState<string | undefined>(undefined)\n  const [inheritedCatalog, setInheritedCatalog] = useState<{\n    provider: string\n    models: readonly LlmDiscoveredModel[]\n  } | undefined>(undefined)\n  useEffect(() => {\n    if (catalogProvider === undefined) return\n    let current = true\n    void operations.discoverModels(probe.settingsNs, { provider: catalogProvider }).then((answer) => {\n      if (!current) return\n      setInheritedCatalog({ provider: catalogProvider, models: answer.kind === 'found' ? answer.models : [] })\n      setFailure(answer.kind === 'refused' ? answer.message : undefined)\n    })\n    return () => { current = false }\n  }, [catalogProvider, operations, probe.settingsNs])\n  const catalog = inheritedCatalog?.provider === catalogProvider ? inheritedCatalog?.models : undefined\n  const inputDefaults = useMemo(() => new Map(catalog?.map(model => [model.id, model.inputModalities])), [catalog])\n  const [candidates, setCandidates] = useState<readonly LlmDiscoveredModel[] | undefined>(undefined)\n  // Candidates whose checkbox the user flipped from its default. The default\n  // is read from the list at render, so a row drafted while the fetch was in\n  // flight opens checked rather than being removed by a stale selection.\n  const [flipped, setFlipped] = useState<ReadonlySet<string>>(new Set())\n  const [candidateQuery, setCandidateQuery] = useState('')\n  const rowState = useModelRows(models, onChange, disabled)\n\n  const editCapacity = (index: number, field: CapacityField, text: string): void => {\n    rowState.edit(index, field, text)\n    patch(index, { [field]: parseCapacity(text) })\n  }\n\n  const capacityText = (model: ModelDraft, index: number, field: CapacityField): string =>\n    rowState.rows[index]?.editing.get(field) ?? capacitySpelling(numberOf(model, field))\n\n  const patch = (index: number, next: Record<string, string | number | undefined>): void => {\n    onChange(models.map((model, at) => {\n      if (at !== index) return model\n      // Rebuilt rather than spread over: an emptied optional field has to leave\n      // the profile, not be stored as a value its schema would reject.\n      // Spread first so a field this card does not edit survives; an emptied\n      // optional field is then dropped rather than stored as a value its\n      // schema would reject.\n      const cleared = new Set(\n        Object.entries(next).filter(([, value]) => value === undefined || value === '').map(([key]) => key),\n      )\n      return Object.fromEntries(\n        Object.entries({ ...model, ...next }).filter(([key]) => !cleared.has(key)),\n      )\n    }))\n  }\n\n  const fetchModels = async (): Promise<void> => {\n    setBusy(true)\n    setFailure(undefined)\n    try {\n      const answer = await operations.discoverModels(probe.settingsNs, {\n        ...probe.provider === undefined ? {} : { provider: probe.provider },\n        ...probe.baseURL === undefined || probe.baseURL.length === 0 ? {} : { baseURL: probe.baseURL },\n        ...probe.api === undefined ? {} : { api: probe.api },\n        ...probe.apiKey === undefined ? {} : { apiKey: probe.apiKey },\n      })\n      if (answer.kind === 'refused') {\n        setFailure(answer.message)\n        return\n      }\n      const found = answer.models\n      if (catalogProvider !== undefined) setInheritedCatalog({ provider: catalogProvider, models: found })\n      if (found.length === 0) {\n        setFailure(t('fetchEmpty'))\n        return\n      }\n      setCandidateQuery('')\n      setFlipped(new Set())\n      // A listing may repeat an id; the picker and the list hold each model once.\n      setCandidates([...new Map(found.map(model => [model.id, model])).values()])\n    } finally {\n      setBusy(false)\n    }\n  }\n\n  const closePicker = (): void => {\n    setCandidates(undefined)\n    setFlipped(new Set())\n    setCandidateQuery('')\n  }\n\n  // The picker opens on the current list so a few models can be added or\n  // removed in one place. A list with no identified model serves the whole\n  // catalog or nothing yet, so every candidate starts checked.\n  const configuredIds = new Set(models.map(model => textOf(model, 'id')).filter(id => id.length > 0))\n  const pickedByDefault = (id: string): boolean => configuredIds.size === 0 || configuredIds.has(id)\n  const isPicked = (id: string): boolean => pickedByDefault(id) !== flipped.has(id)\n\n  const activeCandidates = candidates ?? []\n  const listed = new Set(activeCandidates.map(candidate => candidate.id))\n  // An unchecked candidate leaves the list. A row the listing does not name,\n  // including a half-typed row without an id, is outside the picker and stays.\n  const removedRows = new Set<number>()\n  models.forEach((model, at) => {\n    const id = textOf(model, 'id')\n    if (listed.has(id) && !isPicked(id)) removedRows.add(at)\n  })\n  // A kept row the user already tuned wins over the provider's own numbers.\n  const keptRows = models.filter((_model, at) => !removedRows.has(at))\n  const keptIds = new Set(keptRows.map(model => textOf(model, 'id')))\n  const addedRows = activeCandidates\n    .filter(candidate => isPicked(candidate.id) && !keptIds.has(candidate.id))\n    .map(adopt)\n  // An empty list serves the whole catalog, so emptying a non-empty list\n  // would restore every model instead of removing the unchecked ones.\n  const emptiesList = models.length > 0 && keptRows.length === 0 && addedRows.length === 0\n\n  const adoptPicked = (): void => {\n    onChange([...keptRows, ...addedRows])\n    rowState.forget(removedRows)\n    closePicker()\n  }\n\n  const toggle = (id: string): void => {\n    setFlipped((current) => {\n      const next = new Set(current)\n      if (!next.delete(id)) next.add(id)\n      return next\n    })\n  }\n\n  const normalizedCandidateQuery = candidateQuery.trim().toLowerCase()\n  const visibleCandidates = normalizedCandidateQuery.length === 0\n    ? activeCandidates\n    : activeCandidates.filter(candidate => candidate.id.toLowerCase().includes(normalizedCandidateQuery)\n      || candidate.name?.toLowerCase().includes(normalizedCandidateQuery) === true)\n  const allVisibleCandidatesPicked = visibleCandidates.length > 0\n    && visibleCandidates.every(candidate => isPicked(candidate.id))\n\n  const toggleVisibleCandidates = (): void => {\n    // Only visible candidates change: a hidden checked one may be a configured\n    // model, and clearing it would remove that model unseen.\n    const target = !allVisibleCandidatesPicked\n    setFlipped((current) => {\n      const next = new Set(current)\n      for (const candidate of visibleCandidates) {\n        if (pickedByDefault(candidate.id) === target) next.delete(candidate.id)\n        else next.add(candidate.id)\n      }\n      return next\n    })\n  }\n\n  // A route the adapter already describes answers without an endpoint; only a\n  // draft with neither has nothing to ask about.\n  const askable = probe.provider !== undefined || (probe.baseURL !== undefined && probe.baseURL.length > 0)\n  return (\n    <section className={styles['modelCatalog']} aria-label={t('models')}>\n      <div className={styles['modelListHead']}>\n        <div className={styles['modelCatalogHeading']}>\n          <span className={styles['modelCatalogTitle']}>{t('models')}</span>\n          {props.overridden === undefined\n            ? null\n            : (\n              <span className={styles['modelCatalogMeta']}>\n                {props.overridden ? t('modelsCustomized') : t('modelsInherited')}\n              </span>\n            )}\n        </div>\n        {props.overridden === true && props.onReset !== undefined\n          ? (\n            <button\n              type=\"button\"\n              className={styles['linkButton']}\n              disabled={disabled}\n              onClick={() => { rowState.reset(); props.onReset?.() }}\n            >\n              {t('resetModels')}\n            </button>\n          )\n          : null}\n        <button\n          type=\"button\"\n          className={styles['linkButton']}\n          disabled={disabled || busy || !askable || props.probeBlocked !== undefined}\n          title={props.probeBlocked !== undefined\n            ? t(props.probeBlocked)\n            : askable ? undefined : t('fetchNeedsBaseUrl')}\n          onClick={() => { void fetchModels() }}\n        >\n          {busy ? t('fetching') : t('fetchModels')}\n        </button>\n      </div>\n      {models.length === 0 ? <p className={styles['modelEmpty']}>{t('modelsEmpty')}</p> : null}\n      <AnimatedRows className={styles['modelList'] as string} rowKeys={rowState.rows.map(row => String(row.key))} ready resetKey=\"\">\n        {rowState.rows.map(({ model, key, expanded, order }, index) => (\n          <ModelRow\n            key={key}\n            rowKey={key}\n            order={order}\n            model={model}\n            position={index + 1}\n            inputField=\"input\"\n            inputFallback={inputDefaults.get(textOf(model, 'id')) ?? props.defaultInput}\n            inputLoading={catalogProvider !== undefined && catalog === undefined}\n            reasoningLevels={props.reasoningLevels}\n            reasoningLevelsOnly={props.reasoningLevelsOnly}\n            expanded={expanded}\n            disabled={disabled}\n            t={t}\n            contextWindow={{\n              value: capacityText(model, index, 'contextWindow'),\n              placeholder: CAPACITY_HINT.contextWindow,\n              onChange: (text) => { editCapacity(index, 'contextWindow', text) },\n            }}\n            maxTokens={{\n              value: capacityText(model, index, 'maxTokens'),\n              placeholder: CAPACITY_HINT.maxTokens,\n              onChange: (text) => { editCapacity(index, 'maxTokens', text) },\n            }}\n            onFieldChange={(field, value) => { patch(index, { [field]: value }) }}\n            onChange={(next) => { onChange(models.map((row, at) => at === index ? next : row)) }}\n            onToggle={() => { rowState.toggle(index) }}\n            onRemove={() => {\n              onChange(models.filter((_model, at) => at !== index))\n              rowState.forget(new Set([index]))\n            }}\n          />\n        ))}\n      </AnimatedRows>\n      <button\n        type=\"button\"\n        className={styles['addModelButton']}\n        disabled={disabled}\n        onClick={() => { onChange([...models, { id: '' }]) }}\n      >\n        <IconPlusOutlineRegular size={14} />\n        {t('addModel')}\n      </button>\n      {failure !== undefined ? <p className={styles['error']}>{failure}</p> : null}\n      <Modal\n        open={candidates !== undefined}\n        onClose={closePicker}\n        title={t('fetchTitle')}\n        closeLabel={t('close')}\n        description={t('fetchDescription')}\n        className={styles['fetchDialog'] as string}\n        footer={(\n          <>\n            <Button variant=\"outline\" onClick={closePicker}>{t('cancel')}</Button>\n            <Button\n              variant=\"outline\"\n              disabled={emptiesList}\n              title={emptiesList ? t('fetchKeepOne') : undefined}\n              onClick={adoptPicked}\n            >\n              {t('fetchAdopt')}\n            </Button>\n          </>\n        )}\n      >\n        <div className={styles['candidateToolbar']}>\n          <input\n            className={`${styles['input']} ${styles['candidateSearch']}`}\n            type=\"search\"\n            value={candidateQuery}\n            placeholder={t('fetchSearch')}\n            aria-label={t('fetchSearch')}\n            onChange={(event) => { setCandidateQuery(event.target.value) }}\n          />\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            disabled={visibleCandidates.length === 0}\n            onClick={toggleVisibleCandidates}\n          >\n            {t(allVisibleCandidatesPicked ? 'fetchDeselectAll' : 'fetchSelectAll')}\n          </Button>\n        </div>\n        {visibleCandidates.length === 0\n          ? <p className={styles['candidateEmpty']} role=\"status\">{t('fetchNoMatches')}</p>\n          : (\n            <ul className={styles['candidateList']}>\n              {visibleCandidates.map(candidate => (\n                <li key={candidate.id} className={styles['candidate']}>\n                  <label className={styles['candidateLabel']}>\n                    <input\n                      type=\"checkbox\"\n                      checked={isPicked(candidate.id)}\n                      onChange={() => { toggle(candidate.id) }}\n                    />\n                    <span className={styles['candidateId']} title={candidate.name ?? candidate.id}>\n                      {candidate.id}\n                    </span>\n                  </label>\n                </li>\n              ))}\n            </ul>\n          )}\n      </Modal>\n    </section>\n  )\n}\n","/**\n * Models settings page store: one snapshot joining the configurable-provider\n * directory (`llm/listProviders` joined with `llm/listConfigurableProviders`),\n * the settings namespaces (shared settings mirror),\n * and the referenced credentials (`credentials/describe`). The host stays the\n * single fact source — every mutation writes through the wire and the page\n * re-renders from the next describe, pushed or refetched.\n */\n\nimport type { Context as ClientContext } from '@deepseek-ai/cordis'\nimport type {\n  CredentialInfo, LlmConfigurableProvider, LlmNativeAuth, LlmProviderInfo, SettingsNamespaceView,\n} from '@deepseek-ai/dsh-api-remotes/client'\nimport type { SnapshotStore } from '@deepseek-ai/dsh-client-store'\nimport { createSnapshotStore } from '@deepseek-ai/dsh-client-store'\nimport type { SettingsDescribeFace } from '@deepseek-ai/dsh-client-ui-settings/client'\nimport type { SettingsSchemaOperations } from './schema-operations.ts'\n\n/**\n * Any route key walks a dict schema to the same profile node, so the lookup\n * names one that cannot collide with a configured route.\n */\nconst PROBE_ROUTE = '\\u0000probe'\n\n/** One provider row after joining the configurable directory with live routes. */\nexport interface ProviderDirectoryEntry {\n  readonly provider: string\n  readonly displayName: string\n  readonly settingsNs: string\n  readonly settingsPath: readonly string[]\n  readonly active: boolean\n  readonly declared?: boolean\n  readonly defaultBaseURL?: string\n  readonly baseURLEnv?: readonly string[]\n  readonly nativeAuth?: LlmNativeAuth\n  readonly error?: string\n}\n\n/**\n * Join declared configurable providers with the currently registered routes.\n * @param registered - live provider routes in registration order.\n * @param directory - declared configurable providers in declaration order.\n * @returns account and official routes first, then other routes in their original order.\n */\nexport function joinProviderDirectory(\n  registered: readonly LlmProviderInfo[],\n  directory: readonly LlmConfigurableProvider[],\n): ProviderDirectoryEntry[] {\n  const active = new Set(registered.map(provider => provider.id))\n  const declared = new Set(directory.map(entry => entry.provider))\n  const rows: ProviderDirectoryEntry[] = directory.map(entry => ({\n    provider: entry.provider,\n    displayName: entry.displayName,\n    settingsNs: entry.settingsNs,\n    settingsPath: [...entry.settingsPath],\n    active: active.has(entry.provider),\n    ...entry.declared === undefined ? {} : { declared: entry.declared },\n    ...entry.defaultBaseURL === undefined ? {} : { defaultBaseURL: entry.defaultBaseURL },\n    ...entry.baseURLEnv === undefined ? {} : { baseURLEnv: entry.baseURLEnv },\n    ...entry.nativeAuth === undefined ? {} : { nativeAuth: entry.nativeAuth },\n    ...entry.error === undefined ? {} : { error: entry.error },\n  }))\n  for (const provider of registered) {\n    if (declared.has(provider.id)) continue\n    rows.push({\n      provider: provider.id,\n      displayName: provider.name,\n      settingsNs: '',\n      settingsPath: [],\n      active: true,\n    })\n  }\n  return rows.toSorted((left, right) =>\n    (left.provider === 'deepseek-account' ? 0 : left.provider === 'deepseek-official' ? 1 : 2)\n      - (right.provider === 'deepseek-account' ? 0 : right.provider === 'deepseek-official' ? 1 : 2))\n}\n\n/** One provider row the page renders. */\nexport interface ProviderRow {\n  /** Account route has usable credentials for the configured inference origin. */\n  accountAvailable?: boolean\n  /** The directory entry (route id, display name, settings address, live state). */\n  entry: ProviderDirectoryEntry\n  /** Whether any layer configures this provider (its profile resolves). */\n  configured: boolean\n  /** Whether the user layer alone carries the profile (removal restores the base). */\n  removable: boolean\n  /** The credential reference the resolved profile names, when one does. */\n  apiKeyEnv: string | undefined\n  /** Credential state for {@link apiKeyEnv}, once described. */\n  credential: CredentialInfo | undefined\n  /**\n   * Credential state for the page's derived `<ROUTE>_API_KEY`, described only\n   * while the profile names no reference — the provider-card seat's\n   * `keyConfigured` fact for dormant and keyless rows, matching the editor's\n   * own derivation rule.\n   */\n  derivedCredential?: CredentialInfo\n  /** Redacted checks for named or native references; absent when their read failed. */\n  credentialChecks?: Readonly<Record<string, CredentialInfo>>\n}\n\n/** Page snapshot. */\nexport interface ModelsSettingsState {\n  status: 'idle' | 'loading' | 'ready' | 'error'\n  /** Whole-load failure text; row-level write failures stay in the editor. */\n  error: string | null\n  /** Credential enrichment failure; provider/settings rows remain usable. */\n  credentialError: string | null\n  /** Whether the settings provider accepts writes. */\n  writable: boolean\n  /** Every configurable provider joined with its configured/credential state. */\n  rows: readonly ProviderRow[]\n  /** Namespace views by ns, for the editor's schema/layers/secrets. */\n  namespaces: ReadonlyMap<string, SettingsNamespaceView>\n}\n\n/**\n * Derive the conventional credential reference for a provider route: the v1\n * page never asks for an environment-variable name, so a typed key stores\n * under this derived reference and the profile records it as `apiKeyEnv`.\n * @param provider - provider route id (e.g. `anthropic`, `minimax-cn`).\n * @returns the derived reference name (e.g. `MINIMAX_CN_API_KEY`).\n */\nexport function deriveKeyRef(provider: string): string {\n  return `${provider.toUpperCase().replace(/[^A-Z0-9]+/g, '_')}_API_KEY`\n}\n\n/**\n * The wire protocols a hand-declared route may name, read out of the owning\n * namespace's own schema. This stays a schema read rather than a wire field so\n * the choices the page offers cannot drift from the ones the adapter accepts:\n * both come from the same `Config`.\n * @param namespace - the namespace view whose schema declares the profile shape.\n * @param schema - settings schema operations.\n * @returns the protocol identifiers, or an empty list when the schema has none.\n */\nexport function protocolChoices(\n  namespace: SettingsNamespaceView | undefined,\n  schema: SettingsSchemaOperations,\n): string[] {\n  if (namespace === undefined) return []\n  const node = schema.nodeAtPath(schema.rehydrate(namespace.schema), ['providers', PROBE_ROUTE, 'api'])\n  const list = (node as { type?: string; list?: readonly { value?: unknown }[] } | undefined)\n  if (list?.type !== 'union' || list.list === undefined) return []\n  return list.list.map(entry => entry.value).filter((value): value is string => typeof value === 'string')\n}\n\n/**\n * The reasoning levels a hand-declared route's models may declare, read out of\n * the owning namespace's own schema for the same reason as\n * {@link protocolChoices}: the levels the page offers and the keys the\n * adapter accepts in `reasoningEfforts` come from the same `Config`.\n * @param namespace - the namespace view whose schema declares the profile shape.\n * @param schema - settings schema operations.\n * @returns the levels in the schema's escalation order, or an empty list when the schema has none.\n */\nexport function reasoningLevelChoices(\n  namespace: SettingsNamespaceView | undefined,\n  schema: SettingsSchemaOperations,\n): string[] {\n  if (namespace === undefined) return []\n  const path = ['providers', PROBE_ROUTE, 'models', '0', 'reasoningEfforts']\n  const node = schema.nodeAtPath(schema.rehydrate(namespace.schema), path)\n  // `false | { [level]: value }`: the dict branch's key schema lists the levels.\n  const branches = (node as { list?: readonly { type?: string; sKey?: unknown }[] } | undefined)?.list ?? []\n  const keys = branches.find(branch => branch.type === 'dict')?.sKey as { list?: readonly { value?: unknown }[] } | undefined\n  return (keys?.list ?? []).map(entry => entry.value).filter((value): value is string => typeof value === 'string')\n}\n\n/** The credential reference a resolved profile names (its `apiKeyEnv` field). */\nfunction apiKeyEnvOf(\n  namespace: SettingsNamespaceView | undefined,\n  path: readonly string[],\n  schema: SettingsSchemaOperations,\n): string | undefined {\n  if (namespace === undefined) return undefined\n  const profile = schema.getPath(namespace.value, path)\n  if (typeof profile !== 'object' || profile === null) return undefined\n  const ref = (profile as { apiKeyEnv?: unknown }).apiKeyEnv\n  return typeof ref === 'string' && ref.length > 0 ? ref : undefined\n}\n\n/** The models settings page controller (one per settings surface). */\nexport class ModelsSettingsStore {\n  /** The snapshot the section renders from (uSES-safe store). */\n  readonly store: SnapshotStore<ModelsSettingsState> = createSnapshotStore<ModelsSettingsState>({\n    status: 'idle', error: null, credentialError: null, writable: false, rows: [], namespaces: new Map(),\n  })\n\n  /** Latest load wins; an older response never overwrites a newer one. */\n  private generation = 0\n  /** Callers follow the current refresh's outcome, including callers whose read was superseded. */\n  private readonly pendingLoads = new Set<PromiseWithResolvers<void>>()\n\n  /**\n   * @param ctx - the page plugin's context, whose `remote.llm` and\n   * `remote.credentials` namespaces carry the directory and credential reads.\n   * @param schema - settings-owned schema and immutable path operations.\n   * @param describeFace - the shared mirror's describe face (namespace views and writability).\n   */\n  constructor(\n    private readonly ctx: ClientContext,\n    private readonly schema: SettingsSchemaOperations,\n    private readonly describeFace: SettingsDescribeFace,\n  ) {}\n\n  /**\n   * Refresh the whole page snapshot: the provider directory and the mirror's\n   * settings answer in parallel, then one batched credential describe over\n   * every referenced ref. Provider failure or absence of an initial settings\n   * answer keeps the last good rows and surfaces an error; a failed settings\n   * refresh reuses the mirror's held view. Concurrent callers resolve only\n   * after the current refresh publishes its ready or error snapshot.\n   * @returns resolution after the current snapshot is published.\n   * @throws the current read's unexpected rejection; superseded rejections are ignored.\n   */\n  load(): Promise<void> {\n    const pending = Promise.withResolvers<void>()\n    this.pendingLoads.add(pending)\n    const generation = ++this.generation\n    void this.read(generation).then(\n      () => { this.settleLoads(generation, (load) => { load.resolve() }) },\n      (error: unknown) => { this.settleLoads(generation, (load) => { load.reject(error) }) },\n    )\n    return pending.promise\n  }\n\n  /** Publish one joined answer; stale answers leave the current refresh in charge. */\n  private async read(generation: number): Promise<void> {\n    this.store.update((s) => { s.status = 'loading'; s.error = null })\n    const [registered, declared] = await Promise.all([\n      this.ctx.remote.llm.listProviders(),\n      this.ctx.remote.llm.listConfigurableProviders(),\n      this.describeFace.ensure(),\n    ])\n    if (generation !== this.generation) return\n    if (!registered.ok) { this.failLoad(registered.error.message); return }\n    if (!declared.ok) { this.failLoad(declared.error.message); return }\n    const mirrored = this.describeFace.getSnapshot()\n    if (mirrored.view === undefined) {\n      /* v8 ignore next -- SettingsDescribeFace.ensure settles with a view or the read's error */\n      if (mirrored.error === null) throw new Error('settings describe settled with neither a view nor an error')\n      this.failLoad(mirrored.error)\n      return\n    }\n    const providers = joinProviderDirectory(registered.value, declared.value)\n    const writable = mirrored.view.writable\n    const views: readonly SettingsNamespaceView[] = mirrored.view.namespaces\n    const namespaces = new Map(views.map(view => [view.ns, view]))\n    const rows: ProviderRow[] = providers.map((entry) => {\n      const namespace = namespaces.get(entry.settingsNs)\n      const configured = namespace !== undefined\n        && (entry.settingsPath.length === 0 || this.schema.getPath(namespace.value, entry.settingsPath) !== undefined)\n      const removable = namespace !== undefined\n        && entry.settingsPath.length > 0\n        && this.schema.hasPath(namespace.user, entry.settingsPath)\n        && !this.schema.hasPath(namespace.base, entry.settingsPath)\n      return {\n        entry,\n        configured,\n        removable,\n        apiKeyEnv: entry.provider === 'deepseek-account' ? undefined : apiKeyEnvOf(namespace, entry.settingsPath, this.schema),\n        credential: undefined,\n      }\n    })\n    if (rows.some(row => row.entry.provider === 'deepseek-account')) {\n      const catalog = await this.ctx.remote.session.modelCatalog()\n      for (const row of rows) {\n        if (row.entry.provider === 'deepseek-account') row.accountAvailable = catalog.ok\n          && catalog.value.groups.some(group => group.id === 'deepseek-account' && group.models.length > 0)\n      }\n    }\n    const refs = [...new Set(rows.filter(row => row.entry.provider !== 'deepseek-account').flatMap(row =>\n      row.apiKeyEnv === undefined ? [deriveKeyRef(row.entry.provider), ...row.entry.nativeAuth?.env ?? []] : [row.apiKeyEnv]))]\n    const credentials: Record<string, CredentialInfo> = {}\n    let credentialError: string | null = null\n    // credentials.describe accepts at most 64 references per request.\n    for (let index = 0; index < refs.length; index += 64) {\n      const response = await this.ctx.remote.credentials.describe(refs.slice(index, index + 64))\n      // Credential state is an enrichment for the Models page: a failure\n      // degrades the badge instead of failing the load. The onboarding\n      // projection below retains the failure distinction.\n      if (response.ok) Object.assign(credentials, response.value)\n      else { credentialError = response.error.message; break }\n    }\n    if (generation !== this.generation) return\n    this.store.update((s) => {\n      s.status = 'ready'\n      s.error = null\n      s.credentialError = credentialError\n      s.writable = writable\n      s.rows = rows.filter(row => row.entry.provider !== 'deepseek-account' || row.accountAvailable === true).map((row) => {\n        if (row.entry.provider === 'deepseek-account') return row\n        const named = row.apiKeyEnv === undefined ? undefined : credentials[row.apiKeyEnv]\n        const derived = row.apiKeyEnv !== undefined ? undefined : credentials[deriveKeyRef(row.entry.provider)]\n        return {\n          ...row,\n          ...named === undefined ? {} : { credential: named },\n          ...derived === undefined ? {} : { derivedCredential: derived },\n          ...credentialError === null ? { credentialChecks: Object.fromEntries(\n            (row.apiKeyEnv === undefined ? row.entry.nativeAuth?.env ?? [] : [row.apiKeyEnv])\n              .flatMap((ref) => {\n                const info = credentials[ref]\n                return info === undefined ? [] : [[ref, info] as const]\n              }),\n          ) } : {},\n        }\n      })\n      s.namespaces = namespaces\n    })\n  }\n\n  /** Settle callers only while this read still owns the current refresh. */\n  private settleLoads(generation: number, settle: (load: PromiseWithResolvers<void>) => void): void {\n    if (generation !== this.generation) return\n    const pending = [...this.pendingLoads]\n    this.pendingLoads.clear()\n    for (const load of pending) settle(load)\n  }\n\n  /** Publish the current joined read's failure text. */\n  private failLoad(message: string): void {\n    this.store.update((s) => {\n      s.status = 'error'\n      s.error = message\n    })\n  }\n}\n\n/**\n * Whether a joined row can serve model requests as it stands: the route is\n * registered with the adapter registry, and whatever credential its resolved\n * profile names is stored. A profile naming no reference authenticates through\n * the provider's own path (the Bedrock chain, Vertex ADC, a gateway that needs\n * nothing), as does a live route with no settings address at all, so neither\n * owes this page a key.\n * @param row - one joined provider row.\n * @returns whether the user already has this provider to talk to.\n */\nexport function providerUsable(row: ProviderRow): boolean {\n  if (!row.entry.active) return false\n  if (row.entry.provider === 'deepseek-account') return row.accountAvailable === true\n  if (row.apiKeyEnv === undefined) return true\n  return row.credential?.configured === true\n}\n\n/** First-run onboarding readiness derived only from the shared Models join. */\nexport type OnboardingReadiness =\n  | { kind: 'loading' }\n  | { kind: 'adapter-absent' }\n  | { kind: 'provider-ready' }\n  | { kind: 'credential-missing' }\n  | {\n    kind: 'unavailable'\n    reason:\n      | 'load-failed'\n      | 'provider-inactive'\n      | 'credentials-unavailable'\n      | 'settings-read-only'\n      | 'credential-read-only'\n  }\n\n/**\n * Project first-run readiness from the provider/settings/credential join used\n * by the Models page. The step exists to leave the user with a model to talk\n * to, so ANY usable provider ends it; only when none exists does the official\n * DeepSeek route — the one route the prompt can offer a key field for — decide\n * whether prompting can help. A missing official configurable-provider\n * declaration means the adapter is not repairable by navigating to Models.\n * @param state - current shared Models join snapshot.\n * @returns the onboarding state without reading a parallel fact source.\n */\nexport function onboardingReadiness(state: ModelsSettingsState): OnboardingReadiness {\n  if ((state.status === 'idle' || state.status === 'loading') && state.rows.length === 0) {\n    return { kind: 'loading' }\n  }\n  if (state.status === 'error') {\n    return {\n      kind: 'unavailable',\n      reason: 'load-failed',\n    }\n  }\n  if (state.rows.some(providerUsable)) return { kind: 'provider-ready' }\n  const row = state.rows.find(candidate =>\n    candidate.entry.provider === 'deepseek-official'\n    && candidate.entry.settingsNs === 'llm-deepseek'\n    && candidate.entry.settingsPath.length === 0)\n  if (row === undefined) return { kind: 'adapter-absent' }\n  if (!row.entry.active) {\n    return {\n      kind: 'unavailable',\n      reason: 'provider-inactive',\n    }\n  }\n  // Past the usable gate an active route names a reference it has no stored\n  // credential for, so the remaining questions are all about that credential.\n  if (state.credentialError !== null || row.credential === undefined) {\n    return {\n      kind: 'unavailable',\n      reason: 'credentials-unavailable',\n    }\n  }\n  if (!state.writable) {\n    return {\n      kind: 'unavailable',\n      reason: 'settings-read-only',\n    }\n  }\n  if (!row.credential.writable) {\n    return {\n      kind: 'unavailable',\n      reason: 'credential-read-only',\n    }\n  }\n  return { kind: 'credential-missing' }\n}\n","/**\n * Product names for the wire protocols a pi-ai route may speak. The pickers\n * show these instead of the schema identifiers (`openai-completions`), which\n * are what `settings.yaml` carries and what the option values stay.\n */\n\nimport type { ModelsKey } from './locales.ts'\n\n/** The protocols this page names, keyed by their schema identifier. */\nconst PROTOCOL_LABEL_KEYS: Readonly<Record<string, ModelsKey>> = {\n  'openai-completions': 'protocolOpenAiCompletions',\n  'openai-responses': 'protocolOpenAiResponses',\n  'anthropic-messages': 'protocolAnthropicMessages',\n  'google-generative-ai': 'protocolGemini',\n}\n\n/**\n * The picker text for one protocol identifier.\n * @param t - section copy.\n * @param protocol - the schema identifier of the protocol.\n * @returns the product name this page knows the protocol by; a protocol the\n * adapter adds before this page names it shows its identifier, the spelling\n * `settings.yaml` needs anyway.\n */\nexport function protocolLabel(t: (key: ModelsKey) => string, protocol: string): string {\n  const key = PROTOCOL_LABEL_KEYS[protocol]\n  return key === undefined ? protocol : t(key)\n}\n","/**\n * Constraints a wire protocol places on a hand-declared route that the Models\n * forms check before a write, because the adapter accepts the profile and only\n * the first request would fail.\n */\n\n/** pi-ai's Gemini protocol identifier. */\nconst GEMINI = 'google-generative-ai'\n\n/** The only thinking levels pi-ai's Gemini protocol sends. */\nconst GEMINI_LEVELS: readonly string[] = ['minimal', 'low', 'medium', 'high']\n\n/**\n * Whether a route speaking this protocol cannot work without an API key:\n * pi-ai's Gemini implementation refuses a request without one, and no header\n * or ambient credential replaces it.\n * @param protocol - the route's protocol identifier, when chosen.\n * @returns whether the form must require a key.\n */\nexport function protocolNeedsKey(protocol: string | undefined): boolean {\n  return protocol === GEMINI\n}\n\n/** The reasoning levels a protocol's models may declare. */\nexport interface ProtocolReasoningLevels {\n  /** Levels offered, in the schema's escalation order. */\n  levels: readonly string[]\n  /** Whether only these levels are accepted, each sent under its own name. */\n  levelsOnly: boolean\n}\n\n/**\n * Narrow the schema's reasoning levels to the ones a protocol accepts. pi-ai's\n * Gemini protocol sends only `minimal`, `low`, `medium`, or `high` and fails a\n * request carrying any other value, so a Gemini route offers those four with\n * fixed values and no Off.\n * @param protocol - the route's protocol identifier, when chosen.\n * @param levels - levels the adapter's schema accepts.\n * @returns the levels to offer and whether their values are fixed.\n */\nexport function protocolReasoningLevels(protocol: string | undefined, levels: readonly string[]): ProtocolReasoningLevels {\n  if (protocol !== GEMINI) return { levels, levelsOnly: false }\n  return { levels: levels.filter(level => GEMINI_LEVELS.includes(level)), levelsOnly: true }\n}\n","/**\n * The card that declares a provider pi-ai does not ship — a gateway, a\n * self-hosted server, or a provider newer than the installed catalog.\n *\n * This is a create, not an edit, which is why it is its own form rather than\n * the provider editor with extra fields: the route id is being *chosen* here,\n * and the settings address does not exist until it is. It renders as the\n * custom-API panel of the section's add card; the card's mode switch names it\n * when both modes are offered, and with the custom mode alone the card shows\n * this form directly. One `settings.mutate` sets the whole profile at\n * `providers.<route>`; the key travels separately through `credentials/set`\n * under the reference the profile records, exactly as an existing provider's\n * key does.\n *\n * The three fields a hand-declared route cannot default — endpoint, protocol,\n * and at least one model — are required here rather than at load, so the\n * failure names the field while the user is still looking at it.\n *\n * There is deliberately no provider-scoped reasoning-effort control, here or\n * on the editor card: effort is a per-MODEL capability, and the models under\n * one provider disagree about it, so a provider-scoped control can only be set\n * to a value some of them reject. Each model row of a hand-declared route\n * declares its own `reasoningEfforts` instead, and the composer's model picker\n * offers each model those levels.\n */\n\nimport { useEffect, useState } from 'react'\nimport type { ReactNode } from 'react'\nimport type { JsonValue } from '@deepseek-ai/dsh-util-values'\nimport { apiKeyFailure } from './apiKey.ts'\nimport { ApiKeyInput } from './ApiKeyInput.tsx'\nimport { EditorFooter } from './EditorFooter.tsx'\nimport { validateDeepSeekModels } from './DeepSeekModelsEditor.tsx'\nimport { ModelListEditor } from './ModelListEditor.tsx'\nimport type { ModelDraft } from './ModelListEditor.tsx'\nimport { validateReasoningEfforts } from './ModelReasoningEfforts.tsx'\nimport { deriveKeyRef } from './store.ts'\nimport { protocolLabel } from './protocol-label.ts'\nimport { protocolNeedsKey, protocolReasoningLevels } from './protocol-rules.ts'\nimport type { ModelsOperations } from './operations.ts'\nimport type { en, ModelsKey } from './locales.ts'\nimport styles from './ModelsSection.module.css'\n\n/** The settings namespace a hand-declared provider is written into. */\nconst NS = 'llm-pi-ai'\n\n/**\n * A route id usable as a settings key AND as the stem of a credential name.\n * The leading letter is the second half of that: `deriveKeyRef` uppercases the\n * id and replaces every non-alphanumeric run with `_`, and a credential\n * reference is a POSIX shell identifier, which cannot start with a digit. A\n * digit-leading id passes every check this card makes and then fails at the\n * credential seam with a raw regular expression the user cannot act on.\n */\nconst ROUTE_PATTERN = /^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/\n\n/**\n * Endpoint examples for protocols whose SDK expects a different base than an\n * OpenAI-compatible `/v1`: Anthropic's SDK appends `/v1/messages`, and the\n * Gemini protocol expects the API version in the base URL.\n */\nconst BASE_URL_PLACEHOLDERS: Readonly<Record<string, ModelsKey>> = {\n  'anthropic-messages': 'customAnthropicBaseUrlPlaceholder',\n  'google-generative-ai': 'customGeminiBaseUrlPlaceholder',\n}\n\nfunction isHttpUrl(value: string): boolean {\n  try {\n    const protocol = new URL(value).protocol\n    return protocol === 'http:' || protocol === 'https:'\n  } catch {\n    return false\n  }\n}\n\n/** Props of {@link CustomProviderCard}. */\nexport interface CustomProviderCardProps {\n  /** Route ids already declared, so the card refuses to shadow one. */\n  taken: readonly string[]\n  /** Wire protocols the adapter can serve, in the order it reports them. */\n  protocols: readonly string[]\n  /** Reasoning levels the adapter's schema accepts, in escalation order; empty shows no reasoning control. */\n  reasoningLevels: readonly string[]\n  /**\n   * Revision of the `llm-pi-ai` user section this card opened at, sent with\n   * the create so a route another tab declared meanwhile is a refusal rather\n   * than a silent overwrite of its whole profile.\n   */\n  revision: number\n  /** The Host operations this card writes and interrogates through. */\n  operations: ModelsOperations\n  /** Section copy. */\n  t: (key: keyof typeof en) => string\n  /** Disable writes (read-only settings provider). */\n  readOnly: boolean\n  /** Close the card; `changed` reports whether a provider was created. */\n  onClose: (changed: boolean) => void\n  /**\n   * Called once per change with whether the create or the list's endpoint\n   * interrogation is in flight, so the owner can hold its surface still.\n   */\n  onBusyChange?: (busy: boolean) => void\n}\n\n/**\n * Render the custom-provider creation card.\n * @param props - existing routes, protocol choices, wire faces, and copy.\n * @returns the creation card.\n */\nexport function CustomProviderCard(props: CustomProviderCardProps): ReactNode {\n  const { taken, protocols, reasoningLevels, operations, t, onBusyChange } = props\n  // The write is checked against the revision on which this draft was opened.\n  const [openedAt] = useState(() => props.revision)\n  const [route, setRoute] = useState('')\n  const [displayName, setDisplayName] = useState('')\n  const [baseURL, setBaseURL] = useState('')\n  const [protocol, setProtocol] = useState(protocols[0] ?? '')\n  const [keyDraft, setKeyDraft] = useState('')\n  const [models, setModels] = useState<readonly ModelDraft[]>([])\n  const [busy, setBusy] = useState(false)\n  const [listBusy, setListBusy] = useState(false)\n  useEffect(() => { onBusyChange?.(busy || listBusy) }, [busy, listBusy, onBusyChange])\n  const [failure, setFailure] = useState<string | undefined>(undefined)\n  /**\n   * The profile write landed. Only the key write can still be outstanding, so\n   * the fields that describe the provider are settled and the retry path is\n   * the credential alone.\n   */\n  const [committed, setCommitted] = useState(false)\n  const disabled = props.readOnly || busy\n  /** Everything but the key stops being editable once the provider exists. */\n  const profileDisabled = disabled || committed\n\n  const routeInvalid = route.length > 0 && !ROUTE_PATTERN.test(route)\n  const routeTaken = taken.includes(route)\n  const normalizedBaseURL = baseURL.trim()\n  const baseUrlInvalid = baseURL.length > 0 && !isHttpUrl(normalizedBaseURL)\n  // Rows are checked by the same per-row validator the editor cards use, so a\n  // bad row is named by its position here too. Capacities have route-level\n  // fallbacks; what a route cannot default is at least one model. Every row of\n  // this hand-declared route edits its reasoning levels, so they are checked too.\n  const reasoning = protocolReasoningLevels(protocol, reasoningLevels)\n  const modelFailure = validateDeepSeekModels(models)\n    ?? validateReasoningEfforts(models, reasoning.levelsOnly ? reasoning.levels : undefined)\n  // A blank key is a legal choice only where the protocol can authenticate without one.\n  const keyMissing = protocolNeedsKey(protocol) && keyDraft.trim().length === 0\n  const keyFailure = keyMissing ? 'keyRequired' as const : apiKeyFailure(keyDraft)\n  // The typed key with paste whitespace removed. A blank field yields an empty\n  // string, which the create path reads as \"no key supplied\" — a route may\n  // legitimately authenticate through the provider's own ambient discovery.\n  const keyValue = keyDraft.trim()\n  const ready = route.length > 0 && !routeInvalid && !routeTaken\n    && normalizedBaseURL.length > 0 && !baseUrlInvalid && models.length > 0 && modelFailure === undefined\n    && keyFailure === undefined\n  // The one blocked gate worth a line under the form. A satisfied card says\n  // nothing at all rather than printing an empty paragraph.\n  const hint = failure !== undefined || ready\n    // The key field prints its own failure directly beneath itself, so a card\n    // blocked only by the key stays silent here rather than answering with the\n    // next unmet gate — which is satisfied, and reads as a second, false fault.\n    || keyFailure !== undefined\n    // Same for the route id, and it must be tested rather than assumed: the\n    // fallback arm below reads \"no models yet\", so an unmet route gate would\n    // fall through to it and contradict the filled-in list right above.\n    || route.length === 0 || routeInvalid || routeTaken || baseUrlInvalid\n    ? undefined\n    : normalizedBaseURL.length === 0\n      ? t('customNeedsBaseUrl')\n      : modelFailure !== undefined\n        ? `${t('model')} ${String(modelFailure.index + 1)}: ${t(modelFailure.key)}`\n        : t('customNeedsModels')\n\n  /** Perform the create, returning a failure message or undefined. */\n  const createOnce = async (): Promise<string | undefined> => {\n    const keyRef = deriveKeyRef(route)\n    const storesKey = keyValue.length > 0\n    if (!committed) {\n      const profile = {\n        ...displayName.length === 0 ? {} : { displayName },\n        // The profile names the conventional reference only when this card is\n        // about to store a key, matching the editor: a route declared with the\n        // key left blank keeps its provider-native auth path (a credential\n        // chain, ADC) instead of resolving a reference nothing ever sets.\n        ...storesKey ? { apiKeyEnv: keyRef } : {},\n        api: protocol,\n        baseURL: normalizedBaseURL,\n        models: models.map(model => ({ ...model })),\n      }\n      // `taken` is a snapshot too, so the id check alone cannot see a route\n      // declared after this card opened; the revision makes that race a\n      // `settings-conflict` instead of a write over the other profile.\n      const written = await operations.writeSettings(\n        NS,\n        [{ op: 'set', path: ['providers', route], value: profile as JsonValue }],\n        openedAt,\n      )\n      if (written.kind !== 'written') {\n        return written.kind === 'conflict' ? t('conflict') : written.message\n      }\n      // The provider now exists. A retry after the key write below fails must\n      // not re-run this mutate: the revision it holds is the one this write\n      // just superseded, so the Host would answer `settings-conflict` and the\n      // key could never be stored from this card at all.\n      setCommitted(true)\n    }\n    if (storesKey) {\n      const stored = await operations.storeCredential(keyRef, keyValue)\n      // The profile landed; saying the key did not is the only honest report,\n      // and the retry above now goes straight back to this write.\n      if (stored !== undefined) return stored\n    }\n    return undefined\n  }\n\n  const create = async (): Promise<void> => {\n    setBusy(true)\n    setFailure(undefined)\n    try {\n      const outcome = await createOnce()\n      if (outcome !== undefined) {\n        setFailure(outcome)\n        return\n      }\n      props.onClose(true)\n    } finally {\n      setBusy(false)\n    }\n  }\n\n  return (\n    <div className={styles['editor']}>\n      <div className={styles['field']}>\n        <span className={styles['fieldLabel']}>{t('customRoute')}</span>\n        <input\n          className={styles['input']}\n          type=\"text\"\n          value={route}\n          placeholder=\"acme-gateway\"\n          aria-label={t('customRoute')}\n          disabled={profileDisabled}\n          onChange={(event) => { setRoute(event.target.value) }}\n        />\n      </div>\n      {/* A rejected id reads as a fault, not as guidance — the same split the\n          key field below already makes between its failure and its hint. */}\n      {routeInvalid || routeTaken\n        ? <p className={styles['error']}>{t(routeInvalid ? 'customRouteInvalid' : 'customRouteTaken')}</p>\n        : <p className={styles['advancedHint']}>{t('customRouteHint')}</p>}\n      <div className={styles['field']}>\n        <span className={styles['fieldLabel']}>{t('customDisplayName')}</span>\n        <input\n          className={styles['input']}\n          type=\"text\"\n          value={displayName}\n          placeholder={route.length === 0 ? t('customDisplayName') : route}\n          aria-label={t('customDisplayName')}\n          disabled={profileDisabled}\n          onChange={(event) => { setDisplayName(event.target.value) }}\n        />\n      </div>\n      <div className={styles['field']}>\n        <span className={styles['fieldLabel']}>{t('baseUrl')}</span>\n        <input\n          className={styles['input']}\n          type=\"text\"\n          value={baseURL}\n          placeholder={t(BASE_URL_PLACEHOLDERS[protocol] ?? 'customBaseUrlPlaceholder')}\n          aria-label={t('baseUrl')}\n          aria-invalid={baseUrlInvalid}\n          disabled={profileDisabled}\n          onChange={(event) => { setBaseURL(event.target.value) }}\n        />\n      </div>\n      {baseUrlInvalid ? <p className={styles['error']}>{t('customBaseUrlInvalid')}</p> : null}\n      <div className={styles['field']}>\n        <span className={styles['fieldLabel']}>{t('customApi')}</span>\n        <select\n          className={`${styles['input']} ${styles['selectInput']}`}\n          value={protocol}\n          aria-label={t('customApi')}\n          disabled={profileDisabled}\n          onChange={(event) => { setProtocol(event.target.value) }}\n        >\n          {protocols.map(choice => <option key={choice} value={choice}>{protocolLabel(t, choice)}</option>)}\n        </select>\n      </div>\n      <div className={styles['field']}>\n        <span className={styles['fieldLabel']}>{t('keyInput')}</span>\n        <ApiKeyInput\n          t={t}\n          value={keyDraft}\n          placeholder={t('keyPlaceholder')}\n          aria-label={t('keyInput')}\n          required={protocolNeedsKey(protocol)}\n          disabled={disabled}\n          onChange={(event) => { setKeyDraft(event.target.value) }}\n        />\n        {/* A create card has no stored key to keep, so the blank case says\n            what a blank field means here instead: this route may authenticate\n            through the provider's own ambient discovery or OAuth. A key the\n            protocol requires is a requirement still to meet, not a fault. */}\n        {keyFailure === undefined\n          ? null\n          : <p className={styles[keyMissing ? 'advancedHint' : 'error']}>{t(keyFailure === 'keyBlank' ? 'keyBlankNew' : keyFailure)}</p>}\n      </div>\n      <ModelListEditor\n        models={models}\n        onChange={setModels}\n        reasoningLevels={reasoning.levels}\n        reasoningLevelsOnly={reasoning.levelsOnly}\n        probe={{\n          settingsNs: NS,\n          baseURL: normalizedBaseURL,\n          api: protocol,\n          ...keyValue.length === 0 ? {} : { apiKey: keyValue },\n        }}\n        probeBlocked={baseUrlInvalid\n          ? 'customBaseUrlInvalid'\n          : keyFailure === 'keyBlank' ? 'keyBlankNew' : keyFailure}\n        operations={operations}\n        t={t}\n        disabled={profileDisabled}\n        onBusyChange={setListBusy}\n      />\n      {failure !== undefined ? <p className={styles['error']}>{failure}</p> : null}\n      {/* Only the gates with something to say render; the route-id gate has its\n          own field-level hint, so its blocked state would print an empty line. */}\n      {hint === undefined ? null : <p className={styles['advancedHint']}>{hint}</p>}\n      <EditorFooter\n        t={t}\n        busy={busy}\n        submitDisabled={disabled || !ready}\n        submitLabelKey=\"create\"\n        submitBusyLabelKey=\"creating\"\n        onCancel={() => { props.onClose(committed) }}\n        onSubmit={() => { void create() }}\n      />\n    </div>\n  )\n}\n","/**\n * The provider retry-policy fields of an editor card, built from the\n * `retryPolicy` schema the owning namespace publishes: its union branches are\n * the modes, each branch's fields are the inputs, and the field bounds and\n * defaults come from the schema. Number fields render as inputs, string lists\n * as a code picker, and nested objects as a fold. An absent `retryPolicy`\n * keeps the inherited policy; choosing a mode writes a user-layer policy whose\n * empty fields keep the inherited values.\n */\n\nimport { useState } from 'react'\nimport type { ReactNode } from 'react'\nimport { Checkbox } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { SettingsSchemaOperations } from './schema-operations.ts'\nimport type { ModelsKey } from './locales.ts'\nimport styles from './ModelsSection.module.css'\n\n/** One schema node of the provider's settings form. */\ntype SchemaNode = NonNullable<ReturnType<SettingsSchemaOperations['nodeAtPath']>>\n\n/** Labels of known modes and fields by schema key; any other key shows verbatim. */\nconst LABELS: ReadonlyMap<string, ModelsKey> = new Map([\n  ['normal', 'retryModeNormal'],\n  ['always', 'retryModeAlways'],\n  ['maxRetries', 'retryMaxRetries'],\n  ['retryableCodes', 'retryCodes'],\n  ['backoff', 'retryBackoff'],\n  ['initialDelayMs', 'retryInitialDelay'],\n  ['maxDelayMs', 'retryMaxDelay'],\n  ['jitterRatio', 'retryJitter'],\n])\n\n/** Hints shown under the mode select, by mode. */\nconst MODE_HINTS: ReadonlyMap<string, ModelsKey> = new Map([['always', 'retryAlwaysHint']])\n\n/** Labels of known failure codes; a code without one shows verbatim. */\nconst CODE_LABELS: ReadonlyMap<string, ModelsKey> = new Map([\n  ['EMPTY_RESPONSE', 'retryCodeEmptyResponse'],\n  ['RATE_LIMIT', 'retryCodeRateLimit'],\n  ['SERVER', 'retryCodeServer'],\n  ['TIMEOUT', 'retryCodeTimeout'],\n  ['TRANSPORT', 'retryCodeTransport'],\n  ['STREAM_CLOSED', 'retryCodeStreamClosed'],\n  ['MALFORMED_RESPONSE', 'retryCodeMalformedResponse'],\n  ['QUOTA', 'retryCodeQuota'],\n])\n\n/** Plain decimal text; prefixed forms such as `0x10` stay invalid text. */\nconst DECIMAL = /^[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:e[+-]?\\d+)?$/iu\n\n/** The pair `resolveRetryPolicy` orders beyond any single field bound: initial delay at most the maximum. */\nconst DELAY_ORDER = [['backoff', 'initialDelayMs'], ['backoff', 'maxDelayMs']] as const\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value)\n}\n\n/** Read a nested field of a plain policy object. */\nfunction fieldAt(value: Record<string, unknown>, path: readonly string[]): unknown {\n  return path.reduce<unknown>((node, key) => isRecord(node) ? node[key] : undefined, value)\n}\n\n/** The mode a union branch selects, read from its `mode` constant. */\nfunction modeOf(branch: SchemaNode): string | undefined {\n  const mode: unknown = branch.dict?.['mode']?.value\n  return typeof mode === 'string' ? mode : undefined\n}\n\n/** The constant choices a list field's item schema publishes, in schema order. */\nfunction choicesOf(node: SchemaNode): string[] {\n  // A union item always carries `list`; any other item publishes no choices.\n  return (node.inner?.list ?? []).flatMap((branch) => {\n    const value: unknown = branch.type === 'const' ? branch.value : undefined\n    return typeof value === 'string' ? [value] : []\n  })\n}\n\n/** The editable fields of one object node, in schema order, without the `mode` discriminant. */\nfunction fieldsOf(node: SchemaNode): [string, SchemaNode][] {\n  /* v8 ignore next -- object schema nodes always carry `dict` */\n  return Object.entries(node.dict ?? {}).filter(([key]) => key !== 'mode')\n}\n\n/** The inherited policy beneath the user layer, and the schema branch of each mode. */\nexport interface RetryPolicyDefaults {\n  /** Modes in schema order. */\n  modes: readonly string[]\n  /** Mode in effect when the user layer names none. */\n  mode: string\n  /** Schema branch of a stored `mode` value, or undefined when no branch declares it. */\n  branch: (mode: unknown) => SchemaNode | undefined\n  /** Inherited value of one field of a branch: the composition layer, then the branch default. */\n  value: (branch: SchemaNode, path: readonly string[]) => unknown\n}\n\n/**\n * Resolve the modes and inherited policy beneath the user layer.\n * @param schema - settings schema operations.\n * @param node - the `retryPolicy` schema union.\n * @param inherited - the policy the composition layer sets, if any.\n * @returns the modes and the inherited mode and field values.\n */\nexport function retryPolicyDefaults(\n  schema: SettingsSchemaOperations,\n  node: SchemaNode,\n  inherited: unknown,\n): RetryPolicyDefaults {\n  // A schema that is not a union of mode branches has no `list` and offers no mode.\n  const branches = new Map((node.list ?? []).flatMap((branch) => {\n    const mode = modeOf(branch)\n    return mode === undefined ? [] : [[mode, branch] as const]\n  }))\n  const modes = [...branches.keys()]\n  const stored = schema.getPath(inherited, ['mode'])\n  return {\n    modes,\n    mode: typeof stored === 'string' && branches.has(stored) ? stored : modes[0] ?? '',\n    branch: mode => typeof mode === 'string' ? branches.get(mode) : undefined,\n    value: (branch, path) => {\n      const value = schema.getPath(inherited, path)\n      if (value !== undefined) return value\n      const fallback: unknown = schema.nodeAtPath(branch, path)?.meta.default\n      return fallback\n    },\n  }\n}\n\n/** A refused drafted policy: the message and, when one field causes it, that field. */\nexport interface RetryPolicyFailure {\n  message: string\n  path?: readonly string[]\n}\n\n/** The first bound of a number field's schema that `value` breaks, as copy. */\nfunction numberFailure(node: SchemaNode, value: unknown, t: (key: ModelsKey) => string): string | undefined {\n  if (typeof value !== 'number' || !Number.isFinite(value)) return t('retryValueNumber')\n  const { min, max, step } = node.meta\n  if (step === 1 && !Number.isInteger(value)) return t('retryValueInteger')\n  // `Number.MIN_VALUE` is the schema idiom for a positive bound.\n  if (min === Number.MIN_VALUE && value <= 0) return t('retryValuePositive')\n  if (typeof min === 'number' && value < min) return t('retryValueMin').replace('{min}', () => String(min))\n  if (typeof max === 'number' && value > max) return t('retryValueMax').replace('{max}', () => String(max))\n  return undefined\n}\n\n/**\n * The first refused field of a drafted policy, checked against the selected\n * branch's field bounds with empty fields inherited, then against the\n * cross-field rules `resolveRetryPolicy` enforces beyond the schema, then\n * against the whole schema.\n * @param schema - settings schema operations.\n * @param node - the `retryPolicy` schema union.\n * @param policy - the drafted user-layer policy; undefined inherits.\n * @param defaults - the inherited policy beneath the draft.\n * @param t - section copy.\n * @returns the failure, or undefined when the policy is valid.\n */\nexport function retryPolicyFailure(\n  schema: SettingsSchemaOperations,\n  node: SchemaNode,\n  policy: unknown,\n  defaults: RetryPolicyDefaults,\n  t: (key: ModelsKey) => string,\n): RetryPolicyFailure | undefined {\n  if (policy === undefined) return undefined\n  const whole = (): RetryPolicyFailure | undefined => {\n    const message = schema.validate(node, policy)\n    return message === undefined ? undefined : { message }\n  }\n  if (!isRecord(policy)) return whole()\n  const branch = defaults.branch(policy['mode'])\n  if (branch === undefined) return whole()\n  const read = (path: readonly string[]): unknown => schema.getPath(policy, path) ?? defaults.value(branch, path)\n  const check = (owner: SchemaNode, base: readonly string[]): RetryPolicyFailure | undefined => {\n    for (const [key, field] of fieldsOf(owner)) {\n      const path = [...base, key]\n      if (field.type === 'object') {\n        const nested = check(field, path)\n        if (nested !== undefined) return nested\n      } else if (field.type === 'number') {\n        const value = read(path)\n        // A field with neither a value nor a default is left to the schema check below.\n        const message = value === undefined ? undefined : numberFailure(field, value, t)\n        if (message !== undefined) return { message, path }\n      } else if (field.type === 'array') {\n        const stored = schema.getPath(policy, path)\n        if (stored === undefined) continue\n        if (schema.validate(field, stored) !== undefined) return { message: t('retryCodesInvalid'), path }\n        if (Array.isArray(stored) && new Set(stored).size !== stored.length) return { message: t('retryCodesDuplicate'), path }\n      }\n    }\n    return undefined\n  }\n  const failure = check(branch, [])\n  if (failure !== undefined) return failure\n  const [lowerPath, upperPath] = DELAY_ORDER\n  const lower = read(lowerPath)\n  const upper = read(upperPath)\n  if (typeof lower === 'number' && typeof upper === 'number' && lower > upper) {\n    return { message: t('retryDelayOrder'), path: lowerPath }\n  }\n  return whole()\n}\n\n/** Props of {@link RetryPolicyEditor}. */\nexport interface RetryPolicyEditorProps {\n  /** Drafted user-layer policy; undefined inherits. */\n  policy: unknown\n  /** Inherited policy and schema branches beneath the draft. */\n  defaults: RetryPolicyDefaults\n  /** Failure from {@link retryPolicyFailure}. */\n  failure: RetryPolicyFailure | undefined\n  /** Id of the element showing the failure message. */\n  failureId: string\n  /** Show the failure message below the fields; otherwise the owner shows it. */\n  showFailure: boolean\n  /** Section copy. */\n  t: (key: ModelsKey) => string\n  /** Disable edits. */\n  disabled: boolean\n  /** Replace the drafted policy; undefined removes the user-layer policy. */\n  onChange: (next: Record<string, unknown> | undefined) => void\n}\n\nfunction textOf(value: unknown): string {\n  return typeof value === 'number' || typeof value === 'string' ? String(value) : ''\n}\n\n/** Set or remove one nested field of a plain policy object, dropping emptied parents. */\nfunction withField(policy: Record<string, unknown>, path: readonly string[], value: unknown): Record<string, unknown> {\n  const [key, ...rest] = path\n  /* v8 ignore next -- paths come from schema fields and are never empty */\n  if (key === undefined) return policy\n  const result = { ...policy }\n  const prior = result[key]\n  const next = rest.length === 0 ? value : withField(isRecord(prior) ? prior : {}, rest, value)\n  if (next === undefined || (isRecord(next) && Object.keys(next).length === 0)) Reflect.deleteProperty(result, key)\n  else result[key] = next\n  return result\n}\n\n/**\n * Render the retry mode and its policy fields.\n * @param props - drafted policy, inherited values, and the draft writer.\n * @returns the retry-policy field group.\n */\nexport function RetryPolicyEditor(props: RetryPolicyEditorProps): ReactNode {\n  const { t, disabled, defaults, failure } = props\n  const current = isRecord(props.policy) ? props.policy : {}\n  const branch = defaults.branch(current['mode'])\n  const mode = branch === undefined ? undefined : String(current['mode'])\n  // Raw text keeps partial input such as `0.` visible while it is typed.\n  const [texts, setTexts] = useState<Record<string, string>>({})\n  const [added, setAdded] = useState<Record<string, readonly string[]>>({})\n  // A nested fold starts open only when the draft already customizes it.\n  const [openFolds] = useState(() => new Set(Object.keys(current).filter(key => isRecord(current[key]))))\n  const label = (key: string): string => {\n    const labelKey = LABELS.get(key)\n    return labelKey === undefined ? key : t(labelKey)\n  }\n  const invalidAt = (path: readonly string[]): boolean => failure?.path?.join('.') === path.join('.')\n  const numberField = (root: SchemaNode, path: readonly string[], node: SchemaNode, className: string | undefined): ReactNode => {\n    const id = path.join('.')\n    const invalid = invalidAt(path)\n    const storedValue = fieldAt(current, path)\n    return (\n      <label key={id} className={className}>\n        <span className={styles['modelFieldLabel']}>{label(path[path.length - 1] as string)}</span>\n        <input\n          className={styles['input']}\n          type=\"text\"\n          inputMode={node.meta.step === 1 ? 'numeric' : 'decimal'}\n          value={texts[id] ?? textOf(storedValue)}\n          placeholder={textOf(defaults.value(root, path))}\n          aria-invalid={invalid}\n          aria-describedby={invalid ? props.failureId : undefined}\n          disabled={disabled}\n          onChange={(event) => {\n            const trimmed = event.target.value.trim()\n            setTexts(previous => ({ ...previous, [id]: trimmed.length === 0 ? '' : event.target.value }))\n            const value = DECIMAL.test(trimmed) ? Number(trimmed) : trimmed\n            props.onChange(withField(current, path, value === '' ? undefined : value))\n          }}\n        />\n      </label>\n    )\n  }\n  const codesField = (root: SchemaNode, path: readonly string[], node: SchemaNode): ReactNode => {\n    const id = path.join('.')\n    const strings = (value: unknown): string[] => Array.isArray(value) ? value.filter(code => typeof code === 'string') : []\n    const inherited = strings(defaults.value(root, path))\n    const storedCodes = fieldAt(current, path)\n    const selected = Array.isArray(storedCodes) ? strings(storedCodes) : inherited\n    // Codes added during this edit stay listed after they are unchecked.\n    const choices = [...new Set([...choicesOf(node), ...inherited, ...selected, ...added[id] ?? []])]\n    const invalid = invalidAt(path)\n    const select = (next: readonly string[]): void => {\n      // Selecting exactly the inherited codes keeps the field inherited.\n      const inherits = next.length === inherited.length && next.every(value => inherited.includes(value))\n      props.onChange(withField(current, path, inherits ? undefined : [...next]))\n    }\n    const draftCode = (texts[id] ?? '').trim()\n    const add = (): void => {\n      if (draftCode.length === 0) return\n      setAdded(previous => ({ ...previous, [id]: [...new Set([...previous[id] ?? [], draftCode])] }))\n      setTexts(previous => ({ ...previous, [id]: '' }))\n      if (!selected.includes(draftCode)) select([...selected, draftCode])\n    }\n    return (\n      <fieldset\n        key={path.join('.')}\n        className={styles['modelInputTypes']}\n        aria-invalid={invalid}\n        aria-describedby={invalid ? props.failureId : undefined}\n      >\n        <legend className={styles['modelFieldLabel']}>{label(path[path.length - 1] as string)}</legend>\n        <div className={styles['retryCodeChoices']}>\n          {choices.map((code) => {\n            const labelKey = CODE_LABELS.get(code)\n            return (\n              <Checkbox\n                key={code}\n                // A code the list does not name shows verbatim.\n                label={labelKey === undefined ? code : t(labelKey)}\n                checked={selected.includes(code)}\n                disabled={disabled || (selected.length === 1 && selected.includes(code))}\n                onChange={(checked) => {\n                  select(choices.filter(value => value === code ? checked : selected.includes(value)))\n                }}\n              />\n            )\n          })}\n        </div>\n        <div className={styles['retryCodeAdd']}>\n          <input\n            className={styles['input']}\n            type=\"text\"\n            value={texts[id] ?? ''}\n            placeholder={t('retryCodeCustom')}\n            aria-label={t('retryCodeCustom')}\n            disabled={disabled}\n            onChange={(event) => {\n              const value = event.target.value\n              setTexts(previous => ({ ...previous, [id]: value }))\n            }}\n            onKeyDown={(event) => {\n              // Enter that confirms an IME composition belongs to the composition.\n              if (event.key !== 'Enter' || event.nativeEvent.isComposing) return\n              // Enter adds the code; it never submits the settings form.\n              event.preventDefault()\n              add()\n            }}\n          />\n          <button\n            type=\"button\"\n            className={styles['secondaryButton']}\n            disabled={disabled || draftCode.length === 0}\n            onClick={add}\n          >\n            {t('retryCodeAdd')}\n          </button>\n        </div>\n      </fieldset>\n    )\n  }\n  // Top-level number fields share the width of one nested column so they line up with it.\n  const fields = (root: SchemaNode, owner: SchemaNode, base: readonly string[]): ReactNode[] => fieldsOf(owner).map(([key, node]) => {\n    const path = [...base, key]\n    if (node.type === 'number') {\n      return numberField(root, path, node, base.length === 0 ? `${styles['modelField']} ${styles['retryCount']}` : styles['modelField'])\n    }\n    if (node.type === 'array') return codesField(root, path, node)\n    if (node.type === 'object') {\n      return (\n        <details key={key} className={styles['retryFold']} open={openFolds.has(key)}>\n          <summary className={styles['customizedSummary']}>{label(key)}</summary>\n          <div className={styles['retryBackoff']}>{fields(root, node, path)}</div>\n        </details>\n      )\n    }\n    return null\n  })\n  const labelId = `${props.failureId}-label`\n  const hint = mode === undefined ? undefined : MODE_HINTS.get(mode)\n  return (\n    <div className={styles['field']} role=\"group\" aria-labelledby={labelId}>\n      <span id={labelId} className={styles['fieldLabel']}>{t('retryPolicy')}</span>\n      <select\n        className={`${styles['input']} ${styles['selectInput']}`}\n        value={mode ?? ''}\n        aria-labelledby={labelId}\n        aria-describedby={failure !== undefined && failure.path === undefined ? props.failureId : undefined}\n        disabled={disabled}\n        onChange={(event) => {\n          const next = defaults.branch(event.target.value)\n          setTexts({})\n          if (next === undefined) {\n            props.onChange(undefined)\n            return\n          }\n          // A switched policy keeps only the fields its new mode declares.\n          const declared = new Set(fieldsOf(next).map(([key]) => key))\n          const kept = Object.fromEntries(Object.entries(current).filter(([key]) => declared.has(key)))\n          props.onChange({ ...kept, mode: event.target.value })\n        }}\n      >\n        <option value=\"\">{t('retryModeDefault').replace('{mode}', () => label(defaults.mode))}</option>\n        {defaults.modes.map(value => <option key={value} value={value}>{label(value)}</option>)}\n      </select>\n      {hint === undefined ? null : <span className={styles['advancedHint']}>{t(hint)}</span>}\n      {branch === undefined ? null : <div className={styles['retryBody']}>{fields(branch, branch, [])}</div>}\n      {failure === undefined || !props.showFailure\n        ? null\n        : <p id={props.failureId} className={styles['error']}>{failure.message}</p>}\n    </div>\n  )\n}\n","/**\n * One provider's editor card, hand-written per adapter family: the primary\n * field is a single write-only **API key** input (the page never asks for an\n * environment-variable name — a typed key stores through `credentials/set`\n * under the profile's reference, deriving `<ROUTE>_API_KEY` when the profile\n * has none. The pi-ai profile records that derivation as `apiKeyEnv` only when\n * a key is entered; a blank key materializes a reference-free profile for\n * provider-native authentication);\n * the collapsed 自定义设置 area carries the per-family extras (`baseURL` and\n * `retryPolicy` for both families, DeepSeek's id/name/context-window model\n * catalog, and the display name and wire protocol of a pi-ai route the\n * adapter does not ship — the two fields the create card asked that route\n * for, editable here for the same reason).\n * Reasoning effort is deliberately absent: it is a per-MODEL capability, and\n * the models under one provider disagree about it, so a provider-scoped\n * control can only be set to a value some of them reject. The composer's\n * model picker offers each model its own levels; `cordis.patch.yml` keeps the\n * profile field for a deployment that knows its route. Everything else stays\n * owned by `cordis.patch.yml`. Profile edits land as minimal `settings.mutate`\n * path ops against the stored section — the card names only the fields it can\n * see instead of rebuilding the whole subtree from a partial descriptor.\n */\n\nimport { useEffect, useMemo, useState } from 'react'\nimport type { ReactNode } from 'react'\nimport type { CredentialInfo, LlmNativeAuth, SettingsNamespaceView, SettingsPathOpView } from '@deepseek-ai/dsh-api-remotes/client'\nimport type { JsonValue } from '@deepseek-ai/dsh-util-values'\nimport { Tooltip } from '@deepseek-ai/dsh-client-ui-primitives'\nimport {\n  DeepSeekModelsEditor, modelDrafts, validateDeepSeekModels,\n} from './DeepSeekModelsEditor.tsx'\nimport type { DeepSeekModelsValidationFailure } from './DeepSeekModelsEditor.tsx'\nimport { apiKeyFailure } from './apiKey.ts'\nimport { EditorFooter } from './EditorFooter.tsx'\nimport { ModelListEditor } from './ModelListEditor.tsx'\nimport { validateReasoningEfforts } from './ModelReasoningEfforts.tsx'\nimport type { ReasoningEffortsFailure } from './ModelReasoningEfforts.tsx'\nimport { deriveKeyRef, protocolChoices, reasoningLevelChoices } from './store.ts'\nimport { protocolLabel } from './protocol-label.ts'\nimport { protocolNeedsKey, protocolReasoningLevels } from './protocol-rules.ts'\nimport type { ModelsOperations } from './operations.ts'\nimport type { SettingsSchemaOperations } from './schema-operations.ts'\nimport type { en } from './locales.ts'\nimport { ApiKeyInput } from './ApiKeyInput.tsx'\nimport { RetryPolicyEditor, retryPolicyDefaults, retryPolicyFailure } from './RetryPolicyEditor.tsx'\nimport styles from './ModelsSection.module.css'\n\n/** Per-adapter-family curated field sets (unknown namespaces get the hint alone). */\ntype EditorLayout = 'deepseek' | 'pi-ai' | 'unknown'\n\n\n\n/** Props of {@link ProviderEditor}. */\nexport interface ProviderEditorProps {\n  /** Provider route id. */\n  provider: string\n  /** Display name for the card title. */\n  displayName: string\n  /** Hide the title row (the add card renders its own provider select). */\n  hideTitle?: boolean\n  /**\n   * Whether the adapter reports this route as hand-declared — absent from its\n   * installed catalog. Such a route carries its own wire protocol, chosen when\n   * it was created and editable here for the same reason; a catalog route's\n   * models each carry theirs, so a route-level protocol there could only\n   * override every one of them and the card does not offer it.\n   */\n  declared?: boolean\n  /** The owning namespace view (schema, layers, secrets). */\n  namespace: SettingsNamespaceView\n  /** Settings-owned synchronous schema and immutable path operations. */\n  schema: SettingsSchemaOperations\n  /** Path from the section root to this provider's profile. */\n  settingsPath: readonly string[]\n  /** The Host operations this card writes and interrogates through. */\n  operations: ModelsOperations\n  /** Endpoint the route uses when its profile sets no `baseURL`; absent when the adapter reports none. */\n  defaultBaseURL?: string\n  /** Environment variables used by the provider to construct its endpoint. */\n  baseURLEnv?: readonly string[]\n  /** Authentication the route performs when its profile names no credential reference; absent when the adapter reports none. */\n  nativeAuth?: LlmNativeAuth\n  /** Redacted state of the profile's named credential reference, from the page snapshot. */\n  credential?: CredentialInfo\n  /** Redacted checks for the profile's named reference or the provider's native variables. */\n  credentialChecks?: Readonly<Record<string, CredentialInfo>>\n  /** Section copy. */\n  t: (key: keyof typeof en) => string\n  /** Disable writes (read-only settings provider). */\n  readOnly: boolean\n  /** Render only the credential field and actions, without provider settings. */\n  credentialOnly?: boolean\n  /** Require a newly entered credential before this editor can submit. */\n  credentialRequired?: boolean\n  /** Give the credential field initial focus when this editor mounts. */\n  autoFocusCredential?: boolean\n  /** Override the dismiss action copy. */\n  cancelLabelKey?: keyof typeof en\n  /** Override the idle commit action copy. */\n  submitLabelKey?: keyof typeof en\n  /** Override the in-flight commit action copy. */\n  submitBusyLabelKey?: keyof typeof en\n  /** Close the editor; `changed` reports whether an Apply committed. */\n  onClose: (changed: boolean) => void\n  /** Called on a credential form submission before the save starts. */\n  onSubmitCredential?: () => void\n  /**\n   * Called once per change with whether the apply or the model list's\n   * endpoint interrogation is in flight, so the owner can hold its surface\n   * still.\n   */\n  onBusyChange?: (busy: boolean) => void\n}\n\n/** A user-section subtree as a plain draft object (absent → empty). */\nfunction draftAt(\n  schema: SettingsSchemaOperations,\n  namespace: SettingsNamespaceView,\n  path: readonly string[],\n): Record<string, unknown> {\n  const subtree = schema.getPath(namespace.user, path)\n  if (typeof subtree !== 'object' || subtree === null || Array.isArray(subtree)) return {}\n  return structuredClone(subtree) as Record<string, unknown>\n}\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value)\n}\n\n/**\n * The minimal path ops carrying `after` over `before`, both as the card sees\n * them. Only keys the card observed are named; fields absent from both sides\n * produce no op, which is why edits are path-addressed rather than a rebuilt\n * section. Objects are diffed field by field, so an omitted field keeps the\n * value an unset restores from the inherited layer instead of a whole-object\n * set discarding it.\n * @param base - path of the edited subtree inside the user section.\n * @param before - the subtree as loaded, or undefined when it is new.\n * @param after - the subtree as edited.\n * @returns ordered set/unset ops; empty when nothing changed.\n */\nexport function pathOps(\n  base: readonly string[],\n  before: unknown,\n  after: Record<string, unknown>,\n): SettingsPathOpView[] {\n  const previous = isRecord(before) ? before : {}\n  const ops: SettingsPathOpView[] = []\n  for (const [key, value] of Object.entries(after)) {\n    const prior = previous[key]\n    if (JSON.stringify(prior) === JSON.stringify(value)) continue\n    if (isRecord(value) && (prior === undefined || isRecord(prior))) ops.push(...pathOps([...base, key], prior, value))\n    else ops.push({ op: 'set', path: [...base, key], value: value as JsonValue })\n  }\n  for (const key of Object.keys(previous)) {\n    if (!(key in after)) ops.push({ op: 'unset', path: [...base, key] })\n  }\n  return ops\n}\n\n/** The editor layout the owning namespace selects. */\nfunction layoutOf(ns: string): EditorLayout {\n  if (ns === 'llm-deepseek') return 'deepseek'\n  if (ns === 'llm-pi-ai') return 'pi-ai'\n  return 'unknown'\n}\n\n/** The credential reference this profile resolves keys through. */\nfunction refFor(\n  schema: SettingsSchemaOperations,\n  namespace: SettingsNamespaceView,\n  path: readonly string[],\n  provider: string,\n): string {\n  const profile = schema.getPath(namespace.value, path)\n  const named = typeof profile === 'object' && profile !== null\n    ? (profile as { apiKeyEnv?: unknown }).apiKeyEnv\n    : undefined\n  return typeof named === 'string' && named.length > 0 ? named : deriveKeyRef(provider)\n}\n\n/**\n * Render one provider's editing card.\n * @param props - the addressed profile plus wire faces and copy.\n * @returns the editor card.\n */\nexport function ProviderEditor(props: ProviderEditorProps): ReactNode {\n  const { namespace, schema, settingsPath, operations, t } = props\n  const [draft, setDraft] = useState<Record<string, unknown>>(() => {\n    const loaded = draftAt(schema, namespace, settingsPath)\n    const policy = loaded['retryPolicy']\n    // A stored retry policy without a mode edits under the mode it inherits;\n    // the draft names it so a saved policy always carries one.\n    if (!isRecord(policy) || policy['mode'] !== undefined) return loaded\n    const path = [...settingsPath, 'retryPolicy']\n    const node = schema.nodeAtPath(schema.rehydrate(namespace.schema), path)\n    /* v8 ignore next -- a stored retryPolicy implies the schema declares one */\n    if (node === undefined) return loaded\n    const { mode } = retryPolicyDefaults(schema, node, schema.getPath(namespace.base, path))\n    return { ...loaded, retryPolicy: { ...policy, mode } }\n  })\n  // Undefined is untouched; strings hold new input and a reference stages removal.\n  const [keyDraft, setKeyDraft] = useState<string | { readonly ref: string; readonly removed?: true }>()\n  const keyText = typeof keyDraft === 'string' ? keyDraft : ''\n  const keyRemoval = typeof keyDraft === 'object' ? keyDraft : undefined\n  const [busy, setBusy] = useState(false)\n  const [listBusy, setListBusy] = useState(false)\n  const { onBusyChange } = props\n  useEffect(() => { onBusyChange?.(busy || listBusy) }, [busy, listBusy, onBusyChange])\n  const [failure, setFailure] = useState<string | undefined>(undefined)\n  const [customizedOpen, setCustomizedOpen] = useState(false)\n  // A settings success advances both retry baselines immediately. Keeping the\n  // derived fields in the draft prevents a pushed namespace refresh from\n  // turning them into deletions when the following credential write is retried.\n  const [committedOriginal, setCommittedOriginal] = useState<unknown>(\n    () => schema.getPath(namespace.user, settingsPath),\n  )\n  const [expectedRevision, setExpectedRevision] = useState(() => namespace.revision)\n  const root = useMemo(() => schema.rehydrate(namespace.schema), [namespace.schema, schema])\n  const node = useMemo(() => schema.nodeAtPath(root, settingsPath), [root, schema, settingsPath])\n  const fallback = schema.getPath(namespace.value, settingsPath)\n  const disabled = props.readOnly || busy\n  const layout = layoutOf(namespace.ns)\n  const keyRef = refFor(schema, namespace, settingsPath, props.provider)\n  // The same schema read the create card makes, so the choices offered here\n  // and there cannot drift apart: both come from the adapter's own `Config`.\n  // Only the pi-ai layout has a per-route protocol for the read to find, and\n  // it rehydrates the whole section schema, so the other layouts skip it.\n  const protocols = useMemo(\n    () => layout === 'pi-ai' ? protocolChoices(namespace, schema) : [],\n    [layout, namespace, schema],\n  )\n\n  const stringAt = (source: unknown, key: string): string | undefined => {\n    const value = schema.getPath(source, [key])\n    return typeof value === 'string' && value.trim().length > 0 ? value : undefined\n  }\n  const setField = (key: string, next: string | undefined): void => {\n    // A value of nothing but whitespace is cleared, not stored: `stringAt`\n    // already reports it as absent, so the field would otherwise render empty\n    // while the draft still carried the spaces into `cordis.patch.yml`, where\n    // both adapters would accept that non-empty string as a real value.\n    const value = next === undefined || next.trim().length === 0 ? undefined : next\n    setDraft(current => value === undefined\n      ? schema.deletePath(current, [key])\n      : schema.setPath(current, [key], value))\n  }\n  const clearsDerivedRef = keyRemoval !== undefined && layout === 'pi-ai'\n    && props.nativeAuth !== undefined && stringAt(draft, 'apiKeyEnv') === deriveKeyRef(props.provider)\n\n  // The model list is validated by the same per-row checker for both families,\n  // so a bad row is named by its position rather than by a blanket message.\n  // Only a hand-declared pi-ai route's rows edit reasoning levels — the one\n  // model list with no installed catalog behind it — so only there are the\n  // levels read and the declarations checked.\n  const schemaReasoningLevels = useMemo(\n    () => layout === 'pi-ai' && props.declared === true ? reasoningLevelChoices(namespace, schema) : [],\n    [layout, props.declared, namespace, schema],\n  )\n  // What the form currently shows, which is what an interrogation must ask and\n  // what decides the protocol's own constraints: an edited-but-unsaved protocol.\n  const probeApi = stringAt(draft, 'api') ?? stringAt(fallback, 'api')\n  const reasoning = protocolReasoningLevels(probeApi, schemaReasoningLevels)\n  const editsReasoning = reasoning.levels.length > 0\n  const validateModels = (value: unknown): DeepSeekModelsValidationFailure | ReasoningEffortsFailure | undefined =>\n    validateDeepSeekModels(value)\n    ?? (editsReasoning ? validateReasoningEfforts(value, reasoning.levelsOnly ? reasoning.levels : undefined) : undefined)\n  // Inherited models are checked too where the protocol narrows their levels:\n  // switching an inherited route's protocol must not write a route its own models break.\n  const modelFailure = validateModels(schema.getPath(draft, ['models'])\n    ?? (reasoning.levelsOnly ? schema.getPath(fallback, ['models']) : undefined))\n  const retryNode = useMemo(\n    () => layout === 'unknown' ? undefined : schema.nodeAtPath(root, [...settingsPath, 'retryPolicy']),\n    [layout, root, schema, settingsPath],\n  )\n  const retryDefaults = retryNode === undefined\n    ? undefined\n    : retryPolicyDefaults(schema, retryNode, schema.getPath(namespace.base, [...settingsPath, 'retryPolicy']))\n  const retryFailure = retryNode === undefined || retryDefaults === undefined || props.credentialOnly === true\n    ? undefined\n    : retryPolicyFailure(schema, retryNode, schema.getPath(draft, ['retryPolicy']), retryDefaults, t)\n  const keyFailure = apiKeyFailure(keyText)\n  // What a probe or a write must carry: the typed key with paste whitespace\n  // removed. A blank field yields an empty string, which both call sites read\n  // as \"no key supplied\" rather than as a key — that is how a card whose\n  // provider already has a stored key is edited without re-entering it.\n  const keyValue = keyText.trim()\n  // A route whose protocol cannot authenticate without a key needs a key reference or a typed key.\n  const protocolNeedsKeyHere = layout === 'pi-ai' && protocolNeedsKey(probeApi)\n    && stringAt(draft, 'apiKeyEnv') === undefined && stringAt(fallback, 'apiKeyEnv') === undefined\n  const protocolKeyMissing = protocolNeedsKeyHere && keyValue.length === 0\n  const credentialRequiredFailure = (props.credentialRequired === true\n    && keyText.length > 0 && keyValue.length === 0) || protocolKeyMissing\n    ? 'keyRequired' as const\n    : undefined\n  const shownKeyFailure = credentialRequiredFailure ?? keyFailure\n  // An edited-but-unsaved endpoint, and a key typed but not yet stored.\n  const probeBaseURL = stringAt(draft, 'baseURL') ?? stringAt(fallback, 'baseURL')\n  const probe = {\n    settingsNs: namespace.ns,\n    // Naming the route lets an adapter that already describes it answer from\n    // its own registry — better metadata, no network call, no endpoint needed.\n    provider: props.provider,\n    ...probeBaseURL === undefined ? {} : { baseURL: probeBaseURL },\n    ...probeApi === undefined ? {} : { api: probeApi },\n    ...keyValue.length === 0 ? {} : { apiKey: keyValue },\n  }\n  /**\n   * The write for this card, or a failure message. Every edit travels as\n   * path ops against the STORED section: the draft comes from the redacted\n   * descriptor, so a wholesale replace rebuilt from it could delete fields\n   * outside the card. Ops name only the fields this card can see.\n   */\n  const applyOnce = async (): Promise<string | undefined> => {\n    const ns = namespace.ns\n    // Removing a catalog route's conventional reference restores native auth.\n    // Other aliases and custom routes keep their named environment fallback.\n    const profileDraft = clearsDerivedRef ? schema.deletePath(draft, ['apiKeyEnv']) : draft\n    // A pi-ai profile names the conventional reference only when this page is\n    // about to store a key. Otherwise the provider keeps its native auth path.\n    const next = layout === 'pi-ai' && stringAt(profileDraft, 'apiKeyEnv') === undefined\n      && stringAt(schema.getPath(namespace.base, settingsPath), 'apiKeyEnv') === undefined && keyValue.length > 0\n      ? schema.setPath(profileDraft, ['apiKeyEnv'], keyRef)\n      : profileDraft\n    if (props.credentialOnly !== true) {\n      // The same checker gates the submit button, so a card cannot reach this\n      // with a bad row; it stays because the schema check below would refuse\n      // the write with a message naming a path instead of the row, and because\n      // nothing but this function decides what is written.\n      const failure = validateModels(schema.getPath(next, ['models']))\n      /* v8 ignore next 3 -- unreachable from the card: the same failure disables submit */\n      if (failure !== undefined) {\n        return `${t('model')} ${String(failure.index + 1)}: ${t(failure.key)}`\n      }\n    }\n    /* v8 ignore next -- apply is only reachable from the rendered card, which required a resolved node */\n    if (props.credentialOnly !== true && node !== undefined && settingsPath.length === 0) {\n      const sectionError = schema.validate(node, next)\n      if (sectionError !== undefined) return sectionError\n    }\n    const materializesNativeProfile = layout === 'pi-ai'\n      && fallback === undefined\n      && committedOriginal === undefined\n      && Object.keys(next).length === 0\n    const ops: SettingsPathOpView[] = props.credentialOnly === true\n      ? []\n      : materializesNativeProfile\n        ? [{ op: 'set', path: [...settingsPath], value: {} }]\n        : pathOps(settingsPath, committedOriginal, next)\n    if (keyRemoval !== undefined && keyRemoval.removed !== true) {\n      const removed = await operations.removeCredential(keyRemoval.ref)\n      if (removed !== undefined) return removed\n      // A later settings failure cannot restore a secret that was deleted.\n      setKeyDraft({ ...keyRemoval, removed: true })\n    }\n    if (ops.length > 0) {\n      const written = await operations.writeSettings(ns, ops, expectedRevision)\n      if (written.kind !== 'written') return written.kind === 'conflict' ? t('conflict') : written.message\n      setCommittedOriginal(schema.getPath(written.view.user, settingsPath))\n      setExpectedRevision(written.view.revision)\n      setDraft(next)\n    }\n    if (keyValue.length > 0) {\n      const stored = await operations.storeCredential(keyRef, keyValue)\n      if (stored !== undefined) return stored\n    }\n    setKeyDraft('')\n    return undefined\n  }\n\n  const apply = async (): Promise<void> => {\n    setBusy(true)\n    setFailure(undefined)\n    try {\n      const failure = await applyOnce()\n      if (failure !== undefined) {\n        setFailure(failure)\n        return\n      }\n      props.onClose(true)\n    } finally {\n      setBusy(false)\n    }\n  }\n\n  if (node === undefined) {\n    // A directory entry addressing a position its schema cannot resolve is a\n    // host-side inconsistency; showing it beats a blank card.\n    return <p className={styles['error']}>{props.provider}: {props.t('settingsPathUnresolvable')}</p>\n  }\n\n  /**\n   * The catalog beneath the user layer: what the composition entry pinned, or\n   * else the schema default that `resolve` would supply. The effective value\n   * cannot answer this — it still carries the stored override until the unset\n   * is applied, so reading it would echo that override straight back the\n   * moment reset drops it, leaving the rows unchanged until a reload.\n   */\n  const inheritedModels = (): unknown => {\n    const pinned = schema.getPath(namespace.base, [...settingsPath, 'models'])\n    return pinned ?? schema.nodeAtPath(root, [...settingsPath, 'models'])?.meta.default\n  }\n\n  /**\n   * The curated fields of one known adapter family. The family arrives\n   * narrowed so the per-family branches below are total: an unknown namespace\n   * renders the hint instead and never reaches this body.\n   */\n  const curatedFields = (family: 'deepseek' | 'pi-ai'): ReactNode => {\n    // What a hand-declared route names for itself and nothing else can supply.\n    // A whole-section `llm-deepseek` profile is a composition