t function createPanelPins(): PanelPins {\n  const store = createSnapshotStore<{ readonly unpinned: readonly string[] }>({ unpinned: NO_PANELS })\n  return {\n    unpinned: { getSnapshot: () => store.getSnapshot().unpinned, subscribe: listener => store.subscribe(listener) },\n    setPinned: (id, pinned) => {\n      const current = store.getSnapshot().unpinned\n      if (id === FIXED_PANEL_ID || pinned !== current.includes(id)) return\n      store.set({ unpinned: pinned ? current.filter(entry => entry !== id) : [...current, id] })\n    },\n  }\n}\n","/** Window-chrome controls for the fully hidden sidebar (frame shell.leading seat). */\nimport {\n  IconNewChatOutlineRegular, IconPanelLeftOutlineRegular, Tooltip,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'\n// Type-only: pulls the frame's shell.leading slot declaration.\nimport type {} from '@deepseek-ai/dsh-client-ui-layout/client'\nimport type { SidebarRootInjected } from './contract/slots.ts'\nimport css from './HeaderLeadingControls.module.css'\n\n/** Full props of the shell.leading occupant. */\nexport type HeaderLeadingControlsProps =\n  PropsRuntime<'shell.leading'>\n  & InjectFace<SidebarRootInjected>\n  & PropsLocale<'sidebar'>\n\n/**\n * Sidebar-open and New Session controls in the frame's window-chrome seat.\n * The frame mounts this seat for hidden sidebars and owns its placement.\n * Web shows only the sidebar opener; Desktop also retains New Session.\n * @param props - Injected sidebar actions, the global access Hook, and the sidebar locale seat.\n * @returns the sidebar toggle, plus New Session on Desktop while access allows `session/create`.\n */\nexport function HeaderLeadingControls({\n  toggleSidebar, startSession, trackEntryClick, useRemoteAccess, useShortcuts, t,\n}: HeaderLeadingControlsProps) {\n  // A page whose access snapshot excludes starting a Session keeps only the sidebar toggle here.\n  const canStartSession = useRemoteAccess('session/create')\n  const desktop = document.documentElement.hasAttribute('data-platform')\n  const shortcut = useShortcuts(rows => rows.find(row => row.id === 'sidebar.left.toggle'))\n  const newShortcut = useShortcuts(rows => rows.find(row => row.id === 'session.new'))\n  return (\n    <div className={css.controls}>\n      <Tooltip label={t('toggle.open')} shortcutKeys={shortcut?.keys} delayMs={500}>\n        <button\n          data-sidebar-opener\n          type=\"button\"\n          className={css.iconButton}\n          aria-label={t('toggle.open')}\n          aria-keyshortcuts={shortcut?.aria}\n          onClick={() => { toggleSidebar() }}\n        >\n          <IconPanelLeftOutlineRegular size={16} />\n        </button>\n      </Tooltip>\n      {desktop && canStartSession && (\n        <Tooltip label={t('session.new.label')} shortcutKeys={newShortcut?.keys} delayMs={500}>\n          <button\n            type=\"button\"\n            className={css.iconButton}\n            aria-label={t('session.new.label')}\n            aria-keyshortcuts={newShortcut?.aria}\n            onClick={() => {\n              trackEntryClick({ menu_name: 'new_session', position: 'titlebar' })\n              startSession()\n            }}\n          >\n            <IconNewChatOutlineRegular size={16} />\n          </button>\n        </Tooltip>\n      )}\n    </div>\n  )\n}\n","function r(e){var t,f,n=\"\";if(\"string\"==typeof e||\"number\"==typeof e)n+=e;else if(\"object\"==typeof e)if(Array.isArray(e)){var o=e.length;for(t=0;t<o;t++)e[t]&&(f=r(e[t]))&&(n&&(n+=\" \"),n+=f)}else for(f in e)e[f]&&(n&&(n+=\" \"),n+=f);return n}export function clsx(){for(var e,t,f=0,n=\"\",o=arguments.length;f<o;f++)(e=arguments[f])&&(t=r(e))&&(n&&(n+=\" \"),n+=t);return n}export default clsx;","/**\n * Wheel hand-off between the sidebar viewport and the section scroller below its navigation.\n * Scrolling down moves the navigation away before the section scroller moves; scrolling up\n * returns the section scroller to its top before the navigation reappears. A gesture whose\n * first event must move the viewport, or starts outside the section scroller, is split in\n * JavaScript until it ends, including its momentum; both elements are then written\n * synchronously in each event, so one gesture continues across the boundary. A gesture the\n * section scroller can take alone keeps native scrolling.\n *\n * A drag over the viewport scrolls the same way when the pointer nears the top or bottom edge\n * of the visible scrolling area, because wheel scrolling is unreliable during a native drag and\n * WebKit and Firefox do not autoscroll a section scroller nested in the viewport.\n */\nimport type { RefCallback } from 'react'\nimport type { SectionScroller, UseSectionScroller } from './contract/slots.ts'\n\n/** Sidebar-owned state of one hand-off. */\nexport interface ScrollHandoff {\n  /** Ref callback for the sidebar's own viewport; binds the wheel hand-off and the drag edge-scrolling listeners. */\n  readonly bindViewportRef: RefCallback<HTMLElement>\n  /** Hook handed to the `sidebar.workspaces` occupant through the slot's hookContext. */\n  readonly useSectionScroller: UseSectionScroller\n}\n\n/**\n * Wheel events closer together than this belong to one gesture, including its momentum phase.\n * DOM wheel events carry no gesture phase, so the gap stands in for it.\n */\nconst GESTURE_GAP_MS = 100\n\n/** Distance from the visible scrolling area's top or bottom edge within which a drag scrolls. */\nconst DRAG_EDGE_PX = 48\n\n/** Drag scrolling speed with the pointer on or past an edge; it falls linearly to zero across the edge band. */\nconst DRAG_MAX_SPEED_PX_PER_MS = 1\n\n/**\n * A drag that sends no `dragover` for this long has left without `dragleave`, `drop`, or `dragend`.\n * HTML drag processing repeats `dragover` every 350ms ±200ms while the pointer rests over a target.\n */\nconst DRAG_STALE_MS = 600\n\n/** Longest interval one drag frame scrolls for, so a delayed frame does not jump. */\nconst DRAG_MAX_STEP_MS = 50\n\n/**\n * Vertical wheel distance in pixels. Pinch-zoom and mostly horizontal events return undefined\n * and keep native scrolling.\n */\nfunction verticalWheelPixels(event: WheelEvent, page: number): number | undefined {\n  if (event.ctrlKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return undefined\n  if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16\n  if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * page\n  return event.deltaY\n}\n\n/** Scroll by `delta`; the browser clamps the write, and the moved distance is returned. */\nfunction scrollClamped(element: HTMLElement, delta: number): number {\n  const before = element.scrollTop\n  element.scrollTop = before + delta\n  return element.scrollTop - before\n}\n\n/**\n * Scroll `delta` across both elements: down moves the viewport before the section scroller,\n * up moves the section scroller before the viewport.\n */\nfunction scrollSplit(viewport: HTMLElement, scroller: HTMLElement | null, delta: number): void {\n  if (scroller === null) {\n    scrollClamped(viewport, delta)\n    return\n  }\n  if (delta > 0) {\n    const rest = delta - scrollClamped(viewport, delta)\n    if (rest > 0) scrollClamped(scroller, rest)\n    return\n  }\n  const rest = delta - scrollClamped(scroller, delta)\n  if (rest < 0) scrollClamped(viewport, rest)\n}\n\n/**\n * Drag scrolling velocity in pixels per millisecond for a pointer at `y`; positive scrolls down.\n * The edges are those of the section scroller's part inside the viewport, or of the viewport alone.\n */\nfunction dragVelocity(viewport: HTMLElement, scroller: HTMLElement | null, y: number): number {\n  const outer = viewport.getBoundingClientRect()\n  const inner = scroller?.getBoundingClientRect() ?? outer\n  const top = Math.max(outer.top, inner.top)\n  const bottom = Math.min(outer.bottom, inner.bottom)\n  const band = Math.min(DRAG_EDGE_PX, (bottom - top) / 2)\n  if (band <= 0) return 0\n  const speed = (depth: number): number => DRAG_MAX_SPEED_PX_PER_MS * Math.min(1, depth / band)\n  if (y < top + band) return -speed(top + band - y)\n  if (y > bottom - band) return speed(y - (bottom - band))\n  return 0\n}\n\n/** Whether the viewport has scrolled the navigation away; sub-pixel remainders count as the end. */\nfunction atEnd(viewport: HTMLElement): boolean {\n  return viewport.scrollHeight - viewport.clientHeight - viewport.scrollTop < 1\n}\n\n/**\n * Create the hand-off for one sidebar render tree.\n * @returns The viewport ref callback and the occupant hook; both keep their identity.\n */\nexport function createScrollHandoff(): ScrollHandoff {\n  let scroller: HTMLElement | null = null\n  let releaseViewport: (() => void) | undefined\n  let lastSplit = Number.NEGATIVE_INFINITY\n  const handle = (viewport: HTMLElement, event: WheelEvent): void => {\n    if (scroller === null || event.defaultPrevented) return\n    const delta = verticalWheelPixels(event, viewport.clientHeight)\n    if (delta === undefined || delta === 0) return\n    // A gesture split here stays here: native scrolling does not resume within its momentum.\n    const continuing = event.cancelable && event.timeStamp - lastSplit < GESTURE_GAP_MS\n    if (!continuing) {\n      // With the navigation gone, the section scroller under the pointer takes this step natively.\n      const native = atEnd(viewport) && scroller.contains(event.target as Node | null)\n      if (native && (delta > 0 || scroller.scrollTop + delta >= 0)) return\n      if (!event.cancelable) {\n        // A native gesture latched to the section scroller stops at its top; the viewport takes the rest.\n        if (native) scrollClamped(viewport, delta + scroller.scrollTop)\n        return\n      }\n    }\n    event.preventDefault()\n    lastSplit = event.timeStamp\n    scrollSplit(viewport, scroller, delta)\n  }\n  // The pointer of the latest dragover and the frame loop that scrolls toward it.\n  let drag: { y: number; at: number } | undefined\n  let frame: number | undefined\n  let lastFrame = 0\n  const stopDrag = (): void => {\n    drag = undefined\n    if (frame !== undefined) cancelAnimationFrame(frame)\n    frame = undefined\n  }\n  const step = (viewport: HTMLElement, now: number): void => {\n    frame = undefined\n    if (drag === undefined || now - drag.at > DRAG_STALE_MS) {\n      drag = undefined\n      return\n    }\n    const velocity = dragVelocity(viewport, scroller, drag.y)\n    if (velocity === 0) return\n    // A frame timestamp can precede the performance.now() of the dragover that requested it.\n    scrollSplit(viewport, scroller, velocity * Math.min(Math.max(now - lastFrame, 0), DRAG_MAX_STEP_MS))\n    lastFrame = now\n    frame = requestAnimationFrame((time) => { step(viewport, time) })\n  }\n  const dragOver = (viewport: HTMLElement, event: DragEvent): void => {\n    drag = { y: event.clientY, at: performance.now() }\n    if (frame !== undefined || dragVelocity(viewport, scroller, event.clientY) === 0) return\n    lastFrame = drag.at\n    frame = requestAnimationFrame((time) => { step(viewport, time) })\n  }\n  const sectionScroller: SectionScroller = {\n    bindScrollerRef: (element) => { scroller = element },\n  }\n  return {\n    bindViewportRef: (element) => {\n      releaseViewport?.()\n      releaseViewport = undefined\n      if (element === null) return\n      const onWheel = (event: WheelEvent): void => { handle(element, event) }\n      const onDragOver = (event: DragEvent): void => { dragOver(element, event) }\n      const onDragLeave = (event: DragEvent): void => {\n        if (!element.contains(event.relatedTarget as Node | null)) stopDrag()\n      }\n      element.addEventListener('wheel', onWheel, { passive: false })\n      // Capture: drop targets inside the viewport stop dragover propagation.\n      element.addEventListener('dragover', onDragOver, true)\n      element.addEventListener('dragleave', onDragLeave, true)\n      element.addEventListener('drop', stopDrag, true)\n      element.addEventListener('dragend', stopDrag, true)\n      releaseViewport = () => {\n        stopDrag()\n        element.removeEventListener('wheel', onWheel)\n        element.removeEventListener('dragover', onDragOver, true)\n        element.removeEventListener('dragleave', onDragLeave, true)\n        element.removeEventListener('drop', stopDrag, true)\n        element.removeEventListener('dragend', stopDrag, true)\n      }\n    },\n    useSectionScroller: () => sectionScroller,\n  }\n}\n","/**\n * Sidebar shell: column geometry and global panel navigation.\n * Collapse is a slide plus crossfade:\n * content freezes at its expanded width (inline style) and fades out in place\n * while the sliding column (AppFrame grid tracks) clips it — nothing reflows\n * mid-slide. At settle the wide-only content unmounts and the upper\n * controls enter the 56px rail from the same horizontal offset (one icon each,\n * same top-down order) on one fade that ends with the slide. The bottom-pinned\n * settings control only fades. The workspace/session browsing region between\n * global panel rows and the foot is the `sidebar.workspaces` registrant's,\n * and the foot holds `sidebar.settings` plus `sidebar.footer.action`; the shell\n * hands them the wide flag (plus an expand request callback for the browser).\n * Through the browser's hookContext, the shell also hands it the scroller hook\n * that continues wheel scrolling over the sidebar viewport into its list.\n *\n * The column also owns whether the scroll regions nested in it draw a\n * scrollbar at all: the shell tracks the pointer and rebinds ui-theme's\n * scrollbar indirection away while it is elsewhere, so a list the user is not\n * pointing at carries no bar.\n */\nimport { useEffect, useId, useLayoutEffect, useMemo, useRef, useState } from 'react'\nimport type { PointerEvent as ReactPointerEvent } from 'react'\nimport clsx from 'clsx'\nimport {\n  FishLogo, IconAppsAddOutlineRegular, IconNewChatOutlineMedium, IconNewChatOutlineRegular,\n  IconPanelLeftOutlineRegular, IconPinFillRegular, focusWithoutRing, isBehindModal, isDarwinDesktop, Menu, ShortcutKeys, Toast,\n  Tooltip, useModalLayer, writeClipboard,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { InjectFace, PropsRenderFactories, PropsRenderSlots, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'\nimport type {\n  SidebarPanelActionsOwnerProps, SidebarPanelMetadata, SidebarRootComponentProps, SidebarRootInjected, SidebarSectionHookContext,\n  SidebarSectionOwnerProps,\n} from './contract/slots.ts'\nimport { FIXED_PANEL_ID } from './panel-pins.ts'\nimport { createScrollHandoff } from './scroll-handoff.ts'\nimport css from './SidebarRoot.module.css'\n\n/** Wide-content unmount delay; matches the 150ms wide-content fade-out. */\nconst COLLAPSE_SETTLE_MS = 150\n\n/** Format complete-build metadata for the local brand badge. */\nfunction localBuildVersion(): string | undefined {\n  const version = process.env.DSH_CLIENT_VERSION\n  if (version === undefined) return undefined\n  const commit = process.env.DSH_CLIENT_COMMIT_HASH\n  return version\n    + (commit === undefined ? '' : `-${commit}`)\n    + (process.env.DSH_CLIENT_GIT_DIRTY === 'true' ? '-dirty' : '')\n}\n\ntype PanelRowProps =\n  Pick<SidebarPanelMetadata, 'id' | 'label'>\n  & Pick<SidebarSectionOwnerProps, 'wide'>\n  & Pick<PropsRuntime<'sidebar'>, 'usePanelInfo'>\n  & Pick<InjectFace<SidebarRootInjected>, 'selectPanel' | 'trackEntryClick' | 'setPinned'>\n  & { readonly unpinLabel: string; readonly unpinTooltip: string; readonly canUnpin: boolean }\n  & PropsRenderFactories\n\n/** Analytics category of an official panel; other panels are never reported. */\nfunction officialEntry(id: string): 'plugin' | 'cron' | undefined {\n  if (id === 'plugins') return 'plugin'\n  return id === 'schedules' ? 'cron' : undefined\n}\n\n/** Each panel row subscribes only to its own selection state. */\nfunction PanelRow({\n  id, label, wide, unpinLabel, unpinTooltip, canUnpin, usePanelInfo, selectPanel, setPinned, trackEntryClick, renderFactorySlot,\n}: PanelRowProps) {\n  const active = usePanelInfo(info => info.activePanelId === id)\n  const trailing = useId()\n  return (\n    <div className={clsx(css.panelEntry, wide && css.panelEntryWide, active && css.panelEntryActive)}>\n      <Tooltip label={label} delayMs={500} disabled={wide}>\n        <button\n          type=\"button\"\n          className={css.panelRow}\n          aria-label={label}\n          aria-describedby={trailing}\n          aria-current={active ? 'page' : undefined}\n          onClick={() => {\n            const entry = officialEntry(id)\n            if (entry !== undefined) trackEntryClick({ menu_name: entry, position: 'sidebar' })\n            selectPanel(id)\n          }}\n        >\n          <span className={css.panelGlyph} aria-hidden=\"true\">\n            {renderFactorySlot('sidebar.panel.icon', { id, size: wide ? 16 : 18, active })}\n          </span>\n          {wide && (\n            <span className={clsx(css.panelTitle, css.wide)}>\n              {label}\n            </span>\n          )}\n          <span id={trailing} className={css.panelTrailing}>{renderFactorySlot('sidebar.panel.trailing', { id, wide, active })}</span>\n        </button>\n      </Tooltip>\n      {wide && canUnpin && <Tooltip label={unpinTooltip} side=\"bottom\" align=\"end\" delayMs={500} portal>\n        <button type=\"button\" className={css.panelUnpin} aria-label={unpinLabel} onClick={(event) => {\n          // Unpin is rendered only while this navigation also renders More.\n          const navigation = event.currentTarget.closest('nav') as HTMLElement\n          const more = navigation.querySelector('button[aria-haspopup=\"menu\"]') as HTMLButtonElement\n          focusWithoutRing(more)\n          setPinned(id, false)\n        }}>\n          <IconPinFillRegular size={14} />\n        </button>\n      </Tooltip>}\n    </div>\n  )\n}\n\ntype PanelMoreMenuProps =\n  Pick<SidebarSectionOwnerProps, 'wide'>\n  & Omit<SidebarPanelActionsOwnerProps, 'onDismiss'>\n  & PropsRenderSlots<'sidebar.panellist.actions'>\n  & Pick<InjectFace<SidebarRootInjected>, 'trackEntryClick'>\n  & { readonly label: string }\n\n/** The panel list's More launcher: a panel-row button whose menu rows come from `sidebar.panellist.actions`. */\nfunction PanelMoreMenu({ wide, label, entries, onOpen, onPinnedChange, trackEntryClick, renderSlot }: PanelMoreMenuProps) {\n  const [open, setOpen] = useState(false)\n  const onDismiss = (): void => { setOpen(false) }\n  return (\n    <Menu open={open} onClose={onDismiss} portal autoFocus className={css.moreAnchor} listClassName={css.moreMenu}\n      anchor={(\n        <Tooltip label={label} delayMs={500} disabled={wide}>\n          <button type=\"button\" className={css.panelRow} aria-label={label} aria-haspopup=\"menu\" aria-expanded={open}\n            onClick={() => {\n              trackEntryClick({ menu_name: 'more', position: 'sidebar' })\n              setOpen(value => !value)\n            }}>\n            <span className={css.panelGlyph} aria-hidden=\"true\"><IconAppsAddOutlineRegular size={wide ? 16 : 18} /></span>\n            {wide && <span className={clsx(css.panelTitle, css.wide)}>{label}</span>}\n          </button>\n        </Tooltip>\n      )}>\n      {renderSlot('sidebar.panellist.actions', { entries, onOpen, onPinnedChange, onDismiss })}\n    </Menu>\n  )\n}\n\n/**\n * Render the sidebar column shell.\n * @param props - composed slot props (runtime share + injected callbacks, contract/slots.ts).\n * @returns the sidebar element tree.\n */\nexport function SidebarRoot({\n  collapsed,\n  width,\n  drawer,\n  startSession,\n  toggleSidebar,\n  selectPanel,\n  setPinned,\n  trackEntryClick,\n  useRemoteAccess,\n  usePanels,\n  useEntryPins,\n  useEntryActions,\n  useShortcuts,\n  usePanelInfo,\n  t,\n  renderSlot,\n  renderFactorySlot,\n}: SidebarRootComponentProps) {\n  const panels = usePanels(snapshot => snapshot)\n  const unpinned = useEntryPins(ids => ids)\n  const activePanelId = usePanelInfo(info => info.activePanelId)\n  const hasEntryActions = useEntryActions(registered => registered)\n  const shortcut = useShortcuts(rows => rows.find(row => row.id === 'sidebar.left.toggle'))\n  const newShortcut = useShortcuts(rows => rows.find(row => row.id === 'session.new'))\n  // A page whose access snapshot excludes starting a Session offers no New Session affordance.\n  const canStartSession = useRemoteAccess('session/create')\n  const toggleLabel = collapsed ? t('toggle.open') : t('toggle.collapse')\n  // Wide content stays mounted while the collapse animates (fading via\n  // .collapsed .wide), unmounts at settle, and remounts right away on expand.\n  // A closed drawer retains its content with the rail phase already settled.\n  const [settled, setSettled] = useState(collapsed)\n  useEffect(() => {\n    if (drawer || !collapsed) { setSettled(collapsed); return }\n    const timer = window.setTimeout(() => { setSettled(true) }, COLLAPSE_SETTLE_MS)\n    return () => { window.clearTimeout(timer) }\n  }, [collapsed, drawer])\n  const windowsTitlebar = document.documentElement.hasAttribute('data-windows-titlebar')\n  const wide = drawer || (windowsTitlebar ? !collapsed : !collapsed || !settled)\n  const [scrollHandoff] = useState(createScrollHandoff)\n  const sectionHookContext = useMemo<SidebarSectionHookContext>(\n    () => ({ useSectionScroller: scrollHandoff.useSectionScroller }), [scrollHandoff],\n  )\n  // The Windows titlebar hosts the New Session controls while the sidebar is collapsed.\n  const openNewSession = (): void => {\n    trackEntryClick({ menu_name: 'new_session', position: windowsTitlebar && collapsed ? 'titlebar' : 'sidebar' })\n    startSession()\n  }\n  // The Windows caption menus occupy the strip to the right of these controls\n  // (that is what --dsh-windows-menu-start reserves), so a right-side bubble\n  // lands under their text. Below the caption is the only clear side.\n  const captionTooltipSide = windowsTitlebar ? 'bottom' : 'right'\n  // Freeze the content at its expanded width while it fades out (collapsed\n  // && wide): the sliding column then clips it instead of reflowing it. The\n  // rail layout (.collapsed styles) only applies once the fade settles.\n  const lastWideWidth = useRef(width)\n  if (drawer || !collapsed) lastWideWidth.current = width\n\n  // A closed drawer returns to the static rail; only a live collapse fades it in.\n  const animateRail = useRef(!collapsed)\n  if (drawer || !collapsed) animateRail.current = !collapsed\n\n  // Scrollbars in the column follow the pointer: .quietBars rebinds them away\n  // whenever the pointer is outside, and its stylesheet owns the delay and\n  // fade, so a pointer that returns before the fade starts sees no change.\n  const column = useRef<HTMLDivElement>(null)\n  const sidebarFocus = useRef<Element | null>(null)\n  useModalLayer(column, drawer && !collapsed, toggleSidebar)\n  useLayoutEffect(() => {\n    if (!collapsed) return\n    const controlled = sidebarFocus.current?.getAttribute('aria-controls')?.split(/\\s+/) ?? []\n    const ownsMenuFocus = controlled.some(id => document.getElementById(id)?.contains(document.activeElement))\n    if (sidebarFocus.current !== document.activeElement && !ownsMenuFocus) return\n    const opener = drawer\n      ? column.current?.ownerDocument.querySelector<HTMLElement>('[data-sidebar-opener]')\n      : column.current?.querySelector<HTMLElement>('[data-sidebar-toggle]')\n    if (opener != null && !isBehindModal(opener)) focusWithoutRing(opener, { preventScroll: true })\n  }, [drawer, collapsed])\n  const [pointerInside, setPointerInside] = useState(false)\n  // Inside is decided by the column's BOX, not by DOM containment, for every\n  // pointer move that reaches the column. ui-settings renders its\n  // full-viewport panel as a fixed-position DESCENDANT of this column, and the\n  // column's menus and tooltips are React portals, so a pointer over them\n  // fires no `pointerleave` here while their moves still bubble to it. The\n  // element's own leave stays as the one signal geometry cannot give: a\n  // pointer that leaves the window emits no further moves.\n  const trackPointer = (event: ReactPointerEvent<HTMLDivElement>): void => {\n    const rect = event.currentTarget.getBoundingClientRect()\n    setPointerInside(event.clientX >= rect.left && event.clientX < rect.right\n      && event.clientY >= rect.top && event.clientY < rect.bottom)\n  }\n\n  const buildVersion = localBuildVersion()\n  // The local-build fallbacks copy the badge text; the brand button below\n  // skips New Session for clicks inside them. The click still bubbles, so\n  // document-level outside-click listeners see it.\n  // Each successful copy bumps the key so a repeated copy replays the toast.\n  const [copiedToast, setCopiedToast] = useState<number | null>(null)\n  const copyVersion = (version: string) => (): void => {\n    void writeClipboard(version).then((ok) => {\n      if (ok) setCopiedToast(seq => (seq ?? 0) + 1)\n    })\n  }\n\n  const darwinDesktop = isDarwinDesktop()\n  // Rail resting state is the whale mark; hovering swaps in the panel icon\n  // (the expand affordance, figma sidebar-hover flow). Expanded it is a plain\n  // panel icon.\n  const toggle = (\n    <Tooltip label={toggleLabel} shortcutKeys={shortcut?.keys} delayMs={500} side={captionTooltipSide} portal={drawer}>\n      <button\n        data-sidebar-toggle\n        data-modal-autofocus={drawer || undefined}\n        type=\"button\"\n        className={clsx(css.iconButton, css.toggle)}\n        aria-label={toggleLabel}\n        aria-keyshortcuts={shortcut?.aria}\n        onClick={() => { toggleSidebar() }}\n      >\n        {!wide && !windowsTitlebar && (\n          <span className={css.railMark} aria-hidden=\"true\">\n            {renderSlot('sidebar.brand.mark', { size: 24 }, { fallback: <FishLogo size={24} /> })}\n          </span>\n        )}\n        {/* Rail icons render at 18 (figma rail spec); expanded keeps the glyph-native sizes. */}\n        <IconPanelLeftOutlineRegular className={css.panelIcon} size={wide || windowsTitlebar ? 16 : 18} />\n        {!wide && renderSlot('sidebar.toggle.badge', {})}\n      </button>\n    </Tooltip>\n  )\n\n  return (\n    <div\n      ref={column}\n      onFocusCapture={(event) => { sidebarFocus.current = event.target }}\n      role={drawer ? 'dialog' : undefined}\n      data-shortcut-modal={drawer ? 'sidebar' : undefined}\n      aria-modal={drawer && !collapsed ? true : undefined}\n      aria-label={drawer ? t('navigation.label') : undefined}\n      tabIndex={drawer ? -1 : undefined}\n      className={clsx(\n        css.root, !wide && css.collapsed, !wide && animateRail.current && css.railIn,\n        !drawer && collapsed && wide && css.fading, !pointerInside && css.quietBars,\n      )}\n      style={wide ? { width: !drawer && collapsed ? lastWideWidth.current : width } : undefined}\n      onPointerEnter={trackPointer}\n      onPointerMove={trackPointer}\n      onPointerLeave={() => { setPointerInside(false) }}\n    >\n      {/* macOS hiddenInset titlebar: the strip shares the row with the\n          traffic lights and keeps the toggle at the sidebar's top-right. */}\n      {darwinDesktop && <div className={css.topStrip} data-window-drag>{toggle}</div>}\n      <div className={css.logoRow} data-window-drag>\n        {/* Expanded, the brand doubles as a New Session shortcut while the\n            access snapshot allows `session/create` — except on\n            macOS, where it stays part of the logo row's window-drag surface\n            (the drag-row controls rule would subtract a button);\n            the collapsed rail's logo is the expand toggle below instead.\n            Mouse clicks on the local-build fallbacks copy the version instead. */}\n        {wide && (() => {\n          const identity = (\n            <span className={css.brandIdentity} aria-hidden=\"true\">\n              <span className={css.brandMark}>\n                {renderSlot('sidebar.brand.mark', { size: 24 }, {\n                  fallback: buildVersion === undefined\n                    ? <FishLogo size={24} />\n                    : <span className={css.copyVersion} data-copy-version onClick={copyVersion(buildVersion)}><FishLogo size={24} /></span>,\n                })}\n              </span>\n              <span className={css.brandName}>\n                {renderSlot('sidebar.brand.name', {}, {\n                  fallback: buildVersion === undefined\n                    ? <span className={css.fallbackBrandName}>{t('brand.localBuild')}</span>\n                    : (\n                      <span className={clsx(css.localBuildBrand, css.copyVersion)} data-copy-version onClick={copyVersion(buildVersion)}>\n                        <span className={css.localBuildTitle}>{t('brand.localBuild')}</span>\n                        <span className={css.buildVersion}>{buildVersion}</span>\n                      </span>\n                    ),\n                })}\n              </span>\n            </span>\n          )\n          return darwinDesktop || !canStartSession\n            ? <span className={clsx(css.brand, css.wide)}>{identity}</span>\n            : (\n              <button\n                type=\"button\"\n                className={clsx(css.brand, css.wide)}\n                aria-label={t('session.new.label')}\n                aria-keyshortcuts={newShortcut?.aria}\n                onClick={(event) => {\n                  if ((event.target as Element).closest('[data-copy-version]') !== null) return\n                  openNewSession()\n                }}\n              >\n                {identity}\n              </button>\n            )\n        })()}\n        {!darwinDesktop && toggle}\n      </div>\n\n      {/* The label fades before the hover/focus shortcut, including on translucent backgrounds. */}\n      {canStartSession && (\n        <div className={css.newSessionRow}>\n          {renderSlot('sidebar.session.action', { wide }, {\n            children: (\n              <Tooltip label={t('session.new.label')} shortcutKeys={newShortcut?.keys} delayMs={500} side={captionTooltipSide} disabled={wide}>\n                <button\n                  type=\"button\"\n                  className={css.newSession}\n                  aria-label={t('session.new.label')}\n                  aria-keyshortcuts={newShortcut?.aria}\n                  onClick={openNewSession}\n                >\n                  <span className={css.newSessionLabelMask}><span className={css.newSessionContent}>\n                    {wide\n                      ? <IconNewChatOutlineMedium size={14} />\n                      : <IconNewChatOutlineRegular size={windowsTitlebar ? 16 : 18} />}\n                    {wide && <span className={clsx(css.newSessionLabel, css.wide)}>{t('session.new')}</span>}\n                  </span></span>\n                  {wide && newShortcut !== undefined && newShortcut.keys.length > 0 && <span className={css.newSessionShortcut} aria-hidden=\"true\">\n                    <ShortcutKeys keys={newShortcut.keys} />\n                  </span>}\n                </button>\n              </Tooltip>\n            ),\n          })}\n        </div>\n      )}\n\n      <div className={css.scrollRegion}>\n        <div\n          ref={scrollHandoff.bindViewportRef}\n          className={css.scrollArea}\n          data-sidebar-scrollport={wide ? '' : undefined}\n        >\n          {panels.length > 0 && (\n            <nav className={css.panelList} aria-label={t('panels.label')}>\n              {panels.filter(({ id }) => id === FIXED_PANEL_ID || !hasEntryActions || !unpinned.includes(id)).map(({ id, label }) => (\n                <PanelRow\n                  key={id}\n                  id={id}\n                  label={label}\n                  wide={wide}\n                  unpinLabel={t('panels.unpin', { name: label })}\n                  unpinTooltip={t('panels.unpinTooltip')}\n                  canUnpin={hasEntryActions && id !== FIXED_PANEL_ID}\n                  setPinned={setPinned}\n                  usePanelInfo={usePanelInfo}\n                  selectPanel={selectPanel}\n                  trackEntryClick={trackEntryClick}\n                  renderFactorySlot={renderFactorySlot}\n                />\n              ))}\n              {hasEntryActions && (\n                <PanelMoreMenu\n                  wide={wide}\n                  label={t('panels.more')}\n                  entries={panels.filter(({ id }) => id !== FIXED_PANEL_ID)\n                    .map(({ id, label }) => ({ id, label, pinned: !unpinned.includes(id), active: id === activePanelId }))}\n                  onOpen={(id) => {\n                    const entry = officialEntry(id)\n                    if (entry !== undefined) trackEntryClick({ menu_name: entry, position: 'sidebar_more' })\n                    const panel = panels.find(candidate => candidate.id === id)\n                    if (panel !== undefined) selectPanel(panel.id)\n                  }}\n                  onPinnedChange={setPinned}\n                  trackEntryClick={trackEntryClick}\n                  renderSlot={renderSlot}\n                />\n              )}\n            </nav>\n          )}\n          <div className={css.regionArea}>\n            {renderSlot('sidebar.workspaces', {\n              wide,\n              expandSidebar: () => { if (collapsed) toggleSidebar() },\n            }, { hookContext: sectionHookContext })}\n          </div>\n        </div>\n        <span className={css.scrollFade} aria-hidden=\"true\" />\n      </div>\n\n      {copiedToast !== null && (\n        <Toast key={copiedToast} tone=\"success\" text={t('version.copied')} onDone={() => { setCopiedToast(null) }} />\n      )}\n\n      {/* Footer actions stack above Settings in both sidebar widths. */}\n      <div className={css.footArea}>\n        <div className={css.footerActions}>\n          {renderSlot('sidebar.footer.action', { wide })}\n        </div>\n        <div className={css.settingsArea}>\n          {renderSlot('sidebar.settings', { wide })}\n        </div>\n      </div>\n    </div>\n  )\n}\n","/** Shared rendering of plugin-owned panel icons in navigation rows and menus. */\nimport type { FactoryComponentPropsOf } from '@deepseek-ai/dsh-client-ui-slots'\nimport type {} from './contract/slots.ts'\n\n/**\n * Render the icon registered for one panel at the caller's size and selection state.\n * @param props - Panel identity, icon presentation, and the authorized child renderer.\n * @returns The matching panel icon.\n */\nexport function PanelIcon({ id, size, active, renderSlot }: FactoryComponentPropsOf<'sidebar.panel.icon'>) {\n  return renderSlot('sidebar.panellist', { size, active }, { only: id })\n}\n\n/**\n * Render the trailing content registered for one panel in its navigation row.\n * @param props - Panel identity, row state, and the authorized child renderer.\n * @returns The matching trailing content, or nothing without a registration.\n */\nexport function PanelTrailing({ id, wide, active, renderSlot }: FactoryComponentPropsOf<'sidebar.panel.trailing'>) {\n  return renderSlot('sidebar.panellist.trailing', { wide, active }, { only: id })\n}\n","/** `sidebar` namespace dictionaries for shell controls and global panels. */\n\n/** Simplified Chinese dictionary (the key-set source of truth). */\nexport const zh = {\n  'panels.unpinTooltip': '从左侧栏取消固定',\n  'panels.unpin': '从侧边栏取消固定{name}',\n  'session.new': '新会话',\n  'session.new.label': '新建会话',\n  'toggle.open': '打开侧边栏',\n  'toggle.collapse': '收起侧边栏',\n  'panels.label': '全局面板',\n  'navigation.label': '导航',\n  'panels.more': '更多',\n  'version.copied': '版本号复制成功',\n} satisfies Record<string, string>\n\n/** The sidebar namespace key union. */\nexport type SidebarKey = keyof typeof zh\n\n/** English dictionary, checked complete against the zh key set. */\nexport const en = {\n  'panels.unpinTooltip': 'Unpin from left sidebar',\n  'panels.unpin': 'Unpin {name} from sidebar',\n  'session.new': 'New Session',\n  'session.new.label': 'New session',\n  'toggle.open': 'Open sidebar',\n  'toggle.collapse': 'Collapse sidebar',\n  'panels.label': 'Global panels',\n  'navigation.label': 'Navigation',\n  'panels.more': 'More',\n  'version.copied': 'Version copied',\n} satisfies Record<SidebarKey, string>\n\n/** Japanese copy, checked against the English keys. */\nexport const ja = {\n  'panels.unpinTooltip': '左サイドバーから固定解除',\n  'panels.unpin': '{name}をサイドバーから固定解除',\n  'session.new': '新規セッション',\n  'session.new.label': '新規セッション',\n  'toggle.open': 'サイドバーを開く',\n  'toggle.collapse': 'サイドバーを折りたたむ',\n  'panels.label': 'グローバルパネル',\n  'navigation.label': 'ナビゲーション',\n  'panels.more': 'その他',\n  'version.copied': 'バージョンをコピーしました',\n} satisfies Record<keyof typeof en, string>\n\n/** Spanish dictionary, checked against the English keys. */\nexport const es = {\n  'panels.unpinTooltip': 'Desanclar de la barra lateral izquierda',\n  'panels.unpin': 'Desfijar {name} de la barra lateral',\n  'session.new': 'Nueva sesión',\n  'session.new.label': 'Nueva sesión',\n  'toggle.open': 'Abrir barra lateral',\n  'toggle.collapse': 'Contraer barra lateral',\n  'panels.label': 'Paneles globales',\n  'navigation.label': 'Navegación',\n  'panels.more': 'Más',\n  'version.copied': 'Versión copiada',\n} satisfies Record<keyof typeof en, string>\n\n/** French dictionary, checked against the English keys. */\nexport const fr = {\n  'panels.unpinTooltip': \"Retirer l'épingle de la barre latérale gauche\",\n  'panels.unpin': 'Désépingler {name} de la barre latérale',\n  'session.new': 'Nouvelle séance',\n  'session.new.label': 'Nouvelle séance',\n  'toggle.open': 'Ouvrir la barre latérale',\n  'toggle.collapse': 'Réduire la barre latérale',\n  'panels.label': 'Panneaux globaux',\n  'navigation.label': 'Navigation',\n  'panels.more': 'Plus',\n  'version.copied': 'Version copiée',\n} satisfies Record<keyof typeof en, string>\n\n/** German dictionary, checked against the English keys. */\nexport const de = {\n  'panels.unpinTooltip': 'Von der linken Seitenleiste lösen',\n  'panels.unpin': '{name} von der Seitenleiste lösen',\n  'session.new': 'Neue Sitzung',\n  'session.new.label': 'Neue Sitzung',\n  'toggle.open': 'Seitenleiste öffnen',\n  'toggle.collapse': 'Seitenleiste einklappen',\n  'panels.label': 'Globale Bereiche',\n  'navigation.label': 'Navigation',\n  'panels.more': 'Mehr',\n  'version.copied': 'Version kopiert',\n} satisfies Record<keyof typeof en, string>\n\n/** Russian dictionary, checked against the English keys. */\nexport const ru = {\n  'panels.unpinTooltip': 'Открепить от левой боковой панели',\n  'panels.unpin': 'Открепить {name} от боковой панели',\n  'session.new': 'Новая сессия',\n  'session.new.label': 'Новая сессия',\n  'toggle.open': 'Открыть боковую панель',\n  'toggle.collapse': 'Свернуть боковую панель',\n  'panels.label': 'Глобальные панели',\n  'navigation.label': 'Навигация',\n  'panels.more': 'Ещё',\n  'version.copied': 'Версия скопирована',\n} satisfies Record<keyof typeof en, string>\n\n/** Portuguese dictionary, checked against the English keys. */\nexport const pt = {\n  'panels.unpinTooltip': 'Soltar da barra lateral esquerda',\n  'panels.unpin': 'Desafixar {name} da barra lateral',\n  'session.new': 'Nova sessão',\n  'session.new.label': 'Nova sessão',\n  'toggle.open': 'Abrir barra lateral',\n  'toggle.collapse': 'Recolher barra lateral',\n  'panels.label': 'Painéis globais',\n  'navigation.label': 'Navegação',\n  'panels.more': 'Mais',\n  'version.copied': 'Versão copiada',\n} satisfies Record<keyof typeof en, string>\n","/** Registers the sidebar shell and global panel navigation. */\nimport type {} from '@deepseek-ai/dsh-client-product-analytics/client'\nimport type { Context as ClientContext } from '@deepseek-ai/cordis'\nimport { createSnapshotStore } from '@deepseek-ai/dsh-client-store'\nimport { resolveSlotLabel } from '@deepseek-ai/dsh-client-ui-slots'\nimport type { MainPanelId } from '@deepseek-ai/dsh-client-ui-layout/client'\n// Type-only: pulls the locale plugin's Context merge (ctx.locale).\nimport type {} from '@deepseek-ai/dsh-client-locale/client'\n// Type-only: pulls the SlotRegistry service merge (ctx.slots).\nimport type {} from '@deepseek-ai/dsh-client-ui-renderer/client'\n// Type-only: pulls the Session root standard-props merge.\nimport type {} from '@deepseek-ai/dsh-client-ui-session/client'\nimport type { SidebarPanelMetadata, SidebarRootInjected, SidebarSectionInjected } from './contract/slots.ts'\nimport { createPanelPins } from './panel-pins.ts'\nimport { HeaderLeadingControls } from './HeaderLeadingControls.tsx'\nimport { SidebarRoot } from './SidebarRoot.tsx'\nimport { PanelIcon, PanelTrailing } from './PanelIcon.tsx'\nimport { en, ja, es, fr, de, ru, pt, zh, type SidebarKey } from './locales.ts'\n\nexport type {\n  SidebarBrandMarkOwnerProps, SidebarBrandNameOwnerProps, SidebarFooterActionOwnerProps,\n  SidebarPanelActionEntry, SidebarPanelActionsOwnerProps, SidebarPanelIconOwnerProps, SidebarPanelMetadata,\n  SidebarRootComponentProps, SidebarRootInjected, SidebarSectionOwnerProps, SidebarSessionActionOwnerProps,\n  SidebarSettingsOwnerProps, SectionScroller, SidebarSectionHookContext, SidebarSectionInjected, UseSectionScroller,\n} from './contract/slots.ts'\nexport type { SidebarKey } from './locales.ts'\n\n/** The section occupant receives the scroller hook from each render's hookContext. */\nconst SIDEBAR_SECTION_INJECT: SidebarSectionInjected = {\n  hooks: { sectionScroller: (_standard, { useSectionScroller }) => useSectionScroller },\n}\n\ndeclare module '@deepseek-ai/dsh-client-ui-slots' {\n  interface LocaleNamespaceMap {\n    /** Sidebar controls and global panel copy. */\n    sidebar: SidebarKey\n  }\n}\n\n/** Dictionary namespace owned by this plugin. */\nconst NS = 'sidebar'\n\ninterface WorkspaceNavigation {\n  startSession(workspaceId?: Parameters<SidebarRootInjected['startSession']>[0]): void\n}\n\n/** Services required by the sidebar plugin. */\nexport const inject = ['slots', 'layout', 'uiWorkspace', 'locale', 'shortcuts']\n\n/** Registers the sidebar shell and its service callbacks.\n * @param ctx - Client root context.\n */\nexport function apply(ctx: ClientContext): void {\n  const workspaceNavigation = ctx.get('uiWorkspace') as unknown as WorkspaceNavigation\n  ctx.effect(() => ctx.locale.register(NS, { zh, en, ja, es, fr, de, ru, pt }), 'ui-sidebar: dictionaries')\n  const panels = createSnapshotStore<readonly SidebarPanelMetadata[]>([])\n  const syncPanels = (): void => {\n    const next = ctx.slots.entriesOfSlot('sidebar.panellist').map(({ options }) => {\n      // The list registration requires an id; StoredEntry erases the slot kind.\n      const id = options.id as MainPanelId\n      return { id, order: options.order ?? 0, label: resolveSlotLabel(options.label) ?? id }\n    }).sort((a, b) => a.order - b.order)\n    const previous = panels.getSnapshot()\n    if (previous.length === next.length && previous.every((panel, index) => {\n      const candidate = next[index] as SidebarPanelMetadata\n      return panel.id === candidate.id && panel.order === candidate.order && panel.label === candidate.label\n    })) return\n    panels.set(next)\n  }\n  ctx.effect(() => ctx.slots.subscribe('sidebar.panellist', syncPanels), 'ui-sidebar: panel entries')\n  ctx.effect(() => ctx.locale.subscribe(syncPanels), 'ui-sidebar: panel labels')\n  const panelPins = createPanelPins()\n  const entryActions = {\n    getSnapshot: () => ctx.slots.entriesOfSlot('sidebar.panellist.actions').length > 0,\n    subscribe: (listener: () => void) => ctx.slots.subscribe('sidebar.panellist.actions', listener),\n  }\n\n  const injectProps = (): SidebarRootInjected => ({\n    // The shell's New Session button rides the Workspace UI's shared action\n    // (current Session Workspace, then recent Workspace).\n    startSession: (workspaceId) => { workspaceNavigation.startSession(workspaceId) },\n    toggleSidebar: () => { ctx.layout.toggleSidebar() },\n    selectPanel: (id) => { ctx.layout.selectPanel(id) },\n    setPinned: panelPins.setPinned,\n    trackEntryClick: (attributes) => { ctx.get('productAnalytics')?.track('sidebar_menu_click', attributes) },\n    hooks: { panels, shortcuts: ctx.shortcuts.catalog, entryPins: panelPins.unpinned, entryActions },\n  })\n  ctx.slots.inject('sidebar', function* () {\n    yield ctx.slots.registerFactory({\n      name: 'sidebar.panel.icon', scope: 'root',\n      children: { 'sidebar.panellist': { kind: 'list', scope: 'root' } },\n    }, PanelIcon)\n    yield ctx.slots.registerFactory({\n      name: 'sidebar.panel.trailing', scope: 'root',\n      children: { 'sidebar.panellist.trailing': { kind: 'list', scope: 'root', inline: true } },\n    }, PanelTrailing)\n    yield ctx.slots.register({\n      name: 'sidebar',\n      locale: NS,\n      children: {\n        'sidebar.brand.mark': { kind: 'single', scope: 'root' },\n        'sidebar.brand.name': { kind: 'single', scope: 'root' },\n        'sidebar.toggle.badge': { kind: 'single', scope: 'root' },\n        'sidebar.panellist.actions': { kind: 'list', scope: 'root' },\n        'sidebar.workspaces': { kind: 'single', scope: 'root', inject: SIDEBAR_SECTION_INJECT },\n        'sidebar.settings': { kind: 'single', scope: 'root' },\n        'sidebar.footer.action': { kind: 'list', scope: 'root' },\n        'sidebar.session.action': { kind: 'hoc', scope: 'root' },\n      },\n      inject: injectProps,\n    }, SidebarRoot)\n  })\n  // macOS desktop hides the collapsed sidebar entirely, so the open/New\n  // Session controls move into the frame's window-chrome seat beside the\n  // traffic lights; the occupant reuses the shell's injected actions, and\n  // the AppFrame mounts the