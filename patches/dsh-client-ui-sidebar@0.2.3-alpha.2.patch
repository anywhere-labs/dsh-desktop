-{"version":3,"file":"client.js","names":[],"sources":["../../../packages/client/ui-sidebar/src/client/panel-pins.ts","../../../packages/client/ui-sidebar/src/client/HeaderLeadingControls.tsx","../../../../node_modules/.pnpm/clsx@2.1.1/node_modules/clsx/dist/clsx.mjs","../../../packages/client/ui-sidebar/src/client/scroll-handoff.ts","../../../packages/client/ui-sidebar/src/client/SidebarRoot.tsx","../../../packages/client/ui-sidebar/src/client/PanelIcon.tsx","../../../packages/client/ui-sidebar/src/client/locales.ts","../../../packages/client/ui-sidebar/src/client/index.ts"],"sourcesContent":["/** In-memory pin choices for the global panel launchers. */\nimport { createSnapshotStore, type ObservableSnapshot } from '@deepseek-ai/dsh-client-store'\n\n/** Panel whose launcher always shows and never enters the customization list. */\nexport const FIXED_PANEL_ID = 'plugins'\n\nconst NO_PANELS: readonly string[] = []\n\n/** Unpinned panel ids and their only mutation. */\nexport interface PanelPins {\n  /** Unpinned panel ids; ids of panels that are not registered stay listed. */\n  readonly unpinned: ObservableSnapshot<readonly string[]>\n  /**\n   * Pin or unpin one panel launcher; the fixed panel is ignored.\n   * @param id - Panel id.\n   * @param pinned - Whether the launcher is manually pinned.\n   */\n  readonly setPinned: (id: string, pinned: boolean) => void\n}\n\n/**\n * Create the in-memory panel pin list; the snapshot keeps its reference until the list changes.\n * @returns Unpinned panel ids and the pin mutation.\n */\nexport function createPanelPins(): PanelPins {\n  const store = createSnapshotStore<{ readonly unpinned: readonly string[] }>({ unpinned: NO_PANELS })\n  return {\n    unpinned: { getSnapshot: () => store.getSnapshot().unpinned, subscribe: listener => store.subscribe(listener) },\n    setPinned: (id, pinned) => {\n      const current = store.getSnapshot().unpinned\n      if (id === FIXED_PANEL_ID || pinned !== current.includes(id)) return\n      store.set({ unpinned: pinned ? current.filter(entry => entry !== id) : [...current, id] })\n    },\n  }\n}\n","/** Window-chrome controls for the fully hidden sidebar (frame shell.leading seat). */\nimport {\n  IconNewChatOutlineRegular, IconPanelLeftOutlineRegular, Tooltip,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'\n// Type-only: pulls the frame's shell.leading slot declaration.\nimport type {} from '@deepseek-ai/dsh-client-ui-layout/client'\nimport type { SidebarRootInjected } from './contract/slots.ts'\nimport css from './HeaderLeadingControls.module.css'\n\n/** Full props of the shell.leading occupant. */\nexport type HeaderLeadingControlsProps =\n  PropsRuntime<'shell.leading'>\n  & InjectFace<SidebarRootInjected>\n  & PropsLocale<'sidebar'>\n\n/**\n * Sidebar-open and New Session controls in the frame's window-chrome seat.\n * The frame mounts this seat for hidden sidebars and owns its placement.\n * Web shows only the sidebar opener; Desktop also retains New Session.\n * @param props - Injected sidebar actions, the global access Hook, and the sidebar locale seat.\n * @returns the sidebar toggle, plus New Session on Desktop while access allows `session/create`.\n */\nexport function HeaderLeadingControls({\n  toggleSidebar, startSession, trackEntryClick, useRemoteAccess, useShortcuts, t,\n}: HeaderLeadingControlsProps) {\n  // A page whose access snapshot excludes starting a Session keeps only the sidebar toggle here.\n  const canStartSession = useRemoteAccess('session/create')\n  const desktop = document.documentElement.hasAttribute('data-platform')\n  const shortcut = useShortcuts(rows => rows.find(row => row.id === 'sidebar.left.toggle'))\n  const newShortcut = useShortcuts(rows => rows.find(row => row.id === 'session.new'))\n  return (\n    <div className={css.controls}>\n      <Tooltip label={t('toggle.open')} shortcutKeys={shortcut?.keys} delayMs={500}>\n        <button\n          data-sidebar-opener\n          type=\"button\"\n          className={css.iconButton}\n          aria-label={t('toggle.open')}\n          aria-keyshortcuts={shortcut?.aria}\n          onClick={() => { toggleSidebar() }}\n        >\n          <IconPanelLeftOutlineRegular size={16} />\n        </button>\n      </Tooltip>\n      {desktop && canStartSession && (\n        <Tooltip label={t('session.new.label')} shortcutKeys={newShortcut?.keys} delayMs={500}>\n          <button\n            type=\"button\"\n            className={css.iconButton}\n            aria-label={t('session.new.label')}\n            aria-keyshortcuts={newShortcut?.aria}\n            onClick={() => {\n              trackEntryClick({ menu_name: 'new_session', position: 'titlebar' })\n              startSession()\n            }}\n          >\n            <IconNewChatOutlineRegular size={16} />\n          </button>\n        </Tooltip>\n      )}\n    </div>\n  )\n}\n","function r(e){var t,f,n=\"\";if(\"string\"==typeof e||\"number\"==typeof e)n+=e;else if(\"object\"==typeof e)if(Array.isArray(e)){var o=e.length;for(t=0;t<o;t++)e[t]&&(f=r(e[t]))&&(n&&(n+=\" \"),n+=f)}else for(f in e)e[f]&&(n&&(n+=\" \"),n+=f);return n}export function clsx(){for(var e,t,f=0,n=\"\",o=arguments.length;f<o;f++)(e=arguments[f])&&(t=r(e))&&(n&&(n+=\" \"),n+=t);return n}export default clsx;","/**\n * Wheel hand-off between the sidebar viewport and the section scroller below its navigation.\n * Scrolling down moves the navigation away before the section scroller moves; scrolling up\n * returns the section scroller to its top before the navigation reappears. A gesture whose\n * first event must move the viewport, or starts outside the section scroller, is split in\n * JavaScript until it ends, including its momentum; both elements are then written\n * synchronously in each event, so one gesture continues across the boundary. A gesture the\n * section scroller can take alone keeps native scrolling.\n *\n * A drag over the viewport scrolls the same way when the pointer nears the top or bottom edge\n * of the visible scrolling area, because wheel scrolling is unreliable during a native drag and\n * WebKit and Firefox do not autoscroll a section scroller nested in the viewport.\n */\nimport type { RefCallback } from 'react'\nimport type { SectionScroller, UseSectionScroller } from './contract/slots.ts'\n\n/** Sidebar-owned state of one hand-off. */\nexport interface ScrollHandoff {\n  /** Ref callback for the sidebar's own viewport; binds the wheel hand-off and the drag edge-scrolling listeners. */\n  readonly bindViewportRef: RefCallback<HTMLElement>\n  /** Hook handed to the `sidebar.workspaces` occupant through the slot's hookContext. */\n  readonly useSectionScroller: UseSectionScroller\n}\n\n/**\n * Wheel events closer together than this belong to one gesture, including its momentum phase.\n * DOM wheel events carry no gesture phase, so the gap stands in for it.\n */\nconst GESTURE_GAP_MS = 100\n\n/** Distance from the visible scrolling area's top or bottom edge within which a drag scrolls. */\nconst DRAG_EDGE_PX = 48\n\n/** Drag scrolling speed with the pointer on or past an edge; it falls linearly to zero across the edge band. */\nconst DRAG_MAX_SPEED_PX_PER_MS = 1\n\n/**\n * A drag that sends no `dragover` for this long has left without `dragleave`, `drop`, or `dragend`.\n * HTML drag processing repeats `dragover` every 350ms ±200ms while the pointer rests over a target.\n */\nconst DRAG_STALE_MS = 600\n\n/** Longest interval one drag frame scrolls for, so a delayed frame does not jump. */\nconst DRAG_MAX_STEP_MS = 50\n\n/**\n * Vertical wheel distance in pixels. Pinch-zoom and mostly horizontal events return undefined\n * and keep native scrolling.\n */\nfunction verticalWheelPixels(event: WheelEvent, page: number): number | undefined {\n  if (event.ctrlKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return undefined\n  if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) return event.deltaY * 16\n  if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) return event.deltaY * page\n  return event.deltaY\n}\n\n/** Scroll by `delta`; the browser clamps the write, and the moved distance is returned. */\nfunction scrollClamped(element: HTMLElement, delta: number): number {\n  const before = element.scrollTop\n  element.scrollTop = before + delta\n  return element.scrollTop - before\n}\n\n/**\n * Scroll `delta` across both elements: down moves the viewport before the section scroller,\n * up moves the section scroller before the viewport.\n */\nfunction scrollSplit(viewport: HTMLElement, scroller: HTMLElement | null, delta: number): void {\n  if (scroller === null) {\n    scrollClamped(viewport, delta)\n    return\n  }\n  if (delta > 0) {\n    const rest = delta - scrollClamped(viewport, delta)\n    if (rest > 0) scrollClamped(scroller, rest)\n    return\n  }\n  const rest = delta - scrollClamped(scroller, delta)\n  if (rest < 0) scrollClamped(viewport, rest)\n}\n\n/**\n * Drag scrolling velocity in pixels per millisecond for a pointer at `y`; positive scrolls down.\n * The edges are those of the section scroller's part inside the viewport, or of the viewport alone.\n */\nfunction dragVelocity(viewport: HTMLElement, scroller: HTMLElement | null, y: number): number {\n  const outer = viewport.getBoundingClientRect()\n  const inner = scroller?.getBoundingClientRect() ?? outer\n  const top = Math.max(outer.top, inner.top)\n  const bottom = Math.min(outer.bottom, inner.bottom)\n  const band = Math.min(DRAG_EDGE_PX, (bottom - top) / 2)\n  if (band <= 0) return 0\n  const speed = (depth: number): number => DRAG_MAX_SPEED_PX_PER_MS * Math.min(1, depth / band)\n  if (y < top + band) return -speed(top + band - y)\n  if (y > bottom - band) return speed(y - (bottom - band))\n  return 0\n}\n\n/** Whether the viewport has scrolled the navigation away; sub-pixel remainders count as the end. */\nfunction atEnd(viewport: HTMLElement): boolean {\n  return viewport.scrollHeight - viewport.clientHeight - viewport.scrollTop < 1\n}\n\n/**\n * Create the hand-off for one sidebar render tree.\n * @returns The viewport ref callback and the occupant hook; both keep their identity.\n */\nexport function createScrollHandoff(): ScrollHandoff {\n  let scroller: HTMLElement | null = null\n  let releaseViewport: (() => void) | undefined\n  let lastSplit = Number.NEGATIVE_INFINITY\n  const handle = (viewport: HTMLElement, event: WheelEvent): void => {\n    if (scroller === null || event.defaultPrevented) return\n    const delta = verticalWheelPixels(event, viewport.clientHeight)\n    if (delta === undefined || delta === 0) return\n    // A gesture split here stays here: native scrolling does not resume within its momentum.\n    const continuing = event.cancelable && event.timeStamp - lastSplit < GESTURE_GAP_MS\n    if (!continuing) {\n      // With the navigation gone, the section scroller under the pointer takes this step natively.\n      const native = atEnd(viewport) && scroller.contains(event.target as Node | null)\n      if (native && (delta > 0 || scroller.scrollTop + delta >= 0)) return\n      if (!event.cancelable) {\n        // A native gesture latched to the section scroller stops at its top; the viewport takes the rest.\n        if (native) scrollClamped(viewport, delta + scroller.scrollTop)\n        return\n      }\n    }\n    event.preventDefault()\n    lastSplit = event.timeStamp\n    scrollSplit(viewport, scroller, delta)\n  }\n  // The pointer of the latest dragover and the frame loop that scrolls toward it.\n  let drag: { y: number; at: number } | undefined\n  let frame: number | undefined\n  let lastFrame = 0\n  const stopDrag = (): void => {\n    drag = undefined\n    if (frame !== undefined) cancelAnimationFrame(frame)\n    frame = undefined\n  }\n  const step = (viewport: HTMLElement, now: number): void => {\n    frame = undefined\n    if (drag === undefined || now - drag.at > DRAG_STALE_MS) {\n      drag = undefined\n      return\n    }\n    const velocity = dragVelocity(viewport, scroller, drag.y)\n    if (velocity === 0) return\n    // A frame timestamp can precede the performance.now() of the dragover that requested it.\n    scrollSplit(viewport, scroller, velocity * Math.min(Math.max(now - lastFrame, 0), DRAG_MAX_STEP_MS))\n    lastFrame = now\n    frame = requestAnimationFrame((time) => { step(viewport, time) })\n  }\n  const dragOver = (viewport: HTMLElement, event: DragEvent): void => {\n    drag = { y: event.clientY, at: performance.now() }\n    if (frame !== undefined || dragVelocity(viewport, scroller, event.clientY) === 0) return\n    lastFrame = drag.at\n    frame = requestAnimationFrame((time) => { step(viewport, time) })\n  }\n  const sectionScroller: SectionScroller = {\n    bindScrollerRef: (element) => { scroller = element },\n  }\n  return {\n    bindViewportRef: (element) => {\n      releaseViewport?.()\n      releaseViewport = undefined\n      if (element === null) return\n      const onWheel = (event: WheelEvent): void => { handle(element, event) }\n      const onDragOver = (event: DragEvent): void => { dragOver(element, event) }\n      const onDragLeave = (event: DragEvent): void => {\n        if (!element.contains(event.relatedTarget as Node | null)) stopDrag()\n      }\n      element.addEventListener('wheel', onWheel, { passive: false })\n      // Capture: drop targets inside the viewport stop dragover propagation.\n      element.addEventListener('dragover', onDragOver, true)\n      element.addEventListener('dragleave', onDragLeave, true)\n      element.addEventListener('drop', stopDrag, true)\n      element.addEventListener('dragend', stopDrag, true)\n      releaseViewport = () => {\n        stopDrag()\n        element.removeEventListener('wheel', onWheel)\n        element.removeEventListener('dragover', onDragOver, true)\n        element.removeEventListener('dragleave', onDragLeave, true)\n        element.removeEventListener('drop', stopDrag, true)\n        element.removeEventListener('dragend', stopDrag, true)\n      }\n    },\n    useSectionScroller: () => sectionScroller,\n  }\n}\n","/**\n * Sidebar shell: column geometry and global panel navigation.\n * Collapse is a slide plus crossfade:\n * content freezes at its expanded width (inline style) and fades out in place\n * while the sliding column (AppFrame grid tracks) clips it — nothing reflows\n * mid-slide. At settle the wide-only content unmounts and the upper\n * controls enter the 56px rail from the same horizontal offset (one icon each,\n * same top-down order) on one fade that ends with the slide. The bottom-pinned\n * settings control only fades. The workspace/session browsing region between\n * global panel rows and the foot is the `sidebar.workspaces` registrant's,\n * and the foot holds `sidebar.settings` plus `sidebar.footer.action`; the shell\n * hands them the wide flag (plus an expand request callback for the browser).\n * Through the browser's hookContext, the shell also hands it the scroller hook\n * that continues wheel scrolling over the sidebar viewport into its list.\n *\n * The column also owns whether the scroll regions nested in it draw a\n * scrollbar at all: the shell tracks the pointer and rebinds ui-theme's\n * scrollbar indirection away while it is elsewhere, so a list the user is not\n * pointing at carries no bar.\n */\nimport { useEffect, useId, useLayoutEffect, useMemo, useRef, useState } from 'react'\nimport type { PointerEvent as ReactPointerEvent } from 'react'\nimport clsx from 'clsx'\nimport {\n  FishLogo, IconAppsAddOutlineRegular, IconNewChatOutlineMedium, IconNewChatOutlineRegular,\n  IconPanelLeftOutlineRegular, IconPinFillRegular, focusWithoutRing, isBehindModal, isDarwinDesktop, Menu, ShortcutKeys, Toast,\n  Tooltip, useModalLayer, writeClipboard,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { InjectFace, PropsRenderFactories, PropsRenderSlots, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'\nimport type {\n  SidebarPanelActionsOwnerProps, SidebarPanelMetadata, SidebarRootComponentProps, SidebarRootInjected, SidebarSectionHookContext,\n  SidebarSectionOwnerProps,\n} from './contract/slots.ts'\nimport { FIXED_PANEL_ID } from './panel-pins.ts'\nimport { createScrollHandoff } from './scroll-handoff.ts'\nimport css from './SidebarRoot.module.css'\n\n/** Wide-content unmount delay; matches the 150ms wide-content fade-out. */\nconst COLLAPSE_SETTLE_MS = 150\n\n/** Format complete-build metadata for the local brand badge. */\nfunction localBuildVersion(): string | undefined {\n  const version = process.env.DSH_CLIENT_VERSION\n  if (version === undefined) return undefined\n  const commit = process.env.DSH_CLIENT_COMMIT_HASH\n  return version\n    + (commit === undefined ? '' : `-${commit}`)\n    + (process.env.DSH_CLIENT_GIT_DIRTY === 'true' ? '-dirty' : '')\n}\n\ntype PanelRowProps =\n  Pick<SidebarPanelMetadata, 'id' | 'label'>\n  & Pick<SidebarSectionOwnerProps, 'wide'>\n  & Pick<PropsRuntime<'sidebar'>, 'usePanelInfo'>\n  & Pick<InjectFace<SidebarRootInjected>, 'selectPanel' | 'trackEntryClick' | 'setPinned'>\n  & { readonly unpinLabel: string; readonly unpinTooltip: string; readonly canUnpin: boolean }\n  & PropsRenderFactories\n\n/** Analytics category of an official panel; other panels are never reported. */\nfunction officialEntry(id: string): 'plugin' | 'cron' | undefined {\n  if (id === 'plugins') return 'plugin'\n  return id === 'schedules' ? 'cron' : undefined\n}\n\n/** Each panel row subscribes only to its own selection state. */\nfunction PanelRow({\n  id, label, wide, unpinLabel, unpinTooltip, canUnpin, usePanelInfo, selectPanel, setPinned, trackEntryClick, renderFactorySlot,\n}: PanelRowProps) {\n  const active = usePanelInfo(info => info.activePanelId === id)\n  const trailing = useId()\n  return (\n    <div className={clsx(css.panelEntry, wide && css.panelEntryWide, active && css.panelEntryActive)}>\n      <Tooltip label={label} delayMs={500} disabled={wide}>\n        <button\n          type=\"button\"\n          className={css.panelRow}\n          aria-label={label}\n          aria-describedby={trailing}\n          aria-current={active ? 'page' : undefined}\n          onClick={() => {\n            const entry = officialEntry(id)\n            if (entry !== undefined) trackEntryClick({ menu_name: entry, position: 'sidebar' })\n            selectPanel(id)\n          }}\n        >\n          <span className={css.panelGlyph} aria-hidden=\"true\">\n            {renderFactorySlot('sidebar.panel.icon', { id, size: wide ? 16 : 18, active })}\n          </span>\n          {wide && (\n            <span className={clsx(css.panelTitle, css.wide)}>\n              {label}\n            </span>\n          )}\n          <span id={trailing} className={css.panelTrailing}>{renderFactorySlot('sidebar.panel.trailing', { id, wide, active })}</span>\n        </button>\n      </Tooltip>\n      {wide && canUnpin && <Tooltip label={unpinTooltip} side=\"bottom\" align=\"end\" delayMs={500} portal>\n        <button type=\"button\" className={css.panelUnpin} aria-label={unpinLabel} onClick={(event) => {\n          // Unpin is rendered only while this navigation also renders More.\n          const navigation = event.currentTarget.closest('nav') as HTMLElement\n          const more = navigation.querySelector('button[aria-haspopup=\"menu\"]') as HTMLButtonElement\n          focusWithoutRing(more)\n          setPinned(id, false)\n        }}>\n          <IconPinFillRegular size={14} />\n        </button>\n      </Tooltip>}\n    </div>\n  )\n}\n\ntype PanelMoreMenuProps =\n  Pick<SidebarSectionOwnerProps, 'wide'>\n  & Omit<SidebarPanelActionsOwnerProps, 'onDismiss'>\n  & PropsRenderSlots<'sidebar.panellist.actions'>\n  & Pick<InjectFace<SidebarRootInjected>, 'trackEntryClick'>\n  & { readonly label: string }\n\n/** The panel list's More launcher: a panel-row button whose menu rows come from `sidebar.panellist.actions`. */\nfunction PanelMoreMenu({ wide, label, entries, onOpen, onPinnedChange, trackEntryClick, renderSlot }: PanelMoreMenuProps) {\n  const [open, setOpen] = useState(false)\n  const onDismiss = (): void => { setOpen(false) }\n  return (\n    <Menu open={open} onClose={onDismiss} portal autoFocus className={css.moreAnchor} listClassName={css.moreMenu}\n      anchor={(\n        <Tooltip label={label} delayMs={500} disabled={wide}>\n          <button type=\"button\" className={css.panelRow} aria-label={label} aria-haspopup=\"menu\" aria-expanded={open}\n            onClick={() => {\n              trackEntryClick({ menu_name: 'more', position: 'sidebar' })\n              setOpen(value => !value)\n            }}>\n            <span className={css.panelGlyph} aria-hidden=\"true\"><IconAppsAddOutlineRegular size={wide ? 16 : 18} /></span>\n            {wide && <span className={clsx(css.panelTitle, css.wide)}>{label}</span>}\n          </button>\n        </Tooltip>\n      )}>\n      {renderSlot('sidebar.panellist.actions', { entries, onOpen, onPinnedChange, onDismiss })}\n    </Menu>\n  )\n}\n\n/**\n * Render the sidebar column shell.\n * @param props - composed slot props (runtime share + injected callbacks, contract/slots.ts).\n * @returns the sidebar element tree.\n */\nexport function SidebarRoot({\n  collapsed,\n  width,\n  drawer,\n  startSession,\n  toggleSidebar,\n  selectPanel,\n  setPinned,\n  trackEntryClick,\n  useRemoteAccess,\n  usePanels,\n  useEntryPins,\n  useEntryActions,\n  useShortcuts,\n  usePanelInfo,\n  t,\n  renderSlot,\n  renderFactorySlot,\n}: SidebarRootComponentProps) {\n  const panels = usePanels(snapshot => snapshot)\n  const unpinned = useEntryPins(ids => ids)\n  const activePanelId = usePanelInfo(info => info.activePanelId)\n  const hasEntryActions = useEntryActions(registered => registered)\n  const shortcut = useShortcuts(rows => rows.find(row => row.id === 'sidebar.left.toggle'))\n  const newShortcut = useShortcuts(rows => rows.find(row => row.id === 'session.new'))\n  // A page whose access snapshot excludes starting a Session offers no New Session affordance.\n  const canStartSession = useRemoteAccess('session/create')\n  const toggleLabel = collapsed ? t('toggle.open') : t('toggle.collapse')\n  // Wide content stays mounted while the collapse animates (fading via\n  // .collapsed .wide), unmounts at settle, and remounts right away on expand.\n  // A closed drawer retains its content with the rail phase already settled.\n  const [settled, setSettled] = useState(collapsed)\n  useEffect(() => {\n    if (drawer || !collapsed) { setSettled(collapsed); return }\n    const timer = window.setTimeout(() => { setSettled(true) }, COLLAPSE_SETTLE_MS)\n    return () => { window.clearTimeout(timer) }\n  }, [collapsed, drawer])\n  const windowsTitlebar = document.documentElement.hasAttribute('data-windows-titlebar')\n  const wide = drawer || (windowsTitlebar ? !collapsed : !collapsed || !settled)\n  const [scrollHandoff] = useState(createScrollHandoff)\n  const sectionHookContext = useMemo<SidebarSectionHookContext>(\n    () => ({ useSectionScroller: scrollHandoff.useSectionScroller }), [scrollHandoff],\n  )\n  // The Windows titlebar hosts the New Session controls while the sidebar is collapsed.\n  const openNewSession = (): void => {\n    trackEntryClick({ menu_name: 'new_session', position: windowsTitlebar && collapsed ? 'titlebar' : 'sidebar' })\n    startSession()\n  }\n  // The Windows caption menus occupy the strip to the right of these controls\n  // (that is what --dsh-windows-menu-start reserves), so a right-side bubble\n  // lands under their text. Below the caption is the only clear side.\n  const captionTooltipSide = windowsTitlebar ? 'bottom' : 'right'\n  // Freeze the content at its expanded width while it fades out (collapsed\n  // && wide): the sliding column then clips it instead of reflowing it. The\n  // rail layout (.collapsed styles) only applies once the fade settles.\n  const lastWideWid