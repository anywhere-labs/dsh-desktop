+									await desktop.request(state.permission);
+									combined.throwIfAborted();
+								}
+							}
+						}
+						// Desktop owns prompting; the driver still reports its actual process permissions.
+						args = { ...args, prompt: false };
+					}
 					const result = await activeDriver.callTool(tool.name, JSON.stringify(args), { signal: combined }).catch((error) => {
 						combined.throwIfAborted();
 						throw new CuaDriverError(error instanceof Error ? error.message : String(error), "CUA_DRIVER_FAILED", { cause: error });
