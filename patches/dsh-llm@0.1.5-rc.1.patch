 /**
+* Prepare one call on any registered adapter, old or new. Adapters written
+* before `prepareCall` existed — plain-object plugin adapters, not
+* `LlmAdapter` subclasses — expose only `resolveModel` and `stream`; calling
+* `adapter.prepareCall` on them throws, which surfaced as
+* "registration.adapter.prepareCall is not a function" for otherwise healthy
+* plugins after the 2.0.4 runtime. This passes modern adapters through
+* untouched and synthesizes the `LlmAdapter` default for the rest.
+*/
+async function adapterPrepareCall(adapter, provider, model, signal) {
+	if (typeof adapter.prepareCall === "function") return adapter.prepareCall(provider, model, signal);
+	return {
+		model: await (typeof adapter.resolveModel === "function" ? adapter.resolveModel(provider, model, signal) : { provider, id: model, name: model }),
+		stream: (options) => adapter.stream(options)
+	};
+}
