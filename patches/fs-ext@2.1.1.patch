diff --git a/install.js b/install.js
new file mode 100644
--- /dev/null
+++ b/install.js
@@ -0,0 +1,16 @@
+"use strict";
+
+if (process.platform !== "win32") {
+  var result = require("node:child_process").spawnSync(
+    process.execPath,
+    [require.resolve("node-gyp/bin/node-gyp.js"), "configure", "build"],
+    { stdio: "inherit" }
+  );
+
+  if (result.error) {
+    throw result.error;
+  }
+  if (result.status !== 0) {
+    process.exit(result.status || 1);
+  }
+}
