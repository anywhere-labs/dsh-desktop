+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import GoalService from '@deepseek-ai/dsh-goal'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import * as GoalProgressGuard from '@deepseek-ai/dsh-goal-progress-guard'
+import * as GoalRoundDriver from '@deepseek-ai/dsh-goal-round-driver'
+import type { Config } from '@deepseek-ai/dsh-goal-progress-guard'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+/**
+ * Behavior suite for the goal-progress guard: round-trail classification
+ * (mutation / observation / no-op), the advisory notice folded onto the next
+ * goal round's admitted messages, the optional hard block through the durable
+ * goal channel, and fail-loud config validation — all driven through a real
+ * agent loop against a scripted mock adapter (no network).
+ */
+
+/** Boot the core spine + goal service + the guard; the caller registers adapters and tools. */
+async function harness(config: Config = {}): Promise<Context> {
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(GoalService)
+  await ctx.plugin(GoalProgressGuard, config)
+  return ctx
+}
+
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => { const d = ctx.on('agent/status', ({ agent: s, status: st }) => { if (s === agent && st === 'idle') { d(); resolve() } }) })
+}
+
+/** Queue one goal continuation round for the current goal, as the round driver would. */
+async function runRound(ctx: Context, agent: Agent, round: number): Promise<void> {
+  const goal = ctx.goals.get(agent)
+  if (goal === undefined) throw new Error('test requires a current goal')
+  const idle = waitForIdle(ctx, agent)
+  agent.followup(createUserMessage({
+    content: [{ type: 'text', text: `<goal_round> round ${round}` }],
+    source: { kind: 'goal', goalId: goal.id, revision: goal.revision, round },
+  }))
+  await idle
+}
+
+/** Every guard-injected user message in the agent's log, flattened for terse assertions. */
+function notices(agent: Agent): { text: string; source: unknown }[] {
+  return agent.session.snapshotEvents()
+    .filter((e): e is SessionEvent<'user/message'> =>
+      e.type === 'user/message' && e.data.source.kind === 'goal-progress-guard')
+    .map(e => ({
+      text: e.data.content.map(block => block.type === 'text' ? block.text : '').join('|'),
+      source: e.data.source,
+    }))
+}
+
+describe('advisory mode (default)', () => {
+  it('injects a logged strategy-change notice into the round after a no-op round', async () => {
+    const ctx = await harness()
+    const adapter = new MockAdapter([
+      textResponse('round 1: only narration'),
+      textResponse('round 2: still thinking'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 9 })
+
+    await runRound(ctx, agent, 1)
+    expect(notices(agent)).toHaveLength(0) // first round has no predecessor to judge
+
+    await runRound(ctx, agent, 2)
+    const found = notices(agent)
+    expect(found).toHaveLength(1)
+    expect(found[0]!.text).toContain('round 1 closed with no verifiable state delta')
+    expect(found[0]!.text).toContain('Consecutive no-progress rounds: 1')
+    expect(found[0]!.text).toContain('Do not repeat the previous approach')
+    expect(found[0]!.source).toEqual({
+      kind: 'goal-progress-guard',
+      form: 'notice',
+      summary: 'no-progress × 1',
+    })
+    // Logged ⇒ model-visible: the notice rode the admitted round-2 request.
+    const round2Request = adapter.requests[1]
+    expect(JSON.stringify(round2Request?.messages)).toContain('<goal_progress>')
+  })
+
+  it('stays silent after a round with a verifiable mutation', async () => {
+    const ctx = await harness()
+    ctx.tools.register(defineContentToolFixture({
+      name: 'write',
+      description: 'w',
+      parameters: {},
+      async execute() { return [{ type: 'text', text: 'written' }] },
+    }))
+    const adapter = new MockAdapter([
+      toolCallResponse('c1', 'write', { path: 'a.ts' }),
+      textResponse('round 1: wrote a file'),
+      textResponse('round 2: continued'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 9 })
+
+    await runRound(ctx, agent, 1)
+    await runRound(ctx, agent, 2)
+    expect(notices(agent)).toHaveLength(0)
+  })
+
+  it('resets the streak after a mutation round between two no-op rounds', async () => {
+    const ctx = await harness()
+    ctx.tools.register(defineContentToolFixture({
+      name: 'write',
+      description: 'w',
+      parameters: {},
+      async execute() { return [{ type: 'text', text: 'written' }] },
+    }))
+    const adapter = new MockAdapter([
+      textResponse('round 1: noop'),
+      toolCallResponse('c1', 'write', { path: 'a.ts' }),
+      textResponse('round 2: wrote'),
+      textResponse('round 3: noop'),
+      textResponse('round 4: noop'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 9 })
+
+    await runRound(ctx, agent, 1) // noop → streak 1
+    await runRound(ctx, agent, 2) // notice(× 1), then mutation → streak 0
+    await runRound(ctx, agent, 3) // silent; noop → streak 1
+    await runRound(ctx, agent, 4) // notice(× 1) again, not × 2
+    const found = notices(agent)
+    expect(found).toHaveLength(2)
+    expect(found[0]!.text).toContain('Consecutive no-progress rounds: 1')
+    expect(found[1]!.text).toContain('Consecutive no-progress rounds: 1')
+  })
+})
+
+describe('blocking mode', () => {
+  it('blocks the goal through the durable channel once the streak reaches the configured threshold', async () => {
+    const ctx = await harness({ blockAfterNoProgressRounds: 2 })
+    const adapter = new MockAdapter([
+      textResponse('round 1: noop'),
+      textResponse('round 2: noop'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 9 })
+
+    await runRound(ctx, agent, 1) // noop → streak 1
+    await runRound(ctx, agent, 2) // advisory only (1 < 2); noop → streak 2
+    await runRound(ctx, agent, 3) // rejected at admission, goal blocked
+    expect(notices(agent)).toHaveLength(1)
+    expect(adapter.requests).toHaveLength(2) // round 3 never reached the model
+    expect(ctx.goals.get(agent)).toMatchObject({
+      phase: 'blocked',
+      blockedReason: { code: 'no-progress' },
+    })
+  })
+})
+
+describe('composition with the round driver', () => {
+  it('annotates driver-queued rounds and stays out of the round-limit block', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(GoalService)
+    await ctx.plugin(GoalRoundDriver)
+    await ctx.plugin(GoalProgressGuard)
+    const adapter = new MockAdapter([
+      textResponse('round 1: noop'),
+      textResponse('round 2: noop'),
+      textResponse('round 3: noop'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    const blocked = new Promise<void>((resolve) => {
+      const d = ctx.on('goal/changed', ({ agent: a, change }) => {
+        if (a === agent && change.operation === 'block') { d(); resolve() }
+      })
+    })
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 3 })
+    await blocked
+
+    // The driver exhausted the round budget on its own terms; the guard only
+    // annotated rounds 2 and 3 and never vetoed an admitted round.
+    expect(ctx.goals.get(agent)).toMatchObject({
+      phase: 'blocked',
+      roundsStarted: 3,
+      blockedReason: { code: 'round-limit' },
+    })
+    expect(adapter.requests).toHaveLength(3)
+    const found = notices(agent)
+    expect(found).toHaveLength(2)
+    expect(found.map(n => n.source)).toEqual([
+      { kind: 'goal-progress-guard', form: 'notice', summary: 'no-progress × 1' },
+      { kind: 'goal-progress-guard', form: 'notice', summary: 'no-progress × 2' },
+    ])
+  })
+})
+
+describe('config validation', () => {
+  it('fails loud on a negative block threshold', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(GoalService)
+    await expect(ctx.plugin(GoalProgressGuard, { blockAfterNoProgressRounds: -1 }))
+      .rejects.toThrow('blockAfterNoProgressRounds')
+  })
+
+  it('fails loud on an empty mutation pattern', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(GoalService)
+    await expect(ctx.plugin(GoalProgressGuard, { mutationTools: [''] }))
+      .rejects.toThrow('mutationTools')
+  })
+})
