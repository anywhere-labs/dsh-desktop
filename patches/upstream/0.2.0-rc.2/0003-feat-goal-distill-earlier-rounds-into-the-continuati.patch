+/**
+ * Goal-round ledger: heuristic per-round distillation for the same-session
+ * goal loop. Continuation rounds otherwise open with only the objective and
+ * a round counter, so the model re-derives "what is known, what was tried,
+ * why it failed" from an ever-growing raw transcript. Before each admitted
+ * continuation round enters its step, this plugin scans the session log,
+ * attributes tool activity to the current goal's rounds, and appends one
+ * budget-capped `<goal_ledger>` notice to the admitted messages: mutations
+ * so far, failed approaches, and repeated identical calls. Logged implies
+ * model-visible, so the ledger survives replay; the scan is stateless and
+ * heuristic — no extra model call, no history rewriting — and composes with
+ * `dsh-goal-round-driver` and `dsh-goal-progress-guard` in either waterfall
+ * order.
+ * @module @deepseek-ai/dsh-goal-round-ledger
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import type { GoalMessageSource } from '@deepseek-ai/dsh-goal'
+import { boundContextSummary, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { ContextFormed, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { UserMessage } from '@deepseek-ai/dsh-session'
+
+declare module '@deepseek-ai/dsh-llm' {
+  interface MessageSourceMap {
+    'goal-round-ledger': { kind: 'goal-round-ledger' } & ContextFormed
+  }
+}
+
+export const name = 'goal-round-ledger'
+export const inject = ['goals']
+
+/**
+ * Plugin config, validated by the same-named schemastery schema plus the
+ * load-time checks in `apply` (misconfiguration fails loud at plugin load).
+ * All deployment-varying choices are Config fields.
+ */
+export interface Config {
+  /**
+   * Tool-name patterns whose successful result is listed under "Changed so
+   * far"; `*` is a wildcard (default `['write', 'edit', 'apply_patch',
+   * 'str_replace*']`). A pattern matching no registered tool is valid.
+   */
+  mutationTools?: string[]
+  /** Character cap of the injected ledger block (default `1200`). */
+  charBudget?: number
+  /** How many recent session events the scan walks (default `600`). */
+  eventWindow?: number
+  /** Entries kept per ledger section before budget shrinking (default `5`). */
+  maxEntriesPerSection?: number
+}
+
+/** Schemastery config for the goal-round ledger. */
+export const Config: z<Config> = z.object({
+  mutationTools: z.array(z.string()).default(['write', 'edit', 'apply_patch', 'str_replace*']),
+  charBudget: z.number().default(1200),
+  eventWindow: z.number().default(600),
+  maxEntriesPerSection: z.number().default(5),
+})
+
+/** Fully materialized ledger policy. */
+interface ResolvedConfig {
+  readonly mutationTools: readonly RegExp[]
+  readonly charBudget: number
+  readonly eventWindow: number
+  readonly maxEntriesPerSection: number
+}
+
+/** One in-flight tool call recorded during the scan, pending its result. */
+interface CallRecord {
+  readonly name: string
+  readonly argumentsPreview: string
+  readonly round: number
+}
+
+/** The distilled, render-ready state of one goal's earlier rounds. */
+interface Ledger {
+  /** Distinct round numbers of this goal seen in the window. */
+  readonly rounds: readonly number[]
+  /** `name(preview)` of each successful mutation, oldest first. */
+  readonly mutations: string[]
+  /** `name(preview) → error` of each failed call, oldest first. */
+  readonly failures: string[]
+  /** Identical calls seen at least twice: `name(preview) × n`. */
+  readonly repeats: string[]
+}
+
+/** Whether a source identifies an automatic, positive-numbered goal round. */
+function isGoalRoundSource(source: UserMessage['source']): source is GoalMessageSource {
+  return source.kind === 'goal' && (source as GoalMessageSource).round > 0
+}
+
+/** Compile one `*`-wildcard tool pattern into an anchored predicate. */
+function wildcard(pattern: string): RegExp {
+  return new RegExp(`^${pattern.split('*').map(escapeRegExp).join('.*')}$`)
+}
+
+/** Escape every regex metacharacter in a literal pattern segment. */
+function escapeRegExp(segment: string): string {
+  return segment.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+}
+
+/** One-line, length-capped rendering of raw call arguments or error text. */
+function preview(text: string, max: number): string {
+  const flat = text.replace(/\s+/g, ' ').trim()
+  return flat.length <= max ? flat : `${flat.slice(0, max - 1)}…`
+}
+
+/** Extract text content from one message's content blocks. */
+function textOf(content: readonly { type: string }[]): string {
+  return content
+    .map(block => block.type === 'text' ? (block as { type: 'text'; text: string }).text : '')
+    .join('\n')
+}
+
+/** Validate config even when apply is called directly outside Loader normalization. */
+function resolveConfig(config: Config): ResolvedConfig {
+  const mutationTools = config.mutationTools ?? ['write', 'edit', 'apply_patch', 'str_replace*']
+  if (mutationTools.some(pattern => pattern.length === 0)) {
+    throw new TypeError('goal-round-ledger: mutationTools entries must be non-empty')
+  }
+  const resolved: Omit<ResolvedConfig, 'mutationTools'> = {
+    charBudget: config.charBudget ?? 1200,
+    eventWindow: config.eventWindow ?? 600,
+    maxEntriesPerSection: config.maxEntriesPerSection ?? 5,
+  }
+  for (const [field, value] of Object.entries(resolved)) {
+    if (!Number.isSafeInteger(value) || value < 1) {
+      throw new TypeError(`goal-round-ledger: ${field} must be a positive safe integer`)
+    }
+  }
+  return { ...resolved, mutationTools: mutationTools.map(wildcard) }
+}
+
+/**
+ * Attribute the window's tool activity to the given goal's rounds. A turn
+ * opened by a goal-round message owns its tool calls until `turn/end`; a
+ * direct human prompt suspends attribution, so human-driven tool work never
+ * lands on the goal's ledger.
+ */
+function scanLedger(agent: Agent, goalId: string, resolved: ResolvedConfig): Ledger {
+  const events = agent.session.snapshotEvents().slice(-resolved.eventWindow)
+  const rounds = new Set<number>()
+  const mutations: string[] = []
+  const failures: string[] = []
+  const signatures = new Map<string, number>()
+  const calls = new Map<ToolCallId, CallRecord>()
+  let currentRound: number | undefined
+  const isMutation = (name: string): boolean => resolved.mutationTools.some(pattern => pattern.test(name))
+  for (const event of events) {
+    if (event.type === 'user/message') {
+      if (isGoalRoundSource(event.data.source) && event.data.source.goalId === goalId) {
+        currentRound = event.data.source.round
+        rounds.add(currentRound)
+      }
+      else if (event.data.source.kind === 'user') {
+        currentRound = undefined
+      }
+      continue
+    }
+    if (event.type === 'turn/end') {
+      currentRound = undefined
+      continue
+    }
+    if (currentRound === undefined) continue
+    if (event.type === 'tool/call') {
+      const record: CallRecord = {
+        name: event.data.name,
+        argumentsPreview: preview(event.data.arguments, 60),
+        round: currentRound,
+      }
+      calls.set(event.data.callId, record)
+      const signature = `${record.name}(${record.argumentsPreview})`
+      signatures.set(signature, (signatures.get(signature) ?? 0) + 1)
+      continue
+    }
+    if (event.type === 'tool/result') {
+      const record = calls.get(event.data.message.toolCallId)
+      calls.delete(event.data.message.toolCallId)
+      if (record === undefined) continue
+      const failed = event.data.error !== undefined || event.data.message.isError === true
+      const signature = `${record.name}(${record.argumentsPreview})`
+      if (failed) {
+        const reason = event.data.error?.reason ?? preview(textOf(event.data.message.content), 80)
+        failures.push(`${signature} → ${preview(reason, 80)}`)
+      }
+      else if (isMutation(record.name)) {
+        mutations.push(signature)
+      }
+    }
+  }
+  const repeats = [...signatures.entries()]
+    .filter(([, count]) => count >= 2)
+    .sort((a, b) => b[1] - a[1])
+    .map(([signature, count]) => `${signature} × ${count}`)
+  const cap = resolved.maxEntriesPerSection
+  return {
+    rounds: [...rounds].sort((a, b) => a - b),
+    mutations: mutations.slice(-cap),
+    failures: failures.slice(-cap),
+    repeats: repeats.slice(0, cap),
+  }
+}
+
+/** Tail marker replacing a ledger body that still overflows after shrinking. */
+const TRUNCATION_MARKER = '\n…(ledger truncated)\n</goal_ledger>'
+
+/** Render the ledger within budget, shrinking oldest entries first. */
+export function renderLedger(objective: string, nextRound: number, maxRounds: number, ledger: Ledger, charBudget: number): string {
+  const build = (mutations: readonly string[], failures: readonly string[], repeats: readonly string[]): string => {
+    const sections: string[] = []
+    sections.push(mutations.length > 0
+      ? `Changed so far:\n${mutations.map(entry => `- ${entry}`).join('\n')}`
+      : 'Changed so far: nothing verified yet.')
+    if (failures.length > 0) {
+      sections.push(`Failed approaches (do not retry unchanged):\n${failures.map(entry => `- ${entry}`).join('\n')}`)
+    }
+    if (repeats.length > 0) {
+      sections.push(`Repeated identical calls:\n${repeats.map(entry => `- ${entry}`).join('\n')}`)
+    }
+    return '<goal_ledger>\n'
+      + `Goal ${JSON.stringify(objective)}: entering round ${nextRound}/${maxRounds}, `
+      + `distilled from ${ledger.rounds.length} earlier round(s). The full transcript stays available; `
+      + 'this is the decision-relevant summary.\n\n'
+      + sections.join('\n\n')
+      + '\n\nOpen this round with one concrete, verifiable action before calling any tool.\n'
+      + '</goal_ledger>'
+  }
+  let { mutations, failures, repeats } = ledger
+  let text = build(mutations, failures, repeats)
+  // Budget shrinking drops history, never the framing or the closing rule.
+  while (text.length > charBudget && (mutations.length + failures.length + repeats.length) > 0) {
+    if (mutations.length > 0) mutations = mutations.slice(1)
+    else if (repeats.length > 0) repeats = repeats.slice(1)
+    else failures = failures.slice(1)
+    text = build(mutations, failures, repeats)
+  }
+  if (text.length > charBudget && charBudget > TRUNCATION_MARKER.length) {
+    text = `${text.slice(0, charBudget - TRUNCATION_MARKER.length)}${TRUNCATION_MARKER}`
+  }
+  return text
+}
+
+/**
+ * Register the pre-step ledger injection.
+ * @param ctx - plugin context providing the goal service.
+ * @param config - deployment policy; see {@link Config}.
+ */
+export function apply(ctx: Context, config: Config): void {
+  const resolved = resolveConfig(config)
+
+  ctx.on('agent/pre-step', async ({ agent, messages }, next): Promise<PreStepDecision> => {
+    const submitted = messages.find((message): message is UserMessage & { source: GoalMessageSource } =>
+      isGoalRoundSource(message.source))
+    const decision = await next()
+    if (submitted === undefined || decision.kind !== 'enter') return decision
+    if (submitted.source.round <= 1) return decision // round 1 has nothing to distill
+    const goal = ctx.goals.get(agent)
+    if (goal === undefined || goal.id !== submitted.source.goalId) return decision
+    const ledger = scanLedger(agent, goal.id, resolved)
+    if (ledger.rounds.length === 0) return decision
+    const notice = createUserMessage({
+      content: [{
+        type: 'text',
+        text: renderLedger(goal.objective, submitted.source.round, goal.maxGoalRounds, ledger, resolved.charBudget),
+      }],
+      source: {
+        kind: 'goal-round-ledger',
+        form: 'notice',
+        summary: boundContextSummary(`ledger for round ${submitted.source.round}`),
+      },
+    })
+    return { ...decision, messages: [...decision.messages, notice] }
+  })
+}
