+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import GoalService from '@deepseek-ai/dsh-goal'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import * as GoalRoundLedger from '@deepseek-ai/dsh-goal-round-ledger'
+import type { Config } from '@deepseek-ai/dsh-goal-round-ledger'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+/**
+ * Behavior suite for the goal-round ledger: per-round attribution of tool
+ * activity to the owning goal, ledger injection from round 2 onward, the
+ * mutation / failure / repeat sections, the character budget, human-turn
+ * attribution exclusion, and fail-loud config validation — all through a real
+ * agent loop against a scripted mock adapter (no network).
+ */
+
+/** Boot the core spine + goal service + the ledger, plus the fixture tools. */
+async function harness(config: Config = {}): Promise<Context> {
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(GoalService)
+  await ctx.plugin(GoalRoundLedger, config)
+  ctx.tools.register(defineContentToolFixture({
+    name: 'write',
+    description: 'w',
+    parameters: {},
+    async execute() { return [{ type: 'text', text: 'written' }] },
+  }))
+  ctx.tools.register(defineContentToolFixture({
+    name: 'read',
+    description: 'r',
+    parameters: {},
+    async execute() { return [{ type: 'text', text: 'file body' }] },
+  }))
+  ctx.tools.register(defineContentToolFixture({
+    name: 'bash',
+    description: 'b',
+    parameters: {},
+    async execute() { throw new Error('exit code 1: 2 failed') },
+  }))
+  return ctx
+}
+
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => { const d = ctx.on('agent/status', ({ agent: s, status: st }) => { if (s === agent && st === 'idle') { d(); resolve() } }) })
+}
+
+/** Queue one goal continuation round for the current goal, as the round driver would. */
+async function runRound(ctx: Context, agent: Agent, round: number): Promise<void> {
+  const goal = ctx.goals.get(agent)
+  if (goal === undefined) throw new Error('test requires a current goal')
+  const idle = waitForIdle(ctx, agent)
+  agent.followup(createUserMessage({
+    content: [{ type: 'text', text: `<goal_round> round ${round}` }],
+    source: { kind: 'goal', goalId: goal.id, revision: goal.revision, round },
+  }))
+  await idle
+}
+
+/** Send one direct human prompt and wait for the turn to settle. */
+async function prompt(ctx: Context, agent: Agent, text: string): Promise<void> {
+  const idle = waitForIdle(ctx, agent)
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+  await idle
+}
+
+/** Every ledger message in the agent's log, flattened to joined text. */
+function ledgers(agent: Agent): string[] {
+  return agent.session.snapshotEvents()
+    .filter((e): e is SessionEvent<'user/message'> =>
+      e.type === 'user/message' && e.data.source.kind === 'goal-round-ledger')
+    .map(e => e.data.content.map(block => block.type === 'text' ? block.text : '').join('\n'))
+}
+
+describe('ledger injection', () => {
+  it('distills mutations, failures, and repeats into the second round', async () => {
+    const ctx = await harness()
+    const adapter = new MockAdapter([
+      toolCallResponse('w1', 'write', { path: 'src/a.ts' }),
+      toolCallResponse('b1', 'bash', { command: 'pnpm test' }),
+      toolCallResponse('r1', 'read', { path: 'a.ts' }),
+      toolCallResponse('r2', 'read', { path: 'a.ts' }),
+      textResponse('round 1 done'),
+      textResponse('round 2 done'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 9 })
+
+    await runRound(ctx, agent, 1)
+    expect(ledgers(agent)).toHaveLength(0) // round 1 has nothing to distill
+
+    await runRound(ctx, agent, 2)
+    const found = ledgers(agent)
+    expect(found).toHaveLength(1)
+    const ledger = found[0]!
+    expect(ledger).toContain('entering round 2/9')
+    expect(ledger).toContain('Changed so far:')
+    expect(ledger).toContain('write({"path":"src/a.ts"})')
+    expect(ledger).toContain('Failed approaches (do not retry unchanged):')
+    expect(ledger).toContain('bash({"command":"pnpm test"})')
+    expect(ledger).toContain('exit code 1: 2 failed')
+    expect(ledger).toContain('Repeated identical calls:')
+    expect(ledger).toContain('read({"path":"a.ts"}) × 2')
+    expect(ledger).toContain('one concrete, verifiable action')
+  })
+
+  it('never attributes human-turn tool work to the goal', async () => {
+    const ctx = await harness()
+    const adapter = new MockAdapter([
+      toolCallResponse('w1', 'write', { path: 'src/human.ts' }),
+      textResponse('human turn done'),
+      textResponse('round 1 done'),
+      textResponse('round 2 done'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+
+    await prompt(ctx, agent, 'write a file yourself')
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 9 })
+    await runRound(ctx, agent, 1)
+    await runRound(ctx, agent, 2)
+
+    const found = ledgers(agent)
+    expect(found).toHaveLength(1)
+    expect(found[0]).toContain('Changed so far: nothing verified yet.')
+    expect(found[0]).not.toContain('src/human.ts')
+  })
+
+  it('respects the character budget', async () => {
+    const budget = 400
+    const ctx = await harness({ charBudget: budget })
+    const adapter = new MockAdapter([
+      toolCallResponse('w1', 'write', { path: 'src/a-very-long-file-name-for-budget-pressure.ts' }),
+      toolCallResponse('b1', 'bash', { command: 'pnpm test -- --run-in-band --verbose' }),
+      textResponse('round 1 done'),
+      textResponse('round 2 done'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    ctx.goals.create(agent, { objective: 'finish the feature', maxGoalRounds: 9 })
+
+    await runRound(ctx, agent, 1)
+    await runRound(ctx, agent, 2)
+    const found = ledgers(agent)
+    expect(found).toHaveLength(1)
+    expect(found[0]!.length).toBeLessThanOrEqual(budget)
+    expect(found[0]).toContain('</goal_ledger>')
+  })
+})
+
+describe('config validation', () => {
+  it('fails loud on a non-positive character budget', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(GoalService)
+    await expect(ctx.plugin(GoalRoundLedger, { charBudget: 0 }))
+      .rejects.toThrow('charBudget')
+  })
+})
