 const AUTO_RAW_REASON = `  direct user authorized inspection only\nTEST_ONLY_SECRET_${'x'.repeat(16_384)}  `
 const AUTO_FINAL_TEXT = 'SHIPPED_AUTO_REVIEW_REJECTION_OBSERVED'
@@ -136,6 +138,24 @@ class ShippedAutoAdapter extends LlmAdapter {
   }
 }
 
+/** Minimal adapter proving that the shipped Web persona permits request-time routing. */
+class ShippedLateRouteAdapter extends LlmAdapter {
+  readonly requests: GenerateOptions[] = []
+
+  override async listModels(provider: string) {
+    return [{ provider, id: LATE_ROUTE_MODEL, name: LATE_ROUTE_MODEL }]
+  }
+
+  override resolveModel(provider: string, model: string): Promise<LlmResolvedModelInfo> {
+    return Promise.resolve({ provider, id: model, name: model, contextWindow: 128_000 })
+  }
+
+  override async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(options)
+    yield* textChunks('late-route-ok')
+  }
+}
+
 type ChildAutoRisk = 'low' | 'medium' | 'high'
 type ChildAutoDecision = 'allow' | 'deny'
 
@@ -651,6 +671,55 @@ it('assembles the shipped Web transport, catalog, guidance, and defaults', async
   }
 }, 120_000)
 
+it('keeps shipped Web personas usable when the model is selected at request time', async () => {
+  scaffold = await launchWebScaffold({ deepSeekMissingCredential: true })
+  const ctx = scaffold.ctx
+  const adapter = new ShippedLateRouteAdapter()
+  ctx.effect(
+    () => ctx.llm.registerAdapter([LATE_ROUTE_PROVIDER], adapter),
+    'shipped Web late-route adapter',
+  )
+  ctx.effect(() => ctx.on('agent/request', async (_payload, next) => ({
+    ...await next(),
+    provider: LATE_ROUTE_PROVIDER,
+    model: LATE_ROUTE_MODEL,
+  })), 'shipped Web late-route selection')
+
+  const targets = [
+    { id: 'shipped-web-late-route-global' },
+    { id: 'shipped-web-late-route-standard', preset: 'standard' },
+  ] as const
+  for (const target of targets) {
+    const handle = await ctx.agents.create({
+      sessionId: SessionId(target.id),
+      meta: { cwd: scaffold.workspaceCwd },
+      agentOptions: {},
+      ...('preset' in target ? {
+        setup: agentCtx => ctx.agentPresets.mount(agentCtx, target.preset).then(() => undefined),
+      } : {}),
+    })
+    try {
+      handle.agent.followup(createUserMessage({
+        content: [{ type: 'text', text: 'Reply with OK.' }],
+        source: { kind: 'user' },
+      }))
+      await handle.agent.whenIdle()
+    } finally {
+      await handle.dispose()
+    }
+  }
+
+  expect(adapter.requests).toHaveLength(targets.length)
+  for (const request of adapter.requests) {
+    expect(request.model).toBe(LATE_ROUTE_MODEL)
+    const systemMessage = request.messages[0]
+    expect(systemMessage?.role).toBe('system')
+    expect(systemMessage?.role === 'system'
+      ? systemMessage.content.flatMap(block => block.type === 'text' ? [block.text] : []).join('')
+      : '').toContain('You are a coding agent powered by DeepSeek Harness.')
+  }
+}, 120_000)
+
 it('ships PTC with run_code but without the general workflow SDK binding', async () => {
