@@ -0,0 +1,283 @@
+/**
+ * Advisory goal-round progress guard. It classifies the tool trail of every
+ * admitted goal round from the session event log as a verifiable mutation, a
+ * weak observation, or a no-op, keeps a consecutive no-progress streak for the
+ * goal one agent is currently pursuing, and — before the next continuation
+ * round of the same goal enters its step — appends a logged strategy-change
+ * notice. A new goal starts with an empty streak, so no round is annotated or
+ * blocked for the failures of an earlier goal. With
+ * `blockAfterNoProgressRounds > 0` the streak instead hard-blocks the goal
+ * through the durable `goals.block` channel and rejects the round. The guard
+ * observes and annotates only; it never rewrites the driver's reservation
+ * bookkeeping, so it composes with `dsh-goal-round-driver` in either
+ * waterfall order.
+ * @module @deepseek-ai/dsh-goal-progress-guard
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import type { GoalMessageSource } from '@deepseek-ai/dsh-goal'
+import { boundContextSummary, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { ContextFormed, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { Session, SessionEvent, UserMessage } from '@deepseek-ai/dsh-session'
+
+declare module '@deepseek-ai/dsh-llm' {
+  interface MessageSourceMap {
+    'goal-progress-guard': { kind: 'goal-progress-guard' } & ContextFormed
+  }
+}
+
+export const name = 'goal-progress-guard'
+export const inject = ['agents', 'goals']
+
+/**
+ * Plugin config, validated by the same-named schemastery schema plus the
+ * load-time checks in `apply` (misconfiguration fails loud: a non-integer or
+ * negative `blockAfterNoProgressRounds` throws at plugin load). All
+ * deployment-varying choices are Config fields; defaults keep the guard
+ * purely advisory so existing consumers retain the driver's contract.
+ */
+export interface Config {
+  /**
+   * Tool-name patterns whose successful result counts as a verifiable state
+   * mutation; `*` is a wildcard (default `['write', 'edit', 'apply_patch',
+   * 'str_replace*']`). A pattern matching no registered tool is valid.
+   */
+  mutationTools?: string[]
+  /**
+   * Hard-block the goal after this many consecutive no-progress rounds; `0`
+   * (default) disables blocking and keeps the guard advisory-only.
+   */
+  blockAfterNoProgressRounds?: number
+}
+
+/** Schemastery config for the goal progress guard. */
+export const Config: z<Config> = z.object({
+  mutationTools: z.array(z.string()).default(['write', 'edit', 'apply_patch', 'str_replace*']),
+  blockAfterNoProgressRounds: z.number().default(0),
+})
+
+/** Fully materialized guard policy. */
+interface ResolvedConfig {
+  readonly mutationTools: readonly RegExp[]
+  readonly blockAfterNoProgressRounds: number
+}
+
+/** Per-round tool-trail counters collected from the session event stream. */
+interface RoundTrail {
+  /** Goal identity of the round being trailed. */
+  readonly goalId: string
+  /** Positive round number being trailed. */
+  readonly round: number
+  /** Successful results from mutation-pattern tools. */
+  mutations: number
+  /** Successful results from any other tool. */
+  observations: number
+  /** Failed tool results. */
+  failures: number
+}
+
+/** Closed outcome vocabulary for one finished round. */
+type RoundOutcome = 'progress' | 'observation' | 'noop'
+
+/** Process-local per-agent guard state; the streak inside it belongs to one goal. */
+interface GuardState {
+  readonly agent: Agent
+  /** Trail of the currently open round, if a goal round was admitted. */
+  trail: RoundTrail | undefined
+  /** Tool names of in-flight calls, keyed by call id for result pairing. */
+  calls: Map<ToolCallId, string>
+  /** Goal the streak and notice wording describe, empty until one is admitted. */
+  streakGoalId: string | undefined
+  /** Consecutive rounds closed without any successful tool result. */
+  noopStreak: number
+  /** Round number of the last closed trail, for notice wording. */
+  lastRound: number
+  /** Counters of the last closed trail, for notice wording. */
+  lastTrail: Pick<RoundTrail, 'mutations' | 'observations' | 'failures'>
+}
+
+/** Whether a source identifies an automatic, positive-numbered goal round. */
+function isGoalRoundSource(source: UserMessage['source']): source is GoalMessageSource {
+  return source.kind === 'goal' && (source as GoalMessageSource).round > 0
+}
+
+/** Compile one `*`-wildcard tool pattern into an anchored predicate. */
+function wildcard(pattern: string): RegExp {
+  return new RegExp(`^${pattern.split('*').map(escapeRegExp).join('.*')}$`)
+}
+
+/** Escape every regex metacharacter in a literal pattern segment. */
+function escapeRegExp(segment: string): string {
+  return segment.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+}
+
+/** Validate config even when apply is called directly outside Loader normalization. */
+function resolveConfig(config: Config): ResolvedConfig {
+  const mutationTools = config.mutationTools ?? ['write', 'edit', 'apply_patch', 'str_replace*']
+  if (mutationTools.some(pattern => pattern.length === 0)) {
+    throw new TypeError('goal-progress-guard: mutationTools entries must be non-empty')
+  }
+  const blockAfter = config.blockAfterNoProgressRounds ?? 0
+  if (!Number.isSafeInteger(blockAfter) || blockAfter < 0) {
+    throw new TypeError('goal-progress-guard: blockAfterNoProgressRounds must be a non-negative safe integer')
+  }
+  return { mutationTools: mutationTools.map(wildcard), blockAfterNoProgressRounds: blockAfter }
+}
+
+/** Human-readable unexpected values for logs. */
+function renderThrown(value: unknown): string {
+  return value instanceof Error ? value.message : String(value)
+}
+
+/**
+ * Register the round-trail observer and the pre-step notice/block hook.
+ * @param ctx - plugin context providing the agent registry and goal service.
+ * @param config - deployment policy; see {@link Config}.
+ */
+export function apply(ctx: Context, config: Config): void {
+  const resolved = resolveConfig(config)
+  const states = new WeakMap<Agent, GuardState>()
+
+  /** Create state for an exact currently live agent. */
+  function stateFor(agent: Agent): GuardState {
+    const existing = states.get(agent)
+    if (existing !== undefined) return existing
+    const state: GuardState = {
+      agent,
+      trail: undefined,
+      calls: new Map(),
+      streakGoalId: undefined,
+      noopStreak: 0,
+      lastRound: 0,
+      lastTrail: { mutations: 0, observations: 0, failures: 0 },
+    }
+    states.set(agent, state)
+    return state
+  }
+
+  /** Whether a successful result of this tool counts as a state mutation. */
+  function isMutation(toolName: string): boolean {
+    return resolved.mutationTools.some(pattern => pattern.test(toolName))
+  }
+
+  /** Fold one finished trail into the streak and the notice wording record. */
+  function closeTrail(state: GuardState, trail: RoundTrail): void {
+    // A trail left open by a goal that was superseded mid-turn says nothing
+    // about the streak of the goal now being continued.
+    if (state.streakGoalId === undefined) state.streakGoalId = trail.goalId
+    else if (state.streakGoalId !== trail.goalId) return
+    const outcome: RoundOutcome = trail.mutations > 0 ? 'progress'
+      : trail.observations > 0 ? 'observation'
+        : 'noop'
+    state.noopStreak = outcome === 'noop' ? state.noopStreak + 1 : 0
+    state.lastRound = trail.round
+    state.lastTrail = { mutations: trail.mutations, observations: trail.observations, failures: trail.failures }
+  }
+
+  /** Strategy-change notice appended before a goal round with a live streak. */
+  function renderNotice(state: GuardState): UserMessage {
+    const streak = state.noopStreak
+    const last = state.lastTrail
+    return createUserMessage({
+      content: [{
+        type: 'text',
+        text: '<goal_progress>\n'
+          + `Progress check: round ${state.lastRound} closed with no verifiable state delta `
+          + `(mutations: ${last.mutations}, observations: ${last.observations}, failed calls: ${last.failures}). `
+          + `Consecutive no-progress rounds: ${streak}.\n`
+          + 'Do not repeat the previous approach. Before acting again, re-read the latest tool '
+          + 'result or failure, name one concrete reason the state did not change, and choose a '
+          + 'different action or different arguments. If the objective cannot be advanced from '
+          + 'this session, mark the goal blocked with the concrete condition instead of idling.\n'
+          + '</goal_progress>',
+      }],
+      source: {
+        kind: 'goal-progress-guard',
+        form: 'notice',
+        summary: boundContextSummary(`no-progress × ${streak}`),
+      },
+    })
+  }
+
+  ctx.on('agent/disposed', ({ agent }) => { states.delete(agent) })
+
+  ctx.on('session/event', (session: Session, event: SessionEvent) => {
+    const agent = ctx.agents.get(session.id)
+    if (agent === undefined || agent.session !== session) return
+    const state = stateFor(agent)
+    switch (event.type) {
+      case 'user/message': {
+        if (!isGoalRoundSource(event.data.source)) return
+        // A newer admitted round supersedes any untraced open one.
+        state.trail = { goalId: event.data.source.goalId, round: event.data.source.round, mutations: 0, observations: 0, failures: 0 }
+        state.calls.clear()
+        return
+      }
+      case 'tool/call': {
+        if (state.trail === undefined) return
+        state.calls.set(event.data.callId, event.data.name)
+        return
+      }
+      case 'tool/result': {
+        if (state.trail === undefined) return
+        const name = state.calls.get(event.data.message.toolCallId)
+        state.calls.delete(event.data.message.toolCallId)
+        const failed = event.data.error !== undefined || event.data.message.isError === true
+        if (failed) state.trail.failures += 1
+        else if (name !== undefined && isMutation(name)) state.trail.mutations += 1
+        else state.trail.observations += 1
+        return
+      }
+      case 'turn/end': {
+        if (state.trail === undefined) return
+        closeTrail(state, state.trail)
+        state.trail = undefined
+        state.calls.clear()
+        return
+      }
+      default:
+        return
+    }
+  })
+
+  /**
+   * Annotate or stop a goal round at admission. The handler delegates first
+   * so every downstream listener (including the driver's reservation fence)
+   * runs; a rejection here leaves the driver's attempt to its own
+   * stale-attempt convergence, and the blocked goal fails closed on the
+   * driver's next pass because its phase is no longer `active`.
+   */
+  ctx.on('agent/pre-step', async ({ agent, messages }, next): Promise<PreStepDecision> => {
+    const submitted = messages.find((message): message is UserMessage & { source: GoalMessageSource } =>
+      isGoalRoundSource(message.source))
+    const decision = await next()
+    if (submitted === undefined || decision.kind !== 'enter') return decision
+    const goal = ctx.goals.get(agent)
+    if (goal === undefined || goal.id !== submitted.source.goalId) return decision
+    const state = stateFor(agent)
+    if (state.streakGoalId !== goal.id) {
+      // First admitted round of a goal this agent has not trailed yet: the
+      // streak, round number and counters below it belong to an earlier goal
+      // and must not annotate — or with a block threshold, stop — this one.
+      state.streakGoalId = goal.id
+      state.noopStreak = 0
+      state.lastRound = 0
+      state.lastTrail = { mutations: 0, observations: 0, failures: 0 }
+      return decision
+    }
+    if (state.noopStreak < 1) return decision
+    if (resolved.blockAfterNoProgressRounds > 0 && state.noopStreak >= resolved.blockAfterNoProgressRounds) {
+      const message = `Goal round ${state.lastRound} closed ${state.noopStreak} consecutive rounds without a verifiable state delta.`
+      try {
+        ctx.goals.block(agent, { id: goal.id, revision: goal.revision }, { code: 'no-progress', message })
+      } catch (error: unknown) {
+        ctx.logger.warn(`goal-progress-guard: could not block agent "${agent.id}": ${renderThrown(error)}`)
+        return decision
+      }
+      return { kind: 'reject' }
+    }
+    return { ...decision, messages: [...decision.messages, renderNotice(state)] }
+  })
+}
