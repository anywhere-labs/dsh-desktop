diff --git a/packages/goal/goal-completion-gate/src/index.ts b/packages/goal/goal-completion-gate/src/index.ts
new file mode 100644
index 0000000000..47c6b157f3
--- /dev/null
+++ b/packages/goal/goal-completion-gate/src/index.ts
@@ -0,0 +1,241 @@
+/**
+ * Goal completion gate. `tool-goal` lets a model mark a goal complete on its
+ * own word; this plugin adds the missing independent check from outside the
+ * tool: a `complete` call is denied unless the assistant narration that
+ * carries it cites at least one session-verifiable artifact — a file path,
+ * command, or quoted span that appears verbatim in the session's tool-call
+ * arguments or results, or a real tool call id. The denial is corrective
+ * feedback, so the model retries with citations instead of being failed
+ * outright, and a bounded number of denials per agent keeps the retry loop
+ * finite because a denial never ends the turn. The anchor corpus deliberately
+ * excludes the gated tool's own calls and every tool name: otherwise the
+ * gated call's own `name` and arguments, which are logged before the
+ * pre-execute waterfall runs, would be self-verifying evidence. The gate
+ * changes no tool schema and composes with `dsh-tool-goal` unmodified;
+ * deployments opt in through a profile overlay.
+ * @module @deepseek-ai/dsh-goal-completion-gate
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { PreToolDecision } from '@deepseek-ai/dsh-tools'
+
+export const name = 'goal-completion-gate'
+export const inject = ['systemPrompt']
+
+/**
+ * Plugin config, validated by the same-named schemastery schema plus the
+ * load-time checks in `apply` (misconfiguration fails loud: a non-positive
+ * integer or empty tool name throws at plugin load).
+ */
+export interface Config {
+  /** Name of the goal-update tool whose `complete` action is gated (default `'update_goal'`). */
+  goalToolName?: string
+  /** Minimum citations that must verify against the session log (default `1`). */
+  minVerifiedCitations?: number
+  /** How many recent session events are scanned for verifiable anchors (default `400`). */
+  anchorEventWindow?: number
+  /** Minimum character length for a citation candidate (default `6`). */
+  minCitationLength?: number
+  /**
+   * Denials a single agent may receive before the gate stops blocking (default
+   * `2`). A denial never ends the turn, so this bound is what keeps a model
+   * that cannot produce evidence from retrying `update_goal` forever.
+   */
+  maxDenialAttempts?: number
+}
+
+/** Schemastery config for the goal completion gate. */
+export const Config: z<Config> = z.object({
+  goalToolName: z.string().default('update_goal'),
+  minVerifiedCitations: z.number().default(1),
+  anchorEventWindow: z.number().default(400),
+  minCitationLength: z.number().default(6),
+  maxDenialAttempts: z.number().default(2),
+})
+
+/** Fully materialized gate policy. */
+interface ResolvedConfig {
+  readonly goalToolName: string
+  readonly minVerifiedCitations: number
+  readonly anchorEventWindow: number
+  readonly minCitationLength: number
+  readonly maxDenialAttempts: number
+}
+
+/** Character cap on the joined anchor corpus; the tail is the most relevant end. */
+const ANCHOR_CORPUS_MAX_CHARS = 200_000
+
+/** Policy guidance injected into the system prompt while this plugin is loaded. */
+const GUIDANCE =
+  'When you mark a goal complete with update_goal, your visible reply must first cite concrete '
+  + 'evidence from this session verbatim: a file path you wrote or edited, a command whose output '
+  + 'you inspected, or a tool call id. Completion calls without session-verifiable evidence are '
+  + 'rejected; quote the artifact exactly as it appears in the tool call or result.'
+
+/** Corrective feedback returned to the model on a denied completion. */
+const DENIAL =
+  'goal-completion-gate: completion requires verifiable evidence. In the reply that carries the '
+  + 'update_goal call, cite at least one concrete artifact from this session verbatim — a file '
+  + 'path you wrote, a command whose output you read, or a tool call id from an earlier step — '
+  + 'then retry update_goal. Naming the goal tool itself is not evidence. Citations are checked '
+  + 'against the session log; references that do not appear there are rejected.'
+
+/** Text of a denial this gate already issued; never usable as evidence for the next one. */
+const DENIAL_PREFIX = 'Error: goal-completion-gate:'
+
+/** Validate config even when apply is called directly outside Loader normalization. */
+function resolveConfig(config: Config): ResolvedConfig {
+  const resolved: ResolvedConfig = {
+    goalToolName: config.goalToolName ?? 'update_goal',
+    minVerifiedCitations: config.minVerifiedCitations ?? 1,
+    anchorEventWindow: config.anchorEventWindow ?? 400,
+    minCitationLength: config.minCitationLength ?? 6,
+    maxDenialAttempts: config.maxDenialAttempts ?? 2,
+  }
+  if (resolved.goalToolName.length === 0) {
+    throw new TypeError('goal-completion-gate: goalToolName must be non-empty')
+  }
+  for (const [field, value] of [
+    ['minVerifiedCitations', resolved.minVerifiedCitations],
+    ['anchorEventWindow', resolved.anchorEventWindow],
+    ['minCitationLength', resolved.minCitationLength],
+    ['maxDenialAttempts', resolved.maxDenialAttempts],
+  ] as const) {
+    if (!Number.isSafeInteger(value) || value < 1) {
+      throw new TypeError(`goal-completion-gate: ${field} must be a positive safe integer`)
+    }
+  }
+  return resolved
+}
+
+/** Extract text content from one message's content blocks. */
+function textOf(content: readonly { type: string }[]): string {
+  return content
+    .map(block => block.type === 'text' ? (block as { type: 'text'; text: string }).text : '')
+    .join('\n')
+}
+
+/**
+ * Citation candidates of one assistant narration: backtick spans, quoted
+ * spans, and path-like tokens long enough to be specific. A bare token counts
+ * only when it carries a `/` or `.`, so an identifier such as `update_goal`
+ * or `goal_id` cannot become evidence by naming the gated machinery.
+ */
+export function extractCitations(text: string, minLength: number): string[] {
+  const found = new Set<string>()
+  for (const match of text.matchAll(/`([^`\n]+)`|"([^"\n]+)"/g)) {
+    const span = match[1] ?? match[2] ?? ''
+    if (span.length >= minLength) found.add(span)
+  }
+  for (const raw of text.split(/\s+/)) {
+    const token = raw.replace(/^[\s"'([{]+|[\s"')\]}.,;:!?]+$/g, '')
+    if (token.length >= minLength && /[/.]/.test(token) && /[a-zA-Z0-9]/.test(token)) {
+      found.add(token)
+    }
+  }
+  return [...found]
+}
+
+/**
+ * The verifiable anchor corpus of one session: tool call ids plus the verbatim
+ * arguments and result texts of recent tool activity, tail-capped. Excluded by
+ * design — each would otherwise be evidence the completion call manufactured
+ * for itself: the gated tool's own calls and results (its `tool/call` event is
+ * logged before `tools/pre-execute` runs, so its name and arguments are
+ * already in the log), every tool name, the current call's id, and the
+ * corrective text this gate emitted on an earlier denial.
+ */
+export function anchorCorpus(
+  agent: Agent,
+  eventWindow: number,
+  gatedToolName: string,
+  currentCallId: string,
+): { corpus: string; callIds: ReadonlySet<string> } {
+  const events = agent.session.snapshotEvents().slice(-eventWindow)
+  const gated = new Set<string>()
+  for (const event of events) {
+    if (event.type === 'tool/call' && event.data.name === gatedToolName) gated.add(event.data.callId)
+  }
+  const callIds = new Set<string>()
+  const parts: string[] = []
+  for (const event of events) {
+    if (event.type === 'tool/call') {
+      if (gated.has(event.data.callId)) continue
+      callIds.add(event.data.callId)
+      parts.push(event.data.callId, event.data.arguments)
+    }
+    else if (event.type === 'tool/result') {
+      if (gated.has(event.data.message.toolCallId)) continue
+      const text = textOf(event.data.message.content)
+      if (!text.startsWith(DENIAL_PREFIX)) parts.push(text)
+    }
+  }
+  callIds.delete(currentCallId)
+  return { corpus: parts.join('\n').slice(-ANCHOR_CORPUS_MAX_CHARS), callIds }
+}
+
+/** Text of the assistant message that carries the gated call (the latest one logged). */
+function latestNarration(agent: Agent): string {
+  const events = agent.session.snapshotEvents()
+  for (let index = events.length - 1; index >= 0; index -= 1) {
+    const event = events[index]!
+    if (event.type === 'assistant/message' && event.data.interrupted !== true) {
+      return textOf(event.data.message.content)
+    }
+  }
+  return ''
+}
+
+/** Whether the gated call is a goal completion, across the model/tool JSON boundary. */
+function isCompletionCall(args: unknown): boolean {
+  return typeof args === 'object' && args !== null
+    && (args as Record<string, unknown>)['action'] === 'complete'
+}
+
+/**
+ * Register the prompt guidance and the pre-execute gate.
+ * @param ctx - plugin context providing the system-prompt service.
+ * @param config - deployment policy; see {@link Config}.
+ */
+export function apply(ctx: Context, config: Config): void {
+  const resolved = resolveConfig(config)
+  /** Consecutive denied completions per agent; bounds the retry loop. */
+  const denials = new WeakMap<Agent, number>()
+
+  ctx.systemPrompt.section({
+    name: 'tool:goal-completion-gate',
+    // External plugins pick an explicit number: the centrally owned
+    // SECTION_ORDERS map covers shipped plugins only. 2450 follows
+    // TOOL_GOAL (2400).
+    order: 2450,
+    text: GUIDANCE,
+  })
+
+  ctx.on('tools/pre-execute', async (exec, next): Promise<PreToolDecision> => {
+    // A direct `ctx.tools.execute()` caller has no session to check against.
+    if (exec.agent === undefined) return next()
+    if (exec.name !== resolved.goalToolName || !isCompletionCall(exec.arguments)) return next()
+    const narration = latestNarration(exec.agent)
+    const citations = extractCitations(narration, resolved.minCitationLength)
+    const { corpus, callIds } = anchorCorpus(exec.agent, resolved.anchorEventWindow, resolved.goalToolName, exec.callId)
+    const verified = citations.filter(citation => callIds.has(citation) || corpus.includes(citation))
+    if (verified.length >= resolved.minVerifiedCitations) {
+      denials.delete(exec.agent)
+      return next()
+    }
+    // A denial settles as an errored tool result and leaves the turn open, so
+    // only this counter keeps an evidence-less model from re-issuing
+    // `update_goal` indefinitely. Past the cap the completion is admitted and
+    // the missed verification is recorded in the log.
+    const attempts = (denials.get(exec.agent) ?? 0) + 1
+    denials.set(exec.agent, attempts)
+    if (attempts > resolved.maxDenialAttempts) {
+      ctx.logger.warn(`goal-completion-gate: agent "${exec.agent.id}" exceeded ${resolved.maxDenialAttempts} `
+        + 'uncited completions; admitting without evidence')
+      return next()
+    }
+    return { kind: 'deny', reason: DENIAL }
+  })
+}
diff --git a/packages/goal/goal-completion-gate/tests/goal-completion-gate.spec.ts b/packages/goal/goal-completion-gate/tests/goal-completion-gate.spec.ts
new file mode 100644
index 0000000000..2fdcc2ed6a
--- /dev/null
+++ b/packages/goal/goal-completion-gate/tests/goal-completion-gate.spec.ts
@@ -0,0 +1,198 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import GoalService from '@deepseek-ai/dsh-goal'
+import * as ToolGoal from '@deepseek-ai/dsh-tool-goal'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import * as GoalCompletionGate from '@deepseek-ai/dsh-goal-completion-gate'
+import type { Config } from '@deepseek-ai/dsh-goal-completion-gate'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+/**
+ * Behavior suite for the goal completion gate: uncited completions are denied
+ * with corrective feedback, completions citing session-verifiable artifacts
+ * pass, fabricated citations and citations that only name the gated tool
+ * itself are rejected, the denial budget admits a completion rather than
+ * holding the turn open forever, non-complete actions stay transparent, and
+ * misconfiguration fails at load — all through a real agent loop against a
+ * scripted mock adapter (no network).
+ */
+
+/** Boot the core spine + goal domain + goal tools + the gate. */
+async function harness(config: Config = {}): Promise<Context> {
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(GoalService)
+  await ctx.plugin(ToolGoal)
+  await ctx.plugin(GoalCompletionGate, config)
+  return ctx
+}
+
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => { const d = ctx.on('agent/status', ({ agent: s, status: st }) => { if (s === agent && st === 'idle') { d(); resolve() } }) })
+}
+
+/** Send one human prompt and wait for the turn to settle. */
+async function prompt(ctx: Context, agent: Agent, text: string): Promise<void> {
+  const idle = waitForIdle(ctx, agent)
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+  await idle
+}
+
+/** Joined text of every errored tool result in the log, for denial assertions. */
+function toolErrors(agent: Agent): string[] {
+  return agent.session.snapshotEvents()
+    .filter((e): e is SessionEvent<'tool/result'> => e.type === 'tool/result' && e.data.message.isError === true)
+    .map(e => e.data.message.content.map(block => block.type === 'text' ? block.text : '').join('\n'))
+}
+
+describe('completion gating', () => {
+  it('denies a completion whose narration cites nothing verifiable', async () => {
+    const ctx = await harness()
+    let goalId = ''
+    const adapter = new MockAdapter([
+      () => toolCallResponse('c1', 'update_goal', { goal_id: goalId, revision: 1, action: 'complete' },
+        'All done, everything works.'),
+      textResponse('understood, gathering evidence first'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    goalId = ctx.goals.create(agent, { objective: 'finish the feature' }).id
+
+    await prompt(ctx, agent, 'finish it')
+    expect(ctx.goals.get(agent)).toMatchObject({ phase: 'active' })
+    const errors = toolErrors(agent)
+    expect(errors).toHaveLength(1)
+    expect(errors[0]).toContain('goal-completion-gate')
+    expect(errors[0]).toContain('cite at least one concrete artifact')
+  })
+
+  it('admits a completion that cites a session-verifiable artifact', async () => {
+    const ctx = await harness()
+    ctx.tools.register(defineContentToolFixture({
+      name: 'write',
+      description: 'w',
+      parameters: {},
+      async execute() { return [{ type: 'text', text: 'written' }] },
+    }))
+    let goalId = ''
+    const adapter = new MockAdapter([
+      toolCallResponse('w1', 'write', { path: 'src/out.ts', content: 'export {}' }),
+      () => toolCallResponse('c2', 'update_goal', { goal_id: goalId, revision: 1, action: 'complete' },
+        'Wrote `src/out.ts` and verified the result.'),
+      textResponse('closing'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    goalId = ctx.goals.create(agent, { objective: 'finish the feature' }).id
+
+    await prompt(ctx, agent, 'finish it')
+    expect(ctx.goals.get(agent)).toMatchObject({ phase: 'complete' })
+    expect(toolErrors(agent)).toHaveLength(0)
+  })
+
+  it('denies a completion whose citation does not appear in the session log', async () => {
+    const ctx = await harness()
+    let goalId = ''
+    const adapter = new MockAdapter([
+      () => toolCallResponse('c1', 'update_goal', { goal_id: goalId, revision: 1, action: 'complete' },
+        'Checked `src/never-built.ts` — all green.'),
+      textResponse('ack'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    goalId = ctx.goals.create(agent, { objective: 'finish the feature' }).id
+
+    await prompt(ctx, agent, 'finish it')
+    expect(ctx.goals.get(agent)).toMatchObject({ phase: 'active' })
+    expect(toolErrors(agent)[0]).toContain('goal-completion-gate')
+  })
+
+  it('denies a completion that cites only the gated tool itself', async () => {
+    const ctx = await harness()
+    let goalId = ''
+    const adapter = new MockAdapter([
+      () => toolCallResponse('c1', 'update_goal', { goal_id: goalId, revision: 1, action: 'complete' },
+        'Called `update_goal` with `goal_id` and `revision` set, so the objective is done.'),
+      textResponse('ack'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    goalId = ctx.goals.create(agent, { objective: 'finish the feature' }).id
+
+    await prompt(ctx, agent, 'finish it')
+    expect(ctx.goals.get(agent)).toMatchObject({ phase: 'active' })
+    expect(toolErrors(agent)).toHaveLength(1)
+  })
+
+  it('stops denying once the agent exceeds the denial budget', async () => {
+    const ctx = await harness({ maxDenialAttempts: 2 })
+    let goalId = ''
+    const uncited = () => toolCallResponse('c1', 'update_goal',
+      { goal_id: goalId, revision: 1, action: 'complete' }, 'Trust me, it works now.')
+    const adapter = new MockAdapter([uncited, uncited, uncited, textResponse('ack')])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    goalId = ctx.goals.create(agent, { objective: 'finish the feature' }).id
+
+    await prompt(ctx, agent, 'finish it')
+    expect(toolErrors(agent)).toHaveLength(2)
+    expect(ctx.goals.get(agent)).toMatchObject({ phase: 'complete' })
+  })
+
+  it('leaves non-complete actions transparent to the gate', async () => {
+    const ctx = await harness()
+    let goalId = ''
+    const adapter = new MockAdapter([
+      () => toolCallResponse('c1', 'update_goal', {
+        goal_id: goalId, revision: 1, action: 'blocked', blocked_reason: 'Waiting on API credentials.',
+      }, 'Blocked on credentials.'),
+      textResponse('ack'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
+    goalId = ctx.goals.create(agent, { objective: 'finish the feature' }).id
+
+    await prompt(ctx, agent, 'finish it')
+    expect(ctx.goals.get(agent)).toMatchObject({ phase: 'blocked' })
+    expect(toolErrors(agent)).toHaveLength(0)
+  })
+})
+
+describe('config validation', () => {
+  it('fails loud on a non-positive citation minimum', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(GoalService)
+    await ctx.plugin(ToolGoal)
+    await expect(ctx.plugin(GoalCompletionGate, { minVerifiedCitations: 0 }))
+      .rejects.toThrow('minVerifiedCitations')
+  })
+
+  it('fails loud on a zero denial budget', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(GoalService)
+    await ctx.plugin(ToolGoal)
+    await expect(ctx.plugin(GoalCompletionGate, { maxDenialAttempts: 0 }))
+      .rejects.toThrow('maxDenialAttempts')
+  })
+
+  it('fails loud on an empty gated tool name', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(GoalService)
+    await ctx.plugin(ToolGoal)
+    await expect(ctx.plugin(GoalCompletionGate, { goalToolName: '' }))
+      .rejects.toThrow('goalToolName')
+  })
+})
