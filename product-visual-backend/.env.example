APP_HOST=0.0.0.0
APP_PORT=3028
FRONTEND_PORT=5178
DATABASE_URL=sqlite:///./storage/app.db
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
LOCAL_FFMPEG_PATH=runtime/ffmpeg/bin/ffmpeg.exe
LOCAL_FFPROBE_PATH=runtime/ffmpeg/bin/ffprobe.exe

# Internal planning controls. Defaults remain baseline/off. Verified render
# additionally requires P2=passed, this activation flag, an allowlisted task,
# and an accepted-plan manifest entry; any failure falls back to baseline.
LIVECLIP_VERIFIED_PLANNING_SIDECAR=false
LIVECLIP_PLANNING_POLICY=baseline
LIVECLIP_VERIFIED_PLANNING_ACCEPTANCE_STATUS=not_run
LIVECLIP_VERIFIED_RENDER_ENABLED=false
LIVECLIP_VERIFIED_RENDER_CANARY_TASK_IDS=
LIVECLIP_VERIFIED_PLANNING_ACCEPTANCE_MANIFEST=storage/reports/liveclip_p2_accepted_planning_manifest.json

# P4 is an additional internal canary gate. It never activates unless the P3
# verified plan is already selected for the same allowlisted task. Contract or
# render failures retain the baseline fallback path.
LIVECLIP_P4_TIMELINE_PACKAGING_ENABLED=false
LIVECLIP_P4_TIMELINE_PACKAGING_CANARY_TASK_IDS=

# Unified model provider used by product visual now and by later model calls
# in brand strategy, data capture, live clips, and analysis reports.
# apimart: APIMart async gpt-image-2 image generation.
# openai: OpenAI-compatible sync image generation.
# auto: use configured provider when OPENAI_API_KEY exists, otherwise local SVG fallback.
# mock: force local SVG fallback.
PRODUCT_VISUAL_IMAGE_PROVIDER=apimart
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.apimart.ai/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1:1
OPENAI_IMAGE_RESOLUTION=2k
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=png
